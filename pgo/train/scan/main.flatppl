%%%
# Diffusion constant from an irregularly sampled random walk

Brownian motion observed at five irregular time steps: step k is
`Normal(x_{k-1}, sqrt(2 D dt_k))` with the step sizes `dts` exogenous
data, which is exactly §06's `kscan` — `markovchain` with per-step
inputs threaded through the kernel. Only the diffusion constant `D` is
inferred. The chain density is the product of the step conditionals,
so the oracle is closed form.
%%%
flatppl_compat = "0.1"

dts = [0.01, 0.02, 0.015, 0.018, 0.012]
traj_obs = [0.1, -0.05, 0.2, 0.15, 0.3]

D = elementof(posreals)
f_step = (x, dt, D) -> Normal(x, sqrt(2.0 * D * dt))
traj ~ kscan(f_step, 0.0, dts, D)

prior = joint(D = Gamma(shape = 2.0, rate = 0.5))
forward_kernel = kernelof(record(traj = traj), D = D)
L = likelihoodof(forward_kernel, record(traj = traj_obs))
posterior = bayesupdate(L, prior)

% Mode ABI: one query, both engines. `D` is already the model's free parameter, so it is the ABI input directly.
lp = logdensityof(posterior, record(D = D))
inputs = (D)
outputs = (lp)
