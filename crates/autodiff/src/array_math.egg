; A valid window is bilinear in its signal and kernel.
(constructor WindowTranspose (i64) Expr)
(rewrite (Pullback "conv" 2 slot) (WindowTranspose slot) :ruleset pullbacks)
(rewrite (Pullback "crosscorr" 2 slot) (WindowTranspose slot) :ruleset pullbacks)
(rewrite (Pushforward "conv" 2 slot) (ForwardCall "conv" slot) :ruleset pullbacks)
(rewrite (Pushforward "crosscorr" 2 slot) (ForwardCall "crosscorr" slot) :ruleset pullbacks)

(constructor OrderPartial (i64) Expr)
(rewrite (Pullback "quantile" 2 slot) (MapBinary "mul" (Bar) (OrderPartial slot)) :ruleset pullbacks)
(rewrite (Pushforward "quantile" 2 0) (MathDot (Bar) (OrderPartial 0)) :ruleset pullbacks)
(rewrite (Pushforward "quantile" 2 1) (Binary "mul" (Bar) (OrderPartial 1)) :ruleset pullbacks)
(rewrite (Pullback "median" 1 0) (MapBinary "mul" (Bar) (OrderPartial 0)) :ruleset pullbacks)
(rewrite (Pushforward "median" 1 0) (MathDot (Bar) (OrderPartial 0)) :ruleset pullbacks)

(constructor GridWeight (i64) Expr)
(rewrite (Pullback "linspace" 3 slot) (MathDot (Bar) (GridWeight slot)) :ruleset pullbacks)
(rewrite (Pushforward "linspace" 3 slot) (MapBinary "mul" (Bar) (GridWeight slot)) :ruleset pullbacks)
(rewrite (Pullback "extlinspace" 3 slot) (MathDot (Bar) (GridWeight slot)) :ruleset pullbacks)
(rewrite (Pushforward "extlinspace" 3 slot) (MapBinary "mul" (Bar) (GridWeight slot)) :ruleset pullbacks)

(constructor BernsteinWeights () Expr)
(constructor BernsteinSlope () Expr)
(rewrite (Pullback "bernstein" 2 0) (MapBinary "mul" (Bar) (BernsteinWeights)) :ruleset pullbacks)
(rewrite (Pushforward "bernstein" 2 0) (ForwardCall "bernstein" 0) :ruleset pullbacks)
(rewrite (Pullback "bernstein" 2 1) (Binary "mul" (Bar) (BernsteinSlope)) :ruleset pullbacks)
(rewrite (Pushforward "bernstein" 2 1) (Binary "mul" (Bar) (BernsteinSlope)) :ruleset pullbacks)

; Off a bin boundary, only the selected value contributes.
(constructor StepMask () Expr)
(rewrite (Pullback "stepwise" 3 0) (Fill (Real 0.0) 0) :ruleset pullbacks)
(rewrite (Pullback "stepwise" 3 1) (MapBinary "mul" (Bar) (StepMask)) :ruleset pullbacks)
(rewrite (Pullback "stepwise" 3 2) (Real 0.0) :ruleset pullbacks)
(rewrite (Pushforward "stepwise" 3 0) (Real 0.0) :ruleset pullbacks)
(rewrite (Pushforward "stepwise" 3 1) (ForwardCall "stepwise" 1) :ruleset pullbacks)
(rewrite (Pushforward "stepwise" 3 2) (Real 0.0) :ruleset pullbacks)

(rewrite (Pullback "adjoint" 1 0) (Unary "adjoint" (Bar)) :ruleset pullbacks)
(rewrite (Pushforward "adjoint" 1 0) (Unary "adjoint" (Bar)) :ruleset pullbacks)
(rewrite (Pullback "cross" 2 0) (Binary "cross" (Arg 1) (Bar)) :ruleset pullbacks)
(rewrite (Pullback "cross" 2 1) (Binary "cross" (Bar) (Arg 0)) :ruleset pullbacks)
(rewrite (Pushforward "cross" 2 slot) (ForwardCall "cross" slot) :ruleset pullbacks)

; The input is a real vector or matrix. Transpose the linear map with
; respect to the Euclidean / Frobenius pairing.
(constructor AddTranspose (Expr) Expr :unextractable)
(rewrite (AddTranspose x) (Binary "add" x (Unary "transpose" x)) :ruleset pullbacks)
(rewrite (Pullback "row_gram" 1 0) (Binary "mul" (AddTranspose (Bar)) (Arg 0)) :ruleset pullbacks)
(rewrite (Pushforward "row_gram" 1 0) (AddTranspose (Binary "mul" (Bar) (Unary "transpose" (Arg 0)))) :ruleset pullbacks)
(rewrite (Pullback "col_gram" 1 0) (Binary "mul" (Arg 0) (AddTranspose (Bar))) :ruleset pullbacks)
(rewrite (Pushforward "col_gram" 1 0) (AddTranspose (Binary "mul" (Unary "transpose" (Arg 0)) (Bar))) :ruleset pullbacks)
(rewrite (Pullback "self_outer" 1 0) (Binary "mul" (AddTranspose (Bar)) (Arg 0)) :ruleset pullbacks)
(rewrite (Pushforward "self_outer" 1 0) (AddTranspose (Binary "mul" (Bar) (Unary "transpose" (Arg 0)))) :ruleset pullbacks)
(rewrite (Pullback "quadform" 2 0) (MapBinary "mul" (Bar) (Unary "self_outer" (Arg 1))) :ruleset pullbacks)
(rewrite (Pullback "quadform" 2 1)
  (MapBinary "mul" (Bar) (Binary "mul" (AddTranspose (Arg 0)) (Arg 1))) :ruleset pullbacks)
(rewrite (Pushforward "quadform" 2 0) (Binary "quadform" (Bar) (Arg 1)) :ruleset pullbacks)
(rewrite (Pushforward "quadform" 2 1)
  (MathDot (Bar) (Binary "mul" (AddTranspose (Arg 0)) (Arg 1))) :ruleset pullbacks)

(rewrite (Pullback "softmax" 1 0)
  (MapBinary "mul" (Out) (MapBinary "sub" (Bar) (MathDot (Bar) (Out)))) :ruleset pullbacks)
(rewrite (Pushforward "softmax" 1 0) (Pullback "softmax" 1 0) :ruleset pullbacks)
(rewrite (Pullback "logsoftmax" 1 0)
  (MapBinary "sub" (Bar) (MapBinary "mul" (MapUnary "exp" (Out)) (Unary "sum" (Bar)))) :ruleset pullbacks)
(rewrite (Pushforward "logsoftmax" 1 0)
  (MapBinary "sub" (Bar) (MathDot (Bar) (MapUnary "exp" (Out)))) :ruleset pullbacks)
(rewrite (Pullback "l2unit" 1 0)
  (MapBinary "divide" (MapBinary "sub" (Bar) (MapBinary "mul" (Out) (MathDot (Out) (Bar))))
    (Unary "l2norm" (Arg 0))) :ruleset pullbacks)
(rewrite (Pushforward "l2unit" 1 0) (Pullback "l2unit" 1 0) :ruleset pullbacks)
(rewrite (Pullback "l1unit" 1 0)
  (MapBinary "divide" (MapBinary "sub" (Bar) (MapBinary "mul" (CellSign) (MathDot (Out) (Bar))))
    (Unary "l1norm" (Arg 0))) :ruleset pullbacks)
(rewrite (Pushforward "l1unit" 1 0)
  (MapBinary "divide" (MapBinary "sub" (Bar) (MapBinary "mul" (Out) (MathDot (CellSign) (Bar))))
    (Unary "l1norm" (Arg 0))) :ruleset pullbacks)
