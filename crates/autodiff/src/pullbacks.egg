; Slot numbers are local to the primal op. Each rule emits one contribution.
(datatype Expr
  (Arg i64)
  (Out)
  (Bar)
  (ZeroOut)
  (Fill Expr i64)
  (MeanFill Expr i64)
  (LogSumExp i64)
  (Pick Expr i64)
  (StackPick i64 i64)
  (StackInsert i64 i64)
  (Unstack i64)
  (DropAxes Expr)
  (Scatter Expr i64)
  (ForwardCall String i64)
  (Insert i64)
  (Int i64)
  (Real f64)
  (MathDot Expr Expr)
  (IndexedProduct i64 i64)
  (PolynomialSlope)
  (PolynomialBasis)
  (IdentityLike i64)
  (DetCofactors)
  (TriangleHalf Expr)
  (Symmetric Expr)
  (Unary String Expr)
  (SpecialUnary String Expr)
  (SpecialBinary String Expr Expr)
  (MapUnary String Expr)
  (MapBinary String Expr Expr)
  (MapTernary String Expr Expr Expr)
  (MapSpecialUnary String Expr)
  (Binary String Expr Expr)
  (Ternary String Expr Expr Expr))
(constructor Pullback (String i64 i64) Expr :unextractable)
(constructor Pushforward (String i64 i64) Expr :unextractable)
; Give each request its own fallback so unrelated pullbacks never merge.
(constructor Missing (String String i64 i64) Expr :cost 1000)
(ruleset pullbacks)
(rewrite (Pullback op arity slot) (Missing "reverse" op arity slot) :ruleset pullbacks)
(rewrite (Pushforward op arity slot) (Missing "forward" op arity slot) :ruleset pullbacks)

(rewrite (Pullback "identity" 1 0) (Bar) :ruleset pullbacks)
(rewrite (Pullback "real" 1 0) (Bar) :ruleset pullbacks)
(rewrite (Pullback "add" 2 0) (Bar) :ruleset pullbacks)
(rewrite (Pullback "add" 2 1) (Bar) :ruleset pullbacks)
(rewrite (Pullback "sub" 2 0) (Bar) :ruleset pullbacks)
(rewrite (Pullback "sub" 2 1) (Unary "neg" (Bar)) :ruleset pullbacks)
(rewrite (Pullback "neg" 1 0) (Unary "neg" (Bar)) :ruleset pullbacks)
(rewrite (Pullback "ifelse" 3 1) (Ternary "ifelse" (Arg 0) (Bar) (Real 0.0)) :ruleset pullbacks)
(rewrite (Pullback "ifelse" 3 2) (Ternary "ifelse" (Arg 0) (Real 0.0) (Bar)) :ruleset pullbacks)
(rewrite (Pullback "mul" 2 0) (Binary "mul" (Bar) (Arg 1)) :ruleset pullbacks)
(rewrite (Pullback "mul" 2 1) (Binary "mul" (Bar) (Arg 0)) :ruleset pullbacks)
(rewrite (Pullback "divide" 2 0) (Binary "divide" (Bar) (Arg 1)) :ruleset pullbacks)
(rewrite (Pullback "divide" 2 1)
  (Unary "neg" (Binary "mul" (Binary "divide" (Bar) (Arg 1)) (Out)))
  :ruleset pullbacks)

(rewrite (Pullback "exp" 1 0) (Binary "mul" (Bar) (Out)) :ruleset pullbacks)
(rewrite (Pullback "expm1" 1 0) (Binary "mul" (Bar) (Unary "exp" (Arg 0))) :ruleset pullbacks)
(rewrite (Pullback "log" 1 0) (Binary "divide" (Bar) (Arg 0)) :ruleset pullbacks)
(rewrite (Pullback "log1p" 1 0) (Binary "divide" (Bar) (Binary "add" (Real 1.0) (Arg 0))) :ruleset pullbacks)
(rewrite (Pullback "sqrt" 1 0) (Binary "mul" (Real 0.5) (Binary "divide" (Bar) (Out))) :ruleset pullbacks)
(rewrite (Pullback "abs2" 1 0) (Binary "mul" (Real 2.0) (Binary "mul" (Bar) (Arg 0))) :ruleset pullbacks)
(rewrite (Pullback "sin" 1 0) (Binary "mul" (Bar) (Unary "cos" (Arg 0))) :ruleset pullbacks)
(rewrite (Pullback "cos" 1 0) (Unary "neg" (Binary "mul" (Bar) (Unary "sin" (Arg 0)))) :ruleset pullbacks)
(rewrite (Pullback "invlogit" 1 0)
  (Binary "mul" (Bar) (Binary "mul" (Out) (Unary "invlogit" (Unary "neg" (Arg 0)))))
  :ruleset pullbacks)

; The term 2/sqrt(pi) is the common positive slope factor of erf and -erfc.
(constructor ErfSlope () Expr :unextractable)
(rewrite (ErfSlope) (Binary "mul" (Real 1.1283791670955126)
  (Unary "exp" (Unary "neg" (Unary "abs2" (Arg 0))))) :ruleset pullbacks)
(rewrite (Pullback "erf" 1 0) (Binary "mul" (Bar) (ErfSlope)) :ruleset pullbacks)
(rewrite (Pullback "erfc" 1 0) (Unary "neg" (Binary "mul" (Bar) (ErfSlope))) :ruleset pullbacks)

; Expand exp(-t²) in erfcx'(x) = -4/sqrt(pi) * integral(t exp(-2xt-t²), t=0..inf).
; Integrating the Taylor remainder bounds the scaled series error by the first
; omitted term, (2027025 / 128) / x^14, below 2.2e-13 at x >= 16.
(constructor ErfcxTail () Expr :unextractable)
(rewrite (ErfcxTail) (Binary "ge" (Arg 0) (Real 16.0)) :ruleset pullbacks)
(constructor ErfcxTailInverse () Expr :unextractable)
(rewrite (ErfcxTailInverse)
  (Binary "divide" (Real 1.0) (Ternary "ifelse" (ErfcxTail) (Arg 0) (Real 16.0)))
  :ruleset pullbacks)
(constructor ErfcxTailSeries (Expr) Expr :unextractable)
(rewrite (ErfcxTailSeries z)
  (Binary "add" (Real 1.0) (Binary "mul" z
    (Binary "add" (Real -1.5) (Binary "mul" z
      (Binary "add" (Real 3.75) (Binary "mul" z
        (Binary "add" (Real -13.125) (Binary "mul" z
          (Binary "add" (Real 59.0625) (Binary "mul" z
            (Binary "add" (Real -324.84375) (Binary "mul" z (Real 2111.484375)))))))))))))
  :ruleset pullbacks)
(rewrite (Pullback "erfcx" 1 0)
  (Ternary "ifelse" (ErfcxTail)
    (Binary "mul" (Binary "mul" (Bar) (ErfcxTailInverse))
      (Binary "mul" (Binary "mul" (Real -0.5641895835477563) (ErfcxTailInverse))
        (ErfcxTailSeries (Unary "abs2" (ErfcxTailInverse)))))
    (Binary "mul" (Bar) (Binary "sub"
      (Binary "mul" (Real 2.0) (Binary "mul" (Arg 0) (Out)))
      (Real 1.1283791670955126)))) :ruleset pullbacks)
(rewrite (Pullback "digamma" 1 0)
  (Binary "mul" (Bar) (SpecialBinary "polygamma" (Int 1) (Arg 0))) :ruleset pullbacks)
(rewrite (Pullback "polygamma" 2 1)
  (Binary "mul" (Bar) (SpecialBinary "polygamma" (Binary "add" (Arg 0) (Int 1)) (Arg 1)))
  :ruleset pullbacks)

; Normal log density argument order is (mu, sigma, observation).
; R is an internal template term for the standardized residual.
(constructor R () Expr :unextractable)
(rewrite (R) (Binary "divide" (Binary "sub" (Arg 2) (Arg 0)) (Arg 1)) :ruleset pullbacks)
(rewrite (Pullback "Normal log density" 3 0)
  (Binary "mul" (Binary "divide" (Bar) (Arg 1)) (R)) :ruleset pullbacks)
(rewrite (Pullback "Normal log density" 3 1)
  (Binary "mul" (Binary "divide" (Bar) (Arg 1)) (Binary "sub" (Binary "mul" (R) (R)) (Real 1.0)))
  :ruleset pullbacks)
(rewrite (Pullback "Normal log density" 3 2)
  (Unary "neg" (Binary "mul" (Binary "divide" (Bar) (Arg 1)) (R))) :ruleset pullbacks)

; Structural pullbacks preserve or change whole array shapes.
(rewrite (Pullback "sum" 1 0) (Fill (Bar) 0) :ruleset pullbacks)
(rewrite (Pullback "mean" 1 0) (MeanFill (Bar) 0) :ruleset pullbacks)
(rewrite (Pullback "vector" arity slot)
  (Pick (Bar) (+ slot 1)) :ruleset pullbacks)
(rewrite (Pullback "stack rows" arity slot) (StackPick (+ slot 1) 0) :ruleset pullbacks)
(rewrite (Pullback "stack columns" arity slot) (StackPick (+ slot 1) 1) :ruleset pullbacks)
(rewrite (Pullback "rowstack" 1 0) (Unstack 0) :ruleset pullbacks)
(rewrite (Pullback "colstack" 1 0) (Unstack 1) :ruleset pullbacks)
(rewrite (Pullback "addaxes" 3 0) (DropAxes (Bar)) :ruleset pullbacks)
(rewrite (Pullback "get" arity 0) (Scatter (Bar) 1) :ruleset pullbacks)
(rewrite (Pullback "get0" arity 0) (Scatter (Bar) 0) :ruleset pullbacks)
(rewrite (Pullback "matrix product" 2 0)
  (Binary "mul" (Bar) (Unary "transpose" (Arg 1))) :ruleset pullbacks)
(rewrite (Pullback "matrix product" 2 1)
  (Binary "mul" (Unary "transpose" (Arg 0)) (Bar)) :ruleset pullbacks)
(rewrite (Pullback "transpose" 1 0) (Unary "transpose" (Bar)) :ruleset pullbacks)

; Scalar cell pullbacks also give partial products for the forward pass.
; Shape-changing operations have their own forward rules.
(rewrite (Pushforward "sum" 1 0) (ForwardCall "sum" 0) :ruleset pullbacks)
(rewrite (Pushforward "mean" 1 0) (ForwardCall "mean" 0) :ruleset pullbacks)
(rewrite (Pushforward "vector" arity slot) (Insert (+ slot 1)) :ruleset pullbacks)
(rewrite (Pushforward "stack rows" arity slot) (StackInsert slot 0) :ruleset pullbacks)
(rewrite (Pushforward "stack columns" arity slot) (StackInsert slot 1) :ruleset pullbacks)
(rewrite (Pushforward "rowstack" 1 0) (ForwardCall "rowstack" 0) :ruleset pullbacks)
(rewrite (Pushforward "colstack" 1 0) (ForwardCall "colstack" 0) :ruleset pullbacks)
(rewrite (Pushforward "addaxes" 3 0) (ForwardCall "addaxes" 0) :ruleset pullbacks)
(rewrite (Pushforward "get" arity 0) (ForwardCall "get" 0) :ruleset pullbacks)
(rewrite (Pushforward "get0" arity 0) (ForwardCall "get0" 0) :ruleset pullbacks)
(rewrite (Pushforward "matrix product" 2 slot) (ForwardCall "mul" slot) :ruleset pullbacks)
(rewrite (Pushforward "transpose" 1 0) (ForwardCall "transpose" 0) :ruleset pullbacks)

; Cauchy uses the same standardized residual as Normal.
(constructor CauchyInverse () Expr :unextractable)
(rewrite (CauchyInverse) (Binary "divide" (Real 1.0)
  (Binary "add" (Real 1.0) (Binary "mul" (R) (R)))) :ruleset pullbacks)
(constructor CauchyLocation () Expr :unextractable)
(rewrite (CauchyLocation) (Binary "mul" (Binary "divide" (Bar) (Arg 1))
  (Binary "mul" (Real 2.0) (Binary "mul" (R) (CauchyInverse)))) :ruleset pullbacks)
(rewrite (Pullback "Cauchy log density" 3 0) (CauchyLocation) :ruleset pullbacks)
(rewrite (Pullback "Cauchy log density" 3 1)
  (Binary "mul" (Binary "divide" (Bar) (Arg 1))
    (Binary "sub" (Real 1.0) (Binary "mul" (Real 2.0) (CauchyInverse))))
  :ruleset pullbacks)
(rewrite (Pullback "Cauchy log density" 3 2) (Unary "neg" (CauchyLocation)) :ruleset pullbacks)

(constructor LR () Expr :unextractable)
(rewrite (LR) (Binary "divide"
  (Binary "sub" (Unary "log" (Arg 2)) (Arg 0)) (Arg 1)) :ruleset pullbacks)
(rewrite (Pullback "LogNormal log density" 3 0)
  (Binary "mul" (Binary "divide" (Bar) (Arg 1)) (LR)) :ruleset pullbacks)
(rewrite (Pullback "LogNormal log density" 3 1)
  (Binary "mul" (Binary "divide" (Bar) (Arg 1))
    (Binary "sub" (Binary "mul" (LR) (LR)) (Real 1.0))) :ruleset pullbacks)
(rewrite (Pullback "LogNormal log density" 3 2)
  (Unary "neg" (Binary "mul" (Binary "divide" (Bar) (Arg 2))
    (Binary "add" (Real 1.0) (Binary "divide" (LR) (Arg 1))))) :ruleset pullbacks)

(rewrite (Pullback "Exponential log density" 2 0)
  (Binary "mul" (Bar) (Binary "sub" (Binary "divide" (Real 1.0) (Arg 0)) (Arg 1))) :ruleset pullbacks)
(rewrite (Pullback "Exponential log density" 2 1)
  (Unary "neg" (Binary "mul" (Bar) (Arg 0))) :ruleset pullbacks)
(rewrite (Pullback "Gamma log density" 3 0)
  (Binary "mul" (Bar) (Binary "sub"
    (Binary "add" (Unary "log" (Arg 1)) (Unary "log" (Arg 2)))
    (SpecialUnary "digamma" (Arg 0)))) :ruleset pullbacks)
(rewrite (Pullback "Gamma log density" 3 1)
  (Binary "mul" (Bar) (Binary "sub" (Binary "divide" (Arg 0) (Arg 1)) (Arg 2))) :ruleset pullbacks)
(rewrite (Pullback "Gamma log density" 3 2)
  (Binary "mul" (Bar) (Binary "sub"
    (Binary "divide" (Binary "sub" (Arg 0) (Real 1.0)) (Arg 2)) (Arg 1))) :ruleset pullbacks)
(rewrite (Pullback "InverseGamma log density" 3 0)
  (Binary "mul" (Bar) (Binary "sub"
    (Binary "sub" (Unary "log" (Arg 1)) (Unary "log" (Arg 2)))
    (SpecialUnary "digamma" (Arg 0)))) :ruleset pullbacks)
(rewrite (Pullback "InverseGamma log density" 3 1)
  (Binary "mul" (Bar) (Binary "sub" (Binary "divide" (Arg 0) (Arg 1))
    (Binary "divide" (Real 1.0) (Arg 2)))) :ruleset pullbacks)
(rewrite (Pullback "InverseGamma log density" 3 2)
  (Binary "mul" (Binary "divide" (Bar) (Arg 2))
    (Binary "sub" (Binary "divide" (Arg 1) (Arg 2))
      (Binary "add" (Arg 0) (Real 1.0)))) :ruleset pullbacks)

; For large positive x, avoid subtracting two O(log(x)) digamma values.
; The first six Bernoulli terms approximate log(x) - digamma(x) at x >= 16.
(constructor DigammaCorrection (Expr Expr) Expr :unextractable)
(rewrite (DigammaCorrection inverse squared)
  (Binary "add" (Binary "mul" (Real 0.5) inverse)
    (Binary "mul" squared
      (Binary "add" (Real 0.08333333333333333) (Binary "mul" squared
        (Binary "add" (Real -0.008333333333333333) (Binary "mul" squared
          (Binary "add" (Real 0.003968253968253968) (Binary "mul" squared
            (Binary "add" (Real -0.004166666666666667) (Binary "mul" squared
              (Binary "add" (Real 0.007575757575757576)
                (Binary "mul" squared (Real -0.021092796092796094)))))))))))))
  :ruleset pullbacks)
(constructor DigammaDifference (Expr Expr) Expr :unextractable)
(rewrite (DigammaDifference x y)
  (Ternary "ifelse" (Binary "ge" x (Real 16.0))
    (Binary "add" (Unary "log1p" (Binary "divide" y x))
      (Binary "sub"
        (DigammaCorrection (Binary "divide" (Real 1.0) x)
          (Unary "abs2" (Binary "divide" (Real 1.0) x)))
        (DigammaCorrection (Binary "divide" (Real 1.0) (Binary "add" x y))
          (Unary "abs2" (Binary "divide" (Real 1.0) (Binary "add" x y))))))
    (Binary "sub" (SpecialUnary "digamma" (Binary "add" x y)) (SpecialUnary "digamma" x)))
  :ruleset pullbacks)
(rewrite (Pullback "Beta log density" 3 0)
  (Binary "mul" (Bar) (Binary "add" (Unary "log" (Arg 2))
    (DigammaDifference (Arg 0) (Arg 1)))) :ruleset pullbacks)
(rewrite (Pullback "Beta log density" 3 1)
  (Binary "mul" (Bar) (Binary "add" (Unary "log1p" (Unary "neg" (Arg 2)))
    (DigammaDifference (Arg 1) (Arg 0)))) :ruleset pullbacks)
(rewrite (Pullback "Beta log density" 3 2)
  (Binary "mul" (Bar) (Binary "sub"
    (Binary "divide" (Binary "sub" (Arg 0) (Real 1.0)) (Arg 2))
    (Binary "divide" (Binary "sub" (Arg 1) (Real 1.0))
      (Binary "sub" (Real 1.0) (Arg 2))))) :ruleset pullbacks)

; StudentT's observation is standardized by the primal locscale lowering, if any.
(constructor StudentTNuPlusOne () Expr :unextractable)
(constructor StudentTObsSquare () Expr :unextractable)
(constructor StudentTScale () Expr :unextractable)
(rewrite (StudentTNuPlusOne) (Binary "add" (Arg 0) (Real 1.0)) :ruleset pullbacks)
(rewrite (StudentTObsSquare) (Unary "abs2" (Arg 1)) :ruleset pullbacks)
(rewrite (StudentTScale) (Binary "add" (Arg 0) (StudentTObsSquare)) :ruleset pullbacks)
(rewrite (Pullback "StudentT log density" 2 0)
  (Binary "mul" (Binary "mul" (Bar) (Real 0.5))
    (Binary "sub"
      (Binary "add"
        (Binary "sub"
          (SpecialUnary "digamma" (Binary "mul" (Real 0.5) (StudentTNuPlusOne)))
          (SpecialUnary "digamma" (Binary "mul" (Real 0.5) (Arg 0))))
        (Binary "divide"
          (Binary "sub" (StudentTObsSquare) (Real 1.0)) (StudentTScale)))
      (Unary "log1p" (Binary "divide" (StudentTObsSquare) (Arg 0)))))
  :ruleset pullbacks)
(rewrite (Pullback "StudentT log density" 2 1)
  (Unary "neg" (Binary "mul" (Bar)
    (Binary "mul" (Binary "divide" (StudentTNuPlusOne) (StudentTScale)) (Arg 1))))
  :ruleset pullbacks)

(constructor LogisticSlope () Expr :unextractable)
(rewrite (LogisticSlope) (Unary "tanh" (Binary "mul" (Real 0.5) (R)))
  :ruleset pullbacks)
(rewrite (Pullback "Logistic log density" 3 0)
  (Binary "mul" (Binary "divide" (Bar) (Arg 1)) (LogisticSlope)) :ruleset pullbacks)
(rewrite (Pullback "Logistic log density" 3 1)
  (Binary "mul" (Binary "divide" (Bar) (Arg 1))
    (Binary "sub" (Binary "mul" (R) (LogisticSlope)) (Real 1.0))) :ruleset pullbacks)
(rewrite (Pullback "Logistic log density" 3 2)
  (Unary "neg" (Binary "mul" (Binary "divide" (Bar) (Arg 1)) (LogisticSlope)))
  :ruleset pullbacks)

; At the mode, use the right derivative of the absolute residual, as JAX does.
(constructor LaplaceSlope () Expr :unextractable)
(rewrite (LaplaceSlope)
  (Ternary "ifelse" (Binary "lt" (Arg 2) (Arg 0)) (Real -1.0) (Real 1.0))
  :ruleset pullbacks)
(rewrite (Pullback "Laplace log density" 3 0)
  (Binary "mul" (Binary "divide" (Bar) (Arg 1)) (LaplaceSlope)) :ruleset pullbacks)
(rewrite (Pullback "Laplace log density" 3 1)
  (Binary "mul" (Binary "divide" (Bar) (Arg 1))
    (Binary "sub" (Unary "abs" (R)) (Real 1.0))) :ruleset pullbacks)
(rewrite (Pullback "Laplace log density" 3 2)
  (Unary "neg" (Binary "mul" (Binary "divide" (Bar) (Arg 1)) (LaplaceSlope)))
  :ruleset pullbacks)

; A zero count has no reciprocal term, including at a rounded endpoint.
(constructor CountRatio (Expr Expr) Expr :unextractable)
(rewrite (CountRatio count chance) (Ternary "ifelse" (Unary "iszero" count)
  (Real 0.0) (Binary "divide" count chance)) :ruleset pullbacks)
(rewrite (Pullback "Poisson log density" 2 0) (Binary "mul" (Bar) (Binary "sub"
  (CountRatio (Arg 1) (Arg 0)) (Real 1.0))) :ruleset pullbacks)
(rewrite (Pullback "Bernoulli log density" 2 0)
  (Binary "mul" (Bar) (Binary "sub"
    (CountRatio (Unary "real" (Arg 1)) (Arg 0))
    (CountRatio (Binary "sub" (Real 1.0) (Unary "real" (Arg 1)))
      (Binary "sub" (Real 1.0) (Arg 0))))) :ruleset pullbacks)
(rewrite (Pullback "Binomial log density" 3 1)
  (Binary "mul" (Bar) (Binary "sub" (CountRatio (Arg 2) (Arg 1))
    (CountRatio (Binary "sub" (Arg 0) (Arg 2)) (Binary "sub" (Real 1.0) (Arg 1)))))
  :ruleset pullbacks)
(rewrite (Pullback "NegativeBinomial log density" 3 0)
  (Binary "mul" (Bar) (Binary "sub"
    (Binary "sub" (SpecialUnary "digamma" (Binary "add" (Arg 2) (Arg 0)))
      (SpecialUnary "digamma" (Arg 0)))
    (Unary "log1p" (Binary "divide" (Real 1.0) (Arg 1)))))
  :ruleset pullbacks)
(rewrite (Pullback "NegativeBinomial log density" 3 1)
  (Binary "mul" (Bar)
    (Binary "divide" (Binary "sub" (Binary "divide" (Arg 0) (Arg 1)) (Arg 2))
      (Binary "add" (Arg 1) (Real 1.0))))
  :ruleset pullbacks)
(constructor NegativeBinomial2Total () Expr :unextractable)
(rewrite (NegativeBinomial2Total) (Binary "add" (Arg 0) (Arg 1)) :ruleset pullbacks)
(rewrite (Pullback "NegativeBinomial2 log density" 3 0)
  (Binary "mul" (Bar) (Binary "mul" (Binary "divide" (Arg 1) (NegativeBinomial2Total))
    (Binary "sub" (CountRatio (Arg 2) (Arg 0)) (Real 1.0))))
  :ruleset pullbacks)
(rewrite (Pullback "NegativeBinomial2 log density" 3 1)
  (Binary "mul" (Bar) (Binary "sub"
    (Binary "add"
      (Binary "sub" (SpecialUnary "digamma" (Binary "add" (Arg 2) (Arg 1)))
        (SpecialUnary "digamma" (Arg 1)))
      (Binary "divide" (Binary "sub" (Arg 0) (Arg 2)) (NegativeBinomial2Total)))
    (Unary "log1p" (Binary "divide" (Arg 0) (Arg 1)))))
  :ruleset pullbacks)
(rewrite (Pullback "Uniform log density" 2 1) (ZeroOut) :ruleset pullbacks)

(constructor ChiSquaredShape () Expr :unextractable)
(rewrite (ChiSquaredShape) (Binary "mul" (Real 0.5) (Arg 0)) :ruleset pullbacks)
(rewrite (Pullback "ChiSquared log density" 2 0)
  (Binary "mul" (Binary "mul" (Bar) (Real 0.5))
    (Binary "sub" (Binary "sub" (Unary "log" (Arg 1)) (Real 0.6931471805599453))
      (SpecialUnary "digamma" (ChiSquaredShape)))) :ruleset pullbacks)
(rewrite (Pullback "ChiSquared log density" 2 1)
  (Binary "mul" (Bar) (Binary "sub"
    (Binary "divide" (Binary "sub" (ChiSquaredShape) (Real 1.0)) (Arg 1))
    (Real 0.5))) :ruleset pullbacks)

(rewrite (Pullback "Pareto log density" 3 0)
  (Binary "mul" (Bar) (Binary "add" (Binary "divide" (Real 1.0) (Arg 0))
    (Binary "sub" (Unary "log" (Arg 1)) (Unary "log" (Arg 2))))) :ruleset pullbacks)
(rewrite (Pullback "Pareto log density" 3 1)
  (Binary "mul" (Bar) (Binary "divide" (Arg 0) (Arg 1))) :ruleset pullbacks)
(rewrite (Pullback "Pareto log density" 3 2)
  (Unary "neg" (Binary "mul" (Bar)
    (Binary "divide" (Binary "add" (Arg 0) (Real 1.0)) (Arg 2)))) :ruleset pullbacks)

(constructor RayleighSquare () Expr :unextractable)
(rewrite (RayleighSquare) (Unary "abs2" (Binary "divide" (Arg 1) (Arg 0)))
  :ruleset pullbacks)
(rewrite (Pullback "Rayleigh log density" 2 0)
  (Binary "mul" (Binary "divide" (Bar) (Arg 0))
    (Binary "sub" (RayleighSquare) (Real 2.0))) :ruleset pullbacks)
(rewrite (Pullback "Rayleigh log density" 2 1)
  (Binary "mul" (Binary "divide" (Bar) (Arg 1))
    (Binary "sub" (Real 1.0) (RayleighSquare))) :ruleset pullbacks)

(constructor WeibullRatio () Expr :unextractable)
(constructor WeibullPower () Expr :unextractable)
(rewrite (WeibullRatio) (Binary "divide" (Arg 2) (Arg 1)) :ruleset pullbacks)
(rewrite (WeibullPower) (Binary "pow" (WeibullRatio) (Arg 0)) :ruleset pullbacks)
(rewrite (Pullback "Weibull log density" 3 0)
  (Binary "mul" (Bar) (Binary "add" (Binary "divide" (Real 1.0) (Arg 0))
    (Binary "mul" (Binary "sub" (Real 1.0) (WeibullPower))
      (Unary "log" (WeibullRatio))))) :ruleset pullbacks)
(rewrite (Pullback "Weibull log density" 3 1)
  (Binary "mul" (Binary "divide" (Bar) (Arg 1))
    (Binary "mul" (Arg 0) (Binary "sub" (WeibullPower) (Real 1.0))))
  :ruleset pullbacks)
(rewrite (Pullback "Weibull log density" 3 2)
  (Binary "mul" (Binary "divide" (Bar) (Arg 2))
    (Binary "sub" (Binary "sub" (Arg 0) (Real 1.0))
      (Binary "mul" (Arg 0) (WeibullPower)))) :ruleset pullbacks)

(rewrite (Pullback "Geometric log density" 2 0)
  (Binary "mul" (Bar) (Binary "sub" (Binary "divide" (Real 1.0) (Arg 0))
    (CountRatio (Arg 1) (Binary "sub" (Real 1.0) (Arg 0))))) :ruleset pullbacks)
(rewrite (Pullback "ContinuedPoisson log density" 2 0)
  (Binary "mul" (Bar) (Binary "sub" (CountRatio (Arg 1) (Arg 0)) (Real 1.0)))
  :ruleset pullbacks)
; At x = rate = 0, the primal uses the -rate boundary branch.
(rewrite (Pullback "ContinuedPoisson log density" 2 1)
  (Ternary "ifelse" (Unary "iszero" (Arg 0)) (Real 0.0)
    (Binary "mul" (Bar) (Binary "sub" (Unary "log" (Arg 0))
      (SpecialUnary "digamma" (Binary "add" (Arg 1) (Real 1.0)))))) :ruleset pullbacks)

; Discrete index conventions are the same as get and get0.
(rewrite (Pullback "Categorical log density" 2 0)
  (Scatter (Binary "divide" (Bar) (Binary "get" (Arg 0) (Arg 1))) 1) :ruleset pullbacks)
(rewrite (Pullback "Categorical0 log density" 2 0)
  (Scatter (Binary "divide" (Bar) (Binary "get0" (Arg 0) (Arg 1))) 0) :ruleset pullbacks)
(rewrite (Pushforward "Categorical log density" 2 0)
  (Binary "divide" (Binary "get" (Bar) (Arg 1)) (Binary "get" (Arg 0) (Arg 1)))
  :ruleset pullbacks)
(rewrite (Pushforward "Categorical0 log density" 2 0)
  (Binary "divide" (Binary "get0" (Bar) (Arg 1)) (Binary "get0" (Arg 0) (Arg 1)))
  :ruleset pullbacks)

; Clamp the gathers so masked invalid categories can contribute zero in the scatter.
(constructor CategoricalIndices (i64) Expr :unextractable)
(rewrite (CategoricalIndices 1)
  (MapBinary "min" (MapBinary "max" (Arg 1) (Int 1)) (Unary "lengthof" (Arg 0)))
  :ruleset pullbacks)
(rewrite (CategoricalIndices 0)
  (MapBinary "min" (MapBinary "max" (Arg 1) (Int 0))
    (Binary "sub" (Unary "lengthof" (Arg 0)) (Int 1)))
  :ruleset pullbacks)
(constructor IidCategoryRatio (String i64) Expr :unextractable)
(rewrite (IidCategoryRatio selection base)
  (MapTernary "ifelse" (MapUnary "iszero" (Bar)) (Real 0.0)
    (MapBinary "divide" (Bar) (Binary selection (Arg 0) (CategoricalIndices base))))
  :ruleset pullbacks)
(rewrite (Pullback "iid Categorical log density" 2 0)
  (Scatter (IidCategoryRatio "get" 1) 1) :ruleset pullbacks)
(rewrite (Pullback "iid Categorical0 log density" 2 0)
  (Scatter (IidCategoryRatio "get0" 0) 0) :ruleset pullbacks)
(rewrite (Pushforward "iid Categorical log density" 2 0)
  (MapBinary "divide" (Binary "get" (Bar) (CategoricalIndices 1))
    (Binary "get" (Arg 0) (CategoricalIndices 1))) :ruleset pullbacks)
(rewrite (Pushforward "iid Categorical0 log density" 2 0)
  (MapBinary "divide" (Binary "get0" (Bar) (CategoricalIndices 0))
    (Binary "get0" (Arg 0) (CategoricalIndices 0))) :ruleset pullbacks)

; These density rules operate on one vector-valued event, with a scalar score.
(constructor DirichletShape () Expr :unextractable)
(rewrite (DirichletShape)
  (MapBinary "add" (MapUnary "log" (Arg 1))
    (MapBinary "sub" (SpecialUnary "digamma" (Unary "sum" (Arg 0)))
      (MapSpecialUnary "digamma" (Arg 0))))
  :ruleset pullbacks)
(constructor DirichletObservation () Expr :unextractable)
(rewrite (DirichletObservation)
  (MapBinary "divide" (MapBinary "sub" (Arg 0) (Real 1.0)) (Arg 1))
  :ruleset pullbacks)
(rewrite (Pullback "Dirichlet log density" 2 0)
  (Binary "mul" (Bar) (DirichletShape)) :ruleset pullbacks)
(rewrite (Pullback "Dirichlet log density" 2 1)
  (Binary "mul" (Bar) (DirichletObservation)) :ruleset pullbacks)
(rewrite (Pushforward "Dirichlet log density" 2 0)
  (Unary "sum" (MapBinary "mul" (Bar) (DirichletShape))) :ruleset pullbacks)
(rewrite (Pushforward "Dirichlet log density" 2 1)
  (Unary "sum" (MapBinary "mul" (Bar) (DirichletObservation))) :ruleset pullbacks)

; The symmetric positive-definite covariance lives in its full matrix layout.
(constructor MvNormalSolve () Expr :unextractable)
(constructor MvNormalCovariance () Expr :unextractable)
(rewrite (MvNormalSolve) (Binary "linsolve" (Arg 1) (Binary "sub" (Arg 2) (Arg 0)))
  :ruleset pullbacks)
(rewrite (MvNormalCovariance)
  (Binary "mul" (Real 0.5)
    (Binary "sub" (Unary "self_outer" (MvNormalSolve)) (Unary "inv" (Arg 1))))
  :ruleset pullbacks)
(rewrite (Pullback "MvNormal log density" 3 0)
  (Binary "mul" (Bar) (MvNormalSolve)) :ruleset pullbacks)
(rewrite (Pullback "MvNormal log density" 3 1)
  (Binary "mul" (Bar) (MvNormalCovariance)) :ruleset pullbacks)
(rewrite (Pullback "MvNormal log density" 3 2)
  (Unary "neg" (Binary "mul" (Bar) (MvNormalSolve))) :ruleset pullbacks)
(rewrite (Pushforward "MvNormal log density" 3 0)
  (Unary "sum" (MapBinary "mul" (Bar) (MvNormalSolve))) :ruleset pullbacks)
(rewrite (Pushforward "MvNormal log density" 3 1)
  (Unary "sum" (MapBinary "mul" (Bar) (MvNormalCovariance))) :ruleset pullbacks)
(rewrite (Pushforward "MvNormal log density" 3 2)
  (Unary "neg" (Unary "sum" (MapBinary "mul" (Bar) (MvNormalSolve)))) :ruleset pullbacks)

; Treat the zero exponent before forming the base power.
(constructor ZeroExponent () Expr :unextractable)
(rewrite (ZeroExponent) (Unary "iszero" (Arg 1)) :ruleset pullbacks)
(rewrite (Pullback "pow" 2 0)
  (Ternary "ifelse" (ZeroExponent) (Real 0.0)
    (Binary "mul" (Binary "mul" (Bar) (Arg 1))
      (Binary "pow"
        (Ternary "ifelse" (ZeroExponent) (Real 1.0) (Arg 0))
        (Binary "sub" (Arg 1) (Real 1.0))))) :ruleset pullbacks)
(rewrite (Pullback "pow" 2 1)
  (Binary "mul" (Binary "mul" (Bar) (Out)) (Unary "log" (Arg 0))) :ruleset pullbacks)

; The smooth abs branches have slopes -1 and +1. Use zero at the kink.
(rewrite (Pullback "abs" 1 0)
  (Ternary "ifelse" (Unary "iszero" (Arg 0)) (Real 0.0)
    (Ternary "ifelse" (Binary "lt" (Arg 0) (Real 0.0)) (Unary "neg" (Bar)) (Bar)))
  :ruleset pullbacks)
(rewrite (Pullback "logit" 1 0)
  (Binary "divide" (Binary "divide" (Bar) (Arg 0))
    (Binary "sub" (Real 1.0) (Arg 0))) :ruleset pullbacks)
(rewrite (Pullback "logsumexp" 1 0) (LogSumExp 0) :ruleset pullbacks)
(rewrite (Pushforward "logsumexp" 1 0) (LogSumExp 1) :ruleset pullbacks)
