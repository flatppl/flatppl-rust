; Scalar predictor eta = alpha + X*beta. The family supplies the row score slope.
(relation ScalarPredictor (String i64))
(ScalarPredictor "Normal GLM log density" 5)
(ScalarPredictor "Bernoulli GLM log density" 4)
(ScalarPredictor "Binomial GLM log density" 5)
(ScalarPredictor "Poisson GLM log density" 4)
(ScalarPredictor "NegativeBinomial2 GLM log density" 5)
(ScalarPredictor "StudentT GLM log density" 6)
(ScalarPredictor "Gamma GLM log density" 5)
(ScalarPredictor "Beta GLM log density" 5)

(constructor GlmEta () Expr :unextractable)
(rewrite (GlmEta) (MapBinary "add" (Arg 1) (Binary "mul" (Arg 0) (Arg 2)))
  :ruleset pullbacks)
(constructor GlmResponse (i64) Expr :unextractable)
(rewrite (GlmResponse arity) (Arg (- arity 1)) :ruleset pullbacks)
(constructor GlmSlope (String) Expr :unextractable)

(rewrite (Pullback family arity 0)
  (MapBinary "mul"
    (Ternary "addaxes" (Binary "mul" (Bar) (GlmSlope family)) (Int 0) (Int 1))
    (Ternary "addaxes" (Arg 2) (Int 1) (Int 0)))
  :when ((ScalarPredictor family arity)) :ruleset pullbacks)
(rewrite (Pullback family arity 1)
  (Binary "mul" (Bar) (Unary "sum" (GlmSlope family)))
  :when ((ScalarPredictor family arity)) :ruleset pullbacks)
(rewrite (Pullback family arity 2)
  (Binary "mul" (Bar) (Binary "mul" (Unary "transpose" (Arg 0)) (GlmSlope family)))
  :when ((ScalarPredictor family arity)) :ruleset pullbacks)
(rewrite (Pushforward family arity 0) (MathDot (Binary "mul" (Bar) (Arg 2)) (GlmSlope family))
  :when ((ScalarPredictor family arity)) :ruleset pullbacks)
(rewrite (Pushforward family arity 1)
  (Binary "mul" (Bar) (Unary "sum" (GlmSlope family)))
  :when ((ScalarPredictor family arity)) :ruleset pullbacks)
(rewrite (Pushforward family arity 2) (MathDot (Binary "mul" (Arg 0) (Bar)) (GlmSlope family))
  :when ((ScalarPredictor family arity)) :ruleset pullbacks)

(constructor GlmResidual (i64) Expr :unextractable)
(rewrite (GlmResidual arity)
  (MapBinary "divide" (Binary "sub" (GlmResponse arity) (GlmEta)) (Arg 3))
  :ruleset pullbacks)
(constructor GlmNormalScale () Expr :unextractable)
(rewrite (GlmNormalScale)
  (MapBinary "divide" (MapBinary "sub" (MapUnary "abs2" (GlmResidual 5)) (Real 1.0))
    (Arg 3)) :ruleset pullbacks)
(rewrite (GlmSlope "Normal GLM log density")
  (MapBinary "divide" (GlmResidual 5) (Arg 3)) :ruleset pullbacks)
(rewrite (Pullback "Normal GLM log density" 5 3)
  (Binary "mul" (Bar) (Unary "sum" (GlmNormalScale))) :ruleset pullbacks)
(rewrite (Pushforward "Normal GLM log density" 5 3)
  (Binary "mul" (Bar) (Unary "sum" (GlmNormalScale))) :ruleset pullbacks)
(rewrite (Pullback "Normal GLM log density" 5 4)
  (Binary "mul" (Unary "neg" (Bar)) (GlmSlope "Normal GLM log density")) :ruleset pullbacks)
(rewrite (Pushforward "Normal GLM log density" 5 4)
  (Unary "neg" (MathDot (Bar) (GlmSlope "Normal GLM log density"))) :ruleset pullbacks)

(constructor GlmProbability () Expr :unextractable)
(rewrite (GlmProbability) (MapUnary "invlogit" (GlmEta)) :ruleset pullbacks)
(constructor GlmComplement () Expr :unextractable)
(rewrite (GlmComplement) (MapUnary "invlogit" (Unary "neg" (GlmEta))) :ruleset pullbacks)
(rewrite (GlmSlope "Bernoulli GLM log density")
  (MapTernary "ifelse" (MapUnary "iszero" (MapUnary "real" (Arg 3)))
    (Unary "neg" (GlmProbability)) (GlmComplement)) :ruleset pullbacks)
(rewrite (GlmSlope "Binomial GLM log density")
  (Binary "sub" (MapBinary "mul" (Arg 4) (GlmComplement))
    (MapBinary "mul" (MapBinary "sub" (Arg 3) (Arg 4)) (GlmProbability)))
  :ruleset pullbacks)
(rewrite (GlmSlope "Poisson GLM log density")
  (Binary "sub" (MapUnary "real" (Arg 3)) (MapUnary "exp" (GlmEta)))
  :ruleset pullbacks)

; Derivative of softplus at the signed log mean-to-shape ratio.
(constructor GlmNegBinGap () Expr :unextractable)
(rewrite (GlmNegBinGap) (MapBinary "sub" (GlmEta) (Unary "log" (Arg 3))) :ruleset pullbacks)
(constructor GlmSoftplus (Expr) Expr :unextractable)
(rewrite (GlmSoftplus t)
  (Binary "add" (MapBinary "max" t (Real 0.0))
    (MapUnary "log1p" (MapUnary "exp" (Unary "neg" (MapUnary "abs" t)))))
  :ruleset pullbacks)
(rewrite (GlmSlope "NegativeBinomial2 GLM log density")
  (Binary "sub"
    (MapBinary "mul" (Arg 4) (MapUnary "invlogit" (Unary "neg" (GlmNegBinGap))))
    (MapBinary "mul" (Arg 3) (MapUnary "invlogit" (GlmNegBinGap))))
  :ruleset pullbacks)
(constructor GlmNegBinShape () Expr :unextractable)
(rewrite (GlmNegBinShape)
  (MapBinary "sub" (MapBinary "sub"
    (MapSpecialUnary "digamma" (MapBinary "add" (Arg 4) (Arg 3)))
    (SpecialUnary "digamma" (Arg 3)))
    (Binary "add" (GlmSoftplus (GlmNegBinGap))
      (MapBinary "divide" (GlmSlope "NegativeBinomial2 GLM log density") (Arg 3))))
  :ruleset pullbacks)
(rewrite (Pullback "NegativeBinomial2 GLM log density" 5 3)
  (Binary "mul" (Bar) (Unary "sum" (GlmNegBinShape))) :ruleset pullbacks)
(rewrite (Pushforward "NegativeBinomial2 GLM log density" 5 3)
  (Binary "mul" (Bar) (Unary "sum" (GlmNegBinShape))) :ruleset pullbacks)

; The log-mean link uses the centered response ratio, even near the mean.
(constructor GlmGammaResidual () Expr :unextractable)
(rewrite (GlmGammaResidual) (Binary "sub" (MapUnary "log" (Arg 4)) (GlmEta))
  :ruleset pullbacks)
(rewrite (GlmSlope "Gamma GLM log density")
  (MapBinary "mul" (Arg 3) (MapUnary "expm1" (GlmGammaResidual))) :ruleset pullbacks)
(constructor GlmGammaShape () Expr :unextractable)
(rewrite (GlmGammaShape)
  (MapBinary "add"
    (Ternary "ifelse" (Binary "ge" (Arg 3) (Real 16.0))
      (DigammaCorrection (Binary "divide" (Real 1.0) (Arg 3))
        (Unary "abs2" (Binary "divide" (Real 1.0) (Arg 3))))
      (Binary "sub" (Unary "log" (Arg 3)) (SpecialUnary "digamma" (Arg 3))))
    (Binary "sub" (GlmGammaResidual) (MapUnary "expm1" (GlmGammaResidual))))
  :ruleset pullbacks)
(constructor GlmGammaResponse () Expr :unextractable)
(rewrite (GlmGammaResponse)
  (MapBinary "divide" (MapBinary "sub" (Real -1.0) (GlmSlope "Gamma GLM log density"))
    (Arg 4)) :ruleset pullbacks)
(rewrite (Pullback "Gamma GLM log density" 5 3)
  (Binary "mul" (Bar) (Unary "sum" (GlmGammaShape))) :ruleset pullbacks)
(rewrite (Pushforward "Gamma GLM log density" 5 3)
  (Binary "mul" (Bar) (Unary "sum" (GlmGammaShape))) :ruleset pullbacks)
(rewrite (Pullback "Gamma GLM log density" 5 4)
  (Binary "mul" (Bar) (GlmGammaResponse)) :ruleset pullbacks)
(rewrite (Pushforward "Gamma GLM log density" 5 4)
  (MathDot (Bar) (GlmGammaResponse)) :ruleset pullbacks)

(constructor GlmStudentSquare () Expr :unextractable)
(rewrite (GlmStudentSquare) (MapUnary "abs2" (GlmResidual 6)) :ruleset pullbacks)
(constructor GlmStudentRatio () Expr :unextractable)
(rewrite (GlmStudentRatio)
  (MapTernary "ifelse" (Unary "isinf" (Arg 4)) (Real 1.0)
    (MapBinary "divide" (Binary "add" (Arg 4) (Real 1.0))
      (MapBinary "add" (Arg 4) (GlmStudentSquare)))) :ruleset pullbacks)
(rewrite (GlmSlope "StudentT GLM log density")
  (MapBinary "divide" (MapBinary "mul" (GlmResidual 6) (GlmStudentRatio)) (Arg 3))
  :ruleset pullbacks)
(constructor GlmStudentScale () Expr :unextractable)
(rewrite (GlmStudentScale)
  (MapBinary "divide"
    (MapBinary "sub" (MapBinary "mul" (GlmStudentSquare) (GlmStudentRatio)) (Real 1.0))
    (Arg 3)) :ruleset pullbacks)
(constructor GlmStudentDf () Expr :unextractable)
(rewrite (GlmStudentDf)
  (MapTernary "ifelse" (Unary "isinf" (Arg 4)) (Real 0.0)
    (MapBinary "mul" (Real 0.5)
      (Binary "sub"
        (MapBinary "add" (DigammaDifference (Binary "mul" (Arg 4) (Real 0.5)) (Real 0.5))
          (MapBinary "divide" (MapBinary "sub" (GlmStudentSquare) (Real 1.0))
            (MapBinary "add" (Arg 4) (GlmStudentSquare))))
        (MapUnary "log1p" (MapBinary "divide" (GlmStudentSquare) (Arg 4))))))
  :ruleset pullbacks)
(rewrite (Pullback "StudentT GLM log density" 6 3)
  (Binary "mul" (Bar) (Unary "sum" (GlmStudentScale))) :ruleset pullbacks)
(rewrite (Pushforward "StudentT GLM log density" 6 3)
  (Binary "mul" (Bar) (Unary "sum" (GlmStudentScale))) :ruleset pullbacks)
(rewrite (Pullback "StudentT GLM log density" 6 4)
  (Binary "mul" (Bar) (Unary "sum" (GlmStudentDf))) :ruleset pullbacks)
(rewrite (Pushforward "StudentT GLM log density" 6 4)
  (Binary "mul" (Bar) (Unary "sum" (GlmStudentDf))) :ruleset pullbacks)
(rewrite (Pullback "StudentT GLM log density" 6 5)
  (Binary "mul" (Unary "neg" (Bar)) (GlmSlope "StudentT GLM log density")) :ruleset pullbacks)
(rewrite (Pushforward "StudentT GLM log density" 6 5)
  (Unary "neg" (MathDot (Bar) (GlmSlope "StudentT GLM log density"))) :ruleset pullbacks)

; psi(shape) = psi(shape + 1) - 1/shape. Multiplying the recurrence
; analytically keeps the logit derivative finite when either shape rounds to zero.
(constructor GlmBetaShape (Expr) Expr :unextractable)
(rewrite (GlmBetaShape p) (MapBinary "mul" (Arg 3) p) :ruleset pullbacks)
(constructor GlmBetaShiftedPsi (Expr) Expr :unextractable)
(rewrite (GlmBetaShiftedPsi p)
  (MapSpecialUnary "digamma" (MapBinary "add" (GlmBetaShape p) (Real 1.0)))
  :ruleset pullbacks)
(constructor GlmBetaLogObsComplement () Expr :unextractable)
(rewrite (GlmBetaLogObsComplement) (MapUnary "log1p" (Unary "neg" (Arg 4)))
  :ruleset pullbacks)
(constructor GlmBetaWeight () Expr :unextractable)
(rewrite (GlmBetaWeight) (MapBinary "mul" (GlmBetaShape (GlmProbability)) (GlmComplement))
  :ruleset pullbacks)
(constructor GlmBetaLarge () Expr :unextractable)
(rewrite (GlmBetaLarge)
  (MapBinary "land"
    (MapBinary "ge" (GlmBetaShape (GlmProbability)) (Real 16.0))
    (MapBinary "ge" (GlmBetaShape (GlmComplement)) (Real 16.0))) :ruleset pullbacks)
(constructor GlmBetaCorrection (Expr) Expr :unextractable)
(rewrite (GlmBetaCorrection x)
  (DigammaCorrection (MapBinary "divide" (Real 1.0) x)
    (MapUnary "abs2" (MapBinary "divide" (Real 1.0) x))) :ruleset pullbacks)
(constructor GlmBetaLogRatio (Expr Expr) Expr :unextractable)
(rewrite (GlmBetaLogRatio relative log_ratio)
  (MapTernary "ifelse" (MapBinary "lt" (MapUnary "abs" relative) (Real 0.5))
    (MapUnary "log1p" relative) log_ratio) :ruleset pullbacks)
(constructor GlmBetaLogMeanRatio () Expr :unextractable)
(rewrite (GlmBetaLogMeanRatio)
  (GlmBetaLogRatio (MapBinary "divide" (Binary "sub" (Arg 4) (GlmProbability)) (GlmProbability))
    (Binary "add" (MapUnary "log" (Arg 4)) (GlmSoftplus (Unary "neg" (GlmEta)))))
  :ruleset pullbacks)
(constructor GlmBetaLogComplementRatio () Expr :unextractable)
(rewrite (GlmBetaLogComplementRatio)
  (GlmBetaLogRatio (MapBinary "divide" (Binary "sub" (GlmProbability) (Arg 4)) (GlmComplement))
    (Binary "add" (GlmBetaLogObsComplement) (GlmSoftplus (GlmEta))))
  :ruleset pullbacks)
(constructor GlmBetaCenteredSlope () Expr :unextractable)
(rewrite (GlmBetaCenteredSlope)
  (MapBinary "mul" (GlmBetaWeight)
    (Binary "add"
      (Binary "sub" (GlmBetaLogMeanRatio) (GlmBetaLogComplementRatio))
      (Binary "sub" (GlmBetaCorrection (GlmBetaShape (GlmProbability)))
        (GlmBetaCorrection (GlmBetaShape (GlmComplement)))))) :ruleset pullbacks)
(constructor GlmBetaShiftedSlope () Expr :unextractable)
(rewrite (GlmBetaShiftedSlope)
  (Binary "add" (Binary "sub" (GlmComplement) (GlmProbability))
    (MapBinary "mul" (GlmBetaWeight)
      (Binary "add"
        (Binary "sub" (MapUnary "log" (Arg 4)) (GlmBetaLogObsComplement))
        (Binary "sub" (GlmBetaShiftedPsi (GlmComplement)) (GlmBetaShiftedPsi (GlmProbability))))))
  :ruleset pullbacks)
(rewrite (GlmSlope "Beta GLM log density")
  (MapTernary "ifelse" (GlmBetaLarge) (GlmBetaCenteredSlope) (GlmBetaShiftedSlope))
  :ruleset pullbacks)
(constructor GlmBetaCenteredPrecision () Expr :unextractable)
(rewrite (GlmBetaCenteredPrecision)
  (MapBinary "sub"
    (Binary "add"
      (MapBinary "mul" (GlmProbability) (Binary "add" (GlmBetaLogMeanRatio)
        (GlmBetaCorrection (GlmBetaShape (GlmProbability)))))
      (MapBinary "mul" (GlmComplement) (Binary "add" (GlmBetaLogComplementRatio)
        (GlmBetaCorrection (GlmBetaShape (GlmComplement))))))
    (GlmBetaCorrection (Arg 3))) :ruleset pullbacks)
(constructor GlmBetaShiftedPrecision () Expr :unextractable)
(rewrite (GlmBetaShiftedPrecision)
  (MapBinary "add"
    (Binary "add" (SpecialUnary "digamma" (Arg 3)) (Binary "divide" (Real 2.0) (Arg 3)))
    (Binary "add"
      (MapBinary "mul" (GlmProbability)
        (Binary "sub" (MapUnary "log" (Arg 4)) (GlmBetaShiftedPsi (GlmProbability))))
      (MapBinary "mul" (GlmComplement)
        (Binary "sub" (GlmBetaLogObsComplement) (GlmBetaShiftedPsi (GlmComplement))))))
  :ruleset pullbacks)
(constructor GlmBetaPrecision () Expr :unextractable)
(rewrite (GlmBetaPrecision)
  (MapTernary "ifelse" (GlmBetaLarge) (GlmBetaCenteredPrecision) (GlmBetaShiftedPrecision))
  :ruleset pullbacks)
(constructor GlmBetaResponse () Expr :unextractable)
(rewrite (GlmBetaResponse)
  (Binary "sub"
    (MapBinary "divide" (MapBinary "sub" (GlmBetaShape (GlmProbability)) (Real 1.0)) (Arg 4))
    (MapBinary "divide" (MapBinary "sub" (GlmBetaShape (GlmComplement)) (Real 1.0))
      (MapBinary "sub" (Real 1.0) (Arg 4)))) :ruleset pullbacks)
(rewrite (Pullback "Beta GLM log density" 5 3)
  (Binary "mul" (Bar) (Unary "sum" (GlmBetaPrecision))) :ruleset pullbacks)
(rewrite (Pushforward "Beta GLM log density" 5 3)
  (Binary "mul" (Bar) (Unary "sum" (GlmBetaPrecision))) :ruleset pullbacks)
(rewrite (Pullback "Beta GLM log density" 5 4)
  (Binary "mul" (Bar) (GlmBetaResponse)) :ruleset pullbacks)
(rewrite (Pushforward "Beta GLM log density" 5 4)
  (MathDot (Bar) (GlmBetaResponse)) :ruleset pullbacks)

; Categorical logits have one column per class. Each row contributes one
; one-hot category minus its softmax.
(constructor GlmClassEta () Expr :unextractable)
(rewrite (GlmClassEta)
  (MapBinary "add" (Binary "mul" (Arg 0) (Arg 2))
    (Ternary "addaxes" (Arg 1) (Int 1) (Int 0))) :ruleset pullbacks)
(constructor GlmClassWeights () Expr :unextractable)
(rewrite (GlmClassWeights)
  (MapUnary "exp" (MapBinary "sub" (GlmClassEta)
    (Ternary "addaxes" (RowReduce "maximum" (GlmClassEta)) (Int 0) (Int 1))))
  :ruleset pullbacks)
(constructor GlmClassSlope () Expr :unextractable)
(rewrite (GlmClassSlope)
  (Binary "sub" (MapUnary "real" (CategoryMask (Arg 3) (Unary "indicesof" (Arg 1))))
    (MapBinary "divide" (GlmClassWeights)
      (Ternary "addaxes" (RowReduce "sum" (GlmClassWeights)) (Int 0) (Int 1))))
  :ruleset pullbacks)
(constructor GlmClassIntercept () Expr :unextractable)
(rewrite (GlmClassIntercept)
  (Binary "mul" (Unary "transpose" (GlmClassSlope)) (Unary "ones" (Unary "lengthof" (Arg 3))))
  :ruleset pullbacks)
(rewrite (Pullback "Categorical GLM log density" 4 0)
  (Binary "mul" (Bar) (Binary "mul" (GlmClassSlope) (Unary "transpose" (Arg 2))))
  :ruleset pullbacks)
(rewrite (Pullback "Categorical GLM log density" 4 1)
  (Binary "mul" (Bar) (GlmClassIntercept)) :ruleset pullbacks)
(rewrite (Pullback "Categorical GLM log density" 4 2)
  (Binary "mul" (Bar) (Binary "mul" (Unary "transpose" (Arg 0)) (GlmClassSlope)))
  :ruleset pullbacks)
(rewrite (Pushforward "Categorical GLM log density" 4 0)
  (MathDot (Binary "mul" (Bar) (Arg 2)) (GlmClassSlope)) :ruleset pullbacks)
(rewrite (Pushforward "Categorical GLM log density" 4 1)
  (MathDot (Bar) (GlmClassIntercept)) :ruleset pullbacks)
(rewrite (Pushforward "Categorical GLM log density" 4 2)
  (MathDot (Binary "mul" (Arg 0) (Bar)) (GlmClassSlope)) :ruleset pullbacks)

; In the interior the ordered-logit row score is
; log(sigmoid(hi-eta)) + log(sigmoid(eta-lo)) + log1mexp(lo-hi).
; An endpoint keeps just its corresponding sigmoid term.
(constructor GlmOrderedEta () Expr :unextractable)
(rewrite (GlmOrderedEta) (Binary "mul" (Arg 0) (Arg 1)) :ruleset pullbacks)
(constructor GlmOrderedLowerIndex () Expr :unextractable)
(rewrite (GlmOrderedLowerIndex) (MapBinary "sub" (Arg 3) (Int 1)) :ruleset pullbacks)
(constructor GlmOrderedCut (Expr) Expr :unextractable)
(rewrite (GlmOrderedCut index)
  (Binary "get" (Arg 2)
    (MapBinary "min" (MapBinary "max" index (Int 1)) (Unary "lengthof" (Arg 2))))
  :ruleset pullbacks)
(constructor GlmOrderedHasLower () Expr :unextractable)
(rewrite (GlmOrderedHasLower) (MapBinary "gt" (Arg 3) (Int 1)) :ruleset pullbacks)
(constructor GlmOrderedHasUpper () Expr :unextractable)
(rewrite (GlmOrderedHasUpper) (MapBinary "le" (Arg 3) (Unary "lengthof" (Arg 2)))
  :ruleset pullbacks)
(constructor GlmOrderedLower () Expr :unextractable)
(rewrite (GlmOrderedLower)
  (MapTernary "ifelse" (GlmOrderedHasLower)
    (MapUnary "invlogit" (Binary "sub" (GlmOrderedCut (GlmOrderedLowerIndex)) (GlmOrderedEta)))
    (Real 0.0)) :ruleset pullbacks)
(constructor GlmOrderedUpper () Expr :unextractable)
(rewrite (GlmOrderedUpper)
  (MapTernary "ifelse" (GlmOrderedHasUpper)
    (MapUnary "invlogit" (Binary "sub" (GlmOrderedEta) (GlmOrderedCut (Arg 3))))
    (Real 0.0)) :ruleset pullbacks)
(constructor GlmOrderedSlope () Expr :unextractable)
(rewrite (GlmOrderedSlope) (Binary "sub" (GlmOrderedLower) (GlmOrderedUpper))
  :ruleset pullbacks)
(constructor GlmOrderedGapSlope () Expr :unextractable)
(rewrite (GlmOrderedGapSlope)
  (MapTernary "ifelse" (MapBinary "land" (GlmOrderedHasLower) (GlmOrderedHasUpper))
    (MapBinary "divide" (Real 1.0)
      (MapUnary "expm1" (Binary "sub" (GlmOrderedCut (Arg 3))
        (GlmOrderedCut (GlmOrderedLowerIndex)))))
    (Real 0.0)) :ruleset pullbacks)
(constructor GlmOrderedCutSlope () Expr :unextractable)
(rewrite (GlmOrderedCutSlope)
  (Binary "sub"
    (Binary "mul" (Unary "transpose" (MapUnary "real"
      (CategoryMask (Arg 3) (Unary "indicesof" (Arg 2)))))
      (Binary "add" (GlmOrderedUpper) (GlmOrderedGapSlope)))
    (Binary "mul" (Unary "transpose" (MapUnary "real"
      (CategoryMask (GlmOrderedLowerIndex) (Unary "indicesof" (Arg 2)))))
      (Binary "add" (GlmOrderedLower) (GlmOrderedGapSlope))))
  :ruleset pullbacks)
(rewrite (Pullback "Ordered GLM log density" 4 0)
  (MapBinary "mul"
    (Ternary "addaxes" (Binary "mul" (Bar) (GlmOrderedSlope)) (Int 0) (Int 1))
    (Ternary "addaxes" (Arg 1) (Int 1) (Int 0))) :ruleset pullbacks)
(rewrite (Pullback "Ordered GLM log density" 4 1)
  (Binary "mul" (Bar) (Binary "mul" (Unary "transpose" (Arg 0)) (GlmOrderedSlope)))
  :ruleset pullbacks)
(rewrite (Pullback "Ordered GLM log density" 4 2)
  (Binary "mul" (Bar) (GlmOrderedCutSlope)) :ruleset pullbacks)
(rewrite (Pushforward "Ordered GLM log density" 4 0)
  (MathDot (Binary "mul" (Bar) (Arg 1)) (GlmOrderedSlope)) :ruleset pullbacks)
(rewrite (Pushforward "Ordered GLM log density" 4 1)
  (MathDot (Binary "mul" (Arg 0) (Bar)) (GlmOrderedSlope)) :ruleset pullbacks)
(rewrite (Pushforward "Ordered GLM log density" 4 2) (MathDot (Bar) (GlmOrderedCutSlope))
  :ruleset pullbacks)
