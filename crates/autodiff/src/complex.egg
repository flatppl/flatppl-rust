; Scalar complex intermediates use the real inner product Re(conj(bar) * dz).
; The public query inputs, outputs, and seeds are still real.
(rewrite (Pullback "complex identity" 1 0) (Bar) :ruleset pullbacks)
(rewrite (Pullback "complex neg" 1 0) (Unary "neg" (Bar)) :ruleset pullbacks)
(rewrite (Pullback "complex conj" 1 0) (Unary "conj" (Bar)) :ruleset pullbacks)
(rewrite (Pullback "complex add" 2 0) (Bar) :ruleset pullbacks)
(rewrite (Pullback "complex add" 2 1) (Bar) :ruleset pullbacks)
(rewrite (Pullback "complex sub" 2 0) (Bar) :ruleset pullbacks)
(rewrite (Pullback "complex sub" 2 1) (Unary "neg" (Bar)) :ruleset pullbacks)

(rewrite (Pullback "complex real" 1 0) (Binary "complex" (Bar) (Real 0.0)) :ruleset pullbacks)
(rewrite (Pushforward "complex real" 1 0) (Unary "real" (Bar)) :ruleset pullbacks)
(rewrite (Pullback "complex imag" 1 0) (Binary "complex" (Real 0.0) (Bar)) :ruleset pullbacks)
(rewrite (Pushforward "complex imag" 1 0) (Unary "imag" (Bar)) :ruleset pullbacks)
(rewrite (Pullback "complex complex" 2 0) (Unary "real" (Bar)) :ruleset pullbacks)
(rewrite (Pullback "complex complex" 2 1) (Unary "imag" (Bar)) :ruleset pullbacks)
(rewrite (Pushforward "complex complex" 2 0) (Binary "complex" (Bar) (Real 0.0)) :ruleset pullbacks)
(rewrite (Pushforward "complex complex" 2 1) (Binary "complex" (Real 0.0) (Bar)) :ruleset pullbacks)
(rewrite (Pullback "complex abs2" 1 0)
  (Binary "mul" (Binary "mul" (Bar) (Real 2.0)) (Arg 0)) :ruleset pullbacks)
(rewrite (Pushforward "complex abs2" 1 0)
  (Binary "mul" (Real 2.0) (Unary "real" (Binary "mul" (Unary "conj" (Arg 0)) (Bar))))
  :ruleset pullbacks)

; For a holomorphic operation, reverse mode conjugates the local partial.
(rewrite (Pullback "complex mul" 2 0)
  (Binary "mul" (Bar) (Unary "conj" (Arg 1))) :ruleset pullbacks)
(rewrite (Pullback "complex mul" 2 1)
  (Binary "mul" (Bar) (Unary "conj" (Arg 0))) :ruleset pullbacks)
(rewrite (Pushforward "complex mul" 2 0) (Binary "mul" (Bar) (Arg 1)) :ruleset pullbacks)
(rewrite (Pushforward "complex mul" 2 1) (Binary "mul" (Arg 0) (Bar)) :ruleset pullbacks)
(rewrite (Pullback "complex divide" 2 0)
  (Binary "divide" (Bar) (Unary "conj" (Arg 1))) :ruleset pullbacks)
(rewrite (Pullback "complex divide" 2 1)
  (Unary "neg" (Binary "mul" (Binary "divide" (Bar) (Unary "conj" (Arg 1)))
    (Unary "conj" (Out)))) :ruleset pullbacks)
(rewrite (Pushforward "complex divide" 2 0) (Binary "divide" (Bar) (Arg 1)) :ruleset pullbacks)
(rewrite (Pushforward "complex divide" 2 1)
  (Unary "neg" (Binary "mul" (Binary "divide" (Bar) (Arg 1)) (Out))) :ruleset pullbacks)

(rewrite (Pullback "complex exp" 1 0) (Binary "mul" (Bar) (Unary "conj" (Out))) :ruleset pullbacks)
(rewrite (Pushforward "complex exp" 1 0) (Binary "mul" (Bar) (Out)) :ruleset pullbacks)
(rewrite (Pullback "complex log" 1 0) (Binary "divide" (Bar) (Unary "conj" (Arg 0))) :ruleset pullbacks)
(rewrite (Pushforward "complex log" 1 0) (Binary "divide" (Bar) (Arg 0)) :ruleset pullbacks)
(rewrite (Pullback "complex sqrt" 1 0)
  (Binary "mul" (Real 0.5) (Binary "divide" (Bar) (Unary "conj" (Out)))) :ruleset pullbacks)
(rewrite (Pushforward "complex sqrt" 1 0)
  (Binary "mul" (Real 0.5) (Binary "divide" (Bar) (Out))) :ruleset pullbacks)
(constructor ComplexElementarySlope (String) Expr :unextractable)
(constructor ComplexReciprocalSquare (Expr) Expr :unextractable)
(rewrite (ComplexReciprocalSquare value)
  (Binary "mul" (Binary "divide" (Real 1.0) value) (Binary "divide" (Real 1.0) value))
  :ruleset pullbacks)

; Inverse trig and hyperbolic slopes use the principal value already
; selected by the primal, including the sign of the square root.
(rewrite (ComplexElementarySlope "sin") (Unary "cos" (Arg 0)) :ruleset pullbacks)
(rewrite (Pushforward "complex sin" 1 0)
  (Binary "mul" (Bar) (ComplexElementarySlope "sin")) :ruleset pullbacks)
(rewrite (Pullback "complex sin" 1 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexElementarySlope "sin"))) :ruleset pullbacks)

(rewrite (ComplexElementarySlope "cos") (Unary "neg" (Unary "sin" (Arg 0))) :ruleset pullbacks)
(rewrite (Pushforward "complex cos" 1 0)
  (Binary "mul" (Bar) (ComplexElementarySlope "cos")) :ruleset pullbacks)
(rewrite (Pullback "complex cos" 1 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexElementarySlope "cos"))) :ruleset pullbacks)

(rewrite (ComplexElementarySlope "tan") (ComplexReciprocalSquare (Unary "cos" (Arg 0))) :ruleset pullbacks)
(rewrite (Pushforward "complex tan" 1 0)
  (Binary "mul" (Bar) (ComplexElementarySlope "tan")) :ruleset pullbacks)
(rewrite (Pullback "complex tan" 1 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexElementarySlope "tan"))) :ruleset pullbacks)

(rewrite (ComplexElementarySlope "sinh") (Unary "cosh" (Arg 0)) :ruleset pullbacks)
(rewrite (Pushforward "complex sinh" 1 0)
  (Binary "mul" (Bar) (ComplexElementarySlope "sinh")) :ruleset pullbacks)
(rewrite (Pullback "complex sinh" 1 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexElementarySlope "sinh"))) :ruleset pullbacks)

(rewrite (ComplexElementarySlope "cosh") (Unary "sinh" (Arg 0)) :ruleset pullbacks)
(rewrite (Pushforward "complex cosh" 1 0)
  (Binary "mul" (Bar) (ComplexElementarySlope "cosh")) :ruleset pullbacks)
(rewrite (Pullback "complex cosh" 1 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexElementarySlope "cosh"))) :ruleset pullbacks)

(rewrite (ComplexElementarySlope "tanh") (ComplexReciprocalSquare (Unary "cosh" (Arg 0))) :ruleset pullbacks)
(rewrite (Pushforward "complex tanh" 1 0)
  (Binary "mul" (Bar) (ComplexElementarySlope "tanh")) :ruleset pullbacks)
(rewrite (Pullback "complex tanh" 1 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexElementarySlope "tanh"))) :ruleset pullbacks)

(rewrite (ComplexElementarySlope "asin") (Binary "divide" (Real 1.0) (Unary "cos" (Out))) :ruleset pullbacks)
(rewrite (Pushforward "complex asin" 1 0)
  (Binary "mul" (Bar) (ComplexElementarySlope "asin")) :ruleset pullbacks)
(rewrite (Pullback "complex asin" 1 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexElementarySlope "asin"))) :ruleset pullbacks)

(rewrite (ComplexElementarySlope "acos") (Binary "divide" (Real -1.0) (Unary "sin" (Out))) :ruleset pullbacks)
(rewrite (Pushforward "complex acos" 1 0)
  (Binary "mul" (Bar) (ComplexElementarySlope "acos")) :ruleset pullbacks)
(rewrite (Pullback "complex acos" 1 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexElementarySlope "acos"))) :ruleset pullbacks)

(rewrite (ComplexElementarySlope "atan") (Binary "divide" (Real 1.0) (Binary "add" (Real 1.0) (Binary "mul" (Arg 0) (Arg 0)))) :ruleset pullbacks)
(rewrite (Pushforward "complex atan" 1 0)
  (Binary "mul" (Bar) (ComplexElementarySlope "atan")) :ruleset pullbacks)
(rewrite (Pullback "complex atan" 1 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexElementarySlope "atan"))) :ruleset pullbacks)

(rewrite (ComplexElementarySlope "asinh") (Binary "divide" (Real 1.0) (Unary "cosh" (Out))) :ruleset pullbacks)
(rewrite (Pushforward "complex asinh" 1 0)
  (Binary "mul" (Bar) (ComplexElementarySlope "asinh")) :ruleset pullbacks)
(rewrite (Pullback "complex asinh" 1 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexElementarySlope "asinh"))) :ruleset pullbacks)

(rewrite (ComplexElementarySlope "acosh") (Binary "divide" (Real 1.0) (Unary "sinh" (Out))) :ruleset pullbacks)
(rewrite (Pushforward "complex acosh" 1 0)
  (Binary "mul" (Bar) (ComplexElementarySlope "acosh")) :ruleset pullbacks)
(rewrite (Pullback "complex acosh" 1 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexElementarySlope "acosh"))) :ruleset pullbacks)

(rewrite (ComplexElementarySlope "atanh") (Binary "divide" (Real 1.0) (Binary "sub" (Real 1.0) (Binary "mul" (Arg 0) (Arg 0)))) :ruleset pullbacks)
(rewrite (Pushforward "complex atanh" 1 0)
  (Binary "mul" (Bar) (ComplexElementarySlope "atanh")) :ruleset pullbacks)
(rewrite (Pullback "complex atanh" 1 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexElementarySlope "atanh"))) :ruleset pullbacks)

; The modulus has a real codomain and is smooth off the origin.
(constructor ComplexUnit () Expr :unextractable)
(rewrite (ComplexUnit) (Binary "divide" (Arg 0) (Out)) :ruleset pullbacks)
(rewrite (Pullback "complex abs" 1 0)
  (Binary "mul" (Bar) (ComplexUnit)) :ruleset pullbacks)
(rewrite (Pushforward "complex abs" 1 0)
  (Unary "real" (Binary "mul" (Unary "conj" (ComplexUnit)) (Bar))) :ruleset pullbacks)

; Away from a branch cut, use the principal logarithm's local derivative.
(constructor ComplexPowBaseSlope () Expr :unextractable)
(rewrite (ComplexPowBaseSlope)
  (Ternary "ifelse"
    (Binary "land" (Unary "iszero" (Unary "real" (Arg 1))) (Unary "iszero" (Unary "imag" (Arg 1))))
    (Binary "complex" (Real 0.0) (Real 0.0))
    (Binary "mul" (Arg 1) (Binary "pow" (Arg 0) (Binary "sub" (Arg 1) (Real 1.0)))))
  :ruleset pullbacks)
(constructor ComplexPowExponentSlope () Expr :unextractable)
(rewrite (ComplexPowExponentSlope)
  (Binary "mul" (Out) (Unary "log" (Arg 0))) :ruleset pullbacks)
(rewrite (Pullback "complex pow" 2 0)
  (Binary "mul" (Bar) (Unary "conj" (ComplexPowBaseSlope))) :ruleset pullbacks)
(rewrite (Pullback "complex pow" 2 1)
  (Binary "mul" (Bar) (Unary "conj" (ComplexPowExponentSlope))) :ruleset pullbacks)
(rewrite (Pushforward "complex pow" 2 0)
  (Binary "mul" (Bar) (ComplexPowBaseSlope)) :ruleset pullbacks)
(rewrite (Pushforward "complex pow" 2 1)
  (Binary "mul" (Bar) (ComplexPowExponentSlope)) :ruleset pullbacks)

(rewrite (Pullback "complex cis" 1 0)
  (Unary "imag" (Binary "mul" (Unary "conj" (Out)) (Bar))) :ruleset pullbacks)
(rewrite (Pushforward "complex cis" 1 0)
  (Binary "mul" (Binary "complex" (Real 0.0) (Bar)) (Out)) :ruleset pullbacks)

; DLMF 10.6 and 10.29. The recurrences continue along the principal branch.
(constructor BesselArgumentJ () Expr :unextractable)
(rewrite (BesselArgumentJ)
  (Binary "mul" (Real 0.5)
    (Binary "sub"
      (SpecialBinary "bessel_j" (Binary "sub" (Arg 0) (Real 1.0)) (Arg 1))
      (SpecialBinary "bessel_j" (Binary "add" (Arg 0) (Real 1.0)) (Arg 1))))
  :ruleset pullbacks)
(rewrite (Pushforward "complex Bessel J" 2 1)
  (Binary "mul" (Bar) (BesselArgumentJ)) :ruleset pullbacks)
(rewrite (Pushforward "complex bounded Bessel J" 2 0)
  (Binary "mul" (Bar) (BesselOrder "j" (Arg 0) (Arg 1))) :ruleset pullbacks)
(rewrite (Pushforward "complex bounded Bessel J" 2 1)
  (Pushforward "complex Bessel J" 2 1) :ruleset pullbacks)
(rewrite (Pullback "complex Bessel J" 2 1)
  (Binary "mul" (Bar) (Unary "conj" (BesselArgumentJ))) :ruleset pullbacks)
(rewrite (Pullback "complex bounded Bessel J" 2 0)
  (Binary "mul" (Bar) (Unary "conj" (BesselOrder "j" (Arg 0) (Arg 1)))) :ruleset pullbacks)
(rewrite (Pullback "complex bounded Bessel J" 2 1)
  (Pullback "complex Bessel J" 2 1) :ruleset pullbacks)
(constructor BesselArgumentI () Expr :unextractable)
(rewrite (BesselArgumentI)
  (Binary "mul" (Real 0.5)
    (Binary "add"
      (SpecialBinary "bessel_i" (Binary "sub" (Arg 0) (Real 1.0)) (Arg 1))
      (SpecialBinary "bessel_i" (Binary "add" (Arg 0) (Real 1.0)) (Arg 1))))
  :ruleset pullbacks)
(rewrite (Pushforward "complex Bessel I" 2 1)
  (Binary "mul" (Bar) (BesselArgumentI)) :ruleset pullbacks)
(rewrite (Pushforward "complex bounded Bessel I" 2 0)
  (Binary "mul" (Bar) (BesselOrder "i" (Arg 0) (Arg 1))) :ruleset pullbacks)
(rewrite (Pushforward "complex bounded Bessel I" 2 1)
  (Pushforward "complex Bessel I" 2 1) :ruleset pullbacks)
(rewrite (Pullback "complex Bessel I" 2 1)
  (Binary "mul" (Bar) (Unary "conj" (BesselArgumentI))) :ruleset pullbacks)
(rewrite (Pullback "complex bounded Bessel I" 2 0)
  (Binary "mul" (Bar) (Unary "conj" (BesselOrder "i" (Arg 0) (Arg 1)))) :ruleset pullbacks)
(rewrite (Pullback "complex bounded Bessel I" 2 1)
  (Pullback "complex Bessel I" 2 1) :ruleset pullbacks)
(constructor BesselArgumentIscaled () Expr :unextractable)
(rewrite (BesselArgumentIscaled)
  (Ternary "ifelse" (Binary "land" (Unary "iszero" (Arg 0)) (Unary "iszero" (Arg 1)))
    (Binary "complex" (Unary "log" (Real -1.0)) (Unary "log" (Real -1.0)))
    (Binary "sub" (Binary "mul" (Real 0.5)
    (Binary "add"
      (SpecialBinary "bessel_i_scaled" (Binary "sub" (Arg 0) (Real 1.0)) (Arg 1))
      (SpecialBinary "bessel_i_scaled" (Binary "add" (Arg 0) (Real 1.0)) (Arg 1))))
      (Binary "mul" (Ternary "ifelse" (Unary "iszero" (Arg 1)) (Real 0.0)
        (Ternary "ifelse" (Binary "lt" (Arg 1) (Real 0.0)) (Real -1.0) (Real 1.0))) (Out))))
  :ruleset pullbacks)
(rewrite (Pushforward "complex scaled Bessel I" 2 1)
  (Binary "mul" (Bar) (BesselArgumentIscaled)) :ruleset pullbacks)
(rewrite (Pushforward "complex bounded scaled Bessel I" 2 0)
  (Binary "mul" (Bar) (BesselOrder "i-scaled" (Arg 0) (Arg 1))) :ruleset pullbacks)
(rewrite (Pushforward "complex bounded scaled Bessel I" 2 1)
  (Pushforward "complex scaled Bessel I" 2 1) :ruleset pullbacks)
(rewrite (Pullback "complex scaled Bessel I" 2 1)
  (Binary "mul" (Bar) (Unary "conj" (BesselArgumentIscaled))) :ruleset pullbacks)
(rewrite (Pullback "complex bounded scaled Bessel I" 2 0)
  (Binary "mul" (Bar) (Unary "conj" (BesselOrder "i-scaled" (Arg 0) (Arg 1)))) :ruleset pullbacks)
(rewrite (Pullback "complex bounded scaled Bessel I" 2 1)
  (Pullback "complex scaled Bessel I" 2 1) :ruleset pullbacks)
