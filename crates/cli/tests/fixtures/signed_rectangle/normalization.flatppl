theta = elementof(reals)
shift = elementof(reals)
amplitude = elementof(reals)
variation = elementof(reals)
hi = elementof(nonnegreals)
weight(x, p) = (p.shift + p.theta^2) + p.theta * p.amplitude * (1.0 + p.variation * (x[1] + x[2]))
support = cartprod(interval(0.0, hi), interval(0.0, 1.0))
parameters = record(theta = theta, shift = shift, amplitude = amplitude, variation = variation)
log_mass = log(totalmass(logweighted(weight, Lebesgue(support), parameters)))
inputs = (theta, shift, amplitude, variation, hi)
outputs = ifelse(hi > 0.0, log_mass, shift)
