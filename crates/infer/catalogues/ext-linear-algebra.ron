// Standard module: ext-linear-algebra (spec §09). Loaded by catalogue::builtin().
        Module(
            name: "ext-linear-algebra",
            version: "0.1",
            bindings: [
                // lu(A) → record(P, L, U): permutation, lower-tri, upper-tri —
                // L/U preserve complex elements and promote integer elements.
                Binding(name: "lu",
                    sig: Function(params: [Matrix], names: ["A"], result: Record([
                        ("P", MatrixElem(rows: Axis(0, 0), cols: Axis(0, 1), elem: Real)),
                        ("L", MatrixElem(rows: Axis(0, 0), cols: Axis(0, 1), elem: RealOrComplexOfArg(0))),
                        ("U", MatrixElem(rows: Axis(0, 0), cols: Axis(0, 1), elem: RealOrComplexOfArg(0))),
                    ]))),
                // svd(A) → record(U, S, V): U/V matrices (A's element kind); S is a
                // vector of non-negative REAL singular values (spec §09).
                Binding(name: "svd",
                    sig: Function(params: [Matrix], names: ["A"], result: Record([
                        ("U", MatrixElem(rows: Axis(0, 0), cols: Min(Axis(0, 0), Axis(0, 1)), elem: RealOrComplexOfArg(0))),
                        ("S", Vector(len: Min(Axis(0, 0), Axis(0, 1)), elem: Real)),
                        ("V", MatrixElem(rows: Axis(0, 1), cols: Min(Axis(0, 0), Axis(0, 1)), elem: RealOrComplexOfArg(0))),
                    ]))),
                // eigen(A) → record(values, vectors): values vector, vectors matrix.
                // A real matrix can have a complex spectrum, so both fields
                // have a complex codomain even when A is real.
                Binding(name: "eigen",
                    sig: Function(params: [Matrix], names: ["A"], result: Record([
                        ("values", Vector(len: Axis(0, 0), elem: Complex)),
                        ("vectors", MatrixElem(rows: Axis(0, 0), cols: Axis(0, 1), elem: Complex)),
                    ]))),
                // eigmax(A) → real (maximal eigenvalue, real-valued when A has real eigenvalues)
                Binding(name: "eigmax",
                    sig: Function(params: [Matrix], names: ["A"], result: Scalar(Real))),
                // eigmin(A) → real
                Binding(name: "eigmin",
                    sig: Function(params: [Matrix], names: ["A"], result: Scalar(Real))),
                // matexp(A) → matrix with the same shape as A (shape passes through).
                Binding(name: "matexp",
                    sig: Function(params: [Matrix], names: ["A"], result: RealOrComplexOfArgShape(0))),
                // kron(A, B): Kronecker product — (rows A · rows B) × (cols A · cols B),
                // element kind preserved (spec §09).
                Binding(name: "kron",
                    sig: Function(params: [Matrix, Matrix], names: ["A", "B"], result: MatrixElem(
                        rows: Mul(Axis(0, 0), Axis(1, 0)),
                        cols: Mul(Axis(0, 1), Axis(1, 1)),
                        elem: PromoteArgs([0, 1])))),
                Binding(name: "lstsq",
                    sig: Function(params: [Matrix, VectorOrMatrix, Optional(Scalar(Real)), Optional(Scalar(Real))], names: ["A", "b", "rtol", "atol"], result: RhsShape(rhs: 1, rows: Axis(0, 1), elem: RealOrComplexOfArgs([0, 1])))),
                Binding(name: "rank",
                    sig: Function(params: [Matrix, Optional(Scalar(Real)), Optional(Scalar(Real))], names: ["A", "rtol", "atol"], result: Scalar(Integer), result_set: NonNegIntegers)),
                Binding(name: "solve_triangular",
                    sig: Function(params: [Matrix, VectorOrMatrix, Optional(Scalar(Boolean)), Optional(Scalar(Boolean))], names: ["A", "b", "lower", "unit_diagonal"], result: RhsShape(rhs: 1, rows: Axis(0, 0), elem: RealOrComplexOfArgs([0, 1])))),
                Binding(name: "lu_solve",
                    sig: Function(params: [Any, VectorOrMatrix], names: ["factors", "b"], result: RhsShape(rhs: 1, rows: Axis(1, 0), elem: RealOrComplexOfArgs([0, 1])))),
                Binding(name: "cholesky_solve",
                    sig: Function(params: [Matrix, VectorOrMatrix], names: ["L", "b"], result: RhsShape(rhs: 1, rows: Axis(0, 0), elem: RealOrComplexOfArgs([0, 1])))),
                Binding(name: "eigh",
                    sig: Function(params: [Matrix], names: ["A"], result: Record([
                        ("values", Vector(len: Axis(0, 0), elem: Real)),
                        ("vectors", MatrixElem(rows: Axis(0, 0), cols: Axis(0, 1), elem: RealOrComplexOfArg(0))),
                    ]))),
                Binding(name: "eigvalsh",
                    sig: Function(params: [Matrix], names: ["A"], result: Vector(len: Axis(0, 0), elem: Real))),
                Binding(name: "pinv",
                    sig: Function(params: [Matrix, Optional(Scalar(Real)), Optional(Scalar(Real))], names: ["A", "rtol", "atol"], result: MatrixElem(rows: Axis(0, 1), cols: Axis(0, 0), elem: RealOrComplexOfArg(0)))),
                Binding(name: "cond",
                    sig: Function(params: [Matrix], names: ["A"], result: Scalar(Real))),
            ]
)
