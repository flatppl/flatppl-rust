// pyhf interpolation helpers. See the portable definitions in determinizer.
Module(
    name: "pyhf_helpers",
    version: "0.1",
    bindings: [
        Binding(name: "normsys_factor", sig: Function(
            params: [Scalar(Real), Scalar(Real), Scalar(Real)],
            names: ["lo", "hi", "alpha"],
            param_sets: [PosReals, PosReals, Reals],
            result: Scalar(Real),
        )),
        Binding(name: "histosys_shift", sig: Function(
            params: [Scalar(Real), Scalar(Real), Scalar(Real), Scalar(Real)],
            names: ["lo", "nominal", "hi", "alpha"],
            param_sets: [Reals, Reals, Reals, Reals],
            result: Scalar(Real),
        )),
    ],
)
