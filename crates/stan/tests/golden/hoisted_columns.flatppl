flatppl_compat = "0.1"
N = 5
K = 4
work = [1, 2, 3, 2, 4]
Z = rowstack([[1.0, 2.0, 0.5, 0.1], [0.0, 1.5, 2.5, 0.2], [2.0, 0.5, 1.0, 0.3], [1.0, 1.0, 1.0, 0.4], [0.5, 0.5, 0.5, 0.5]])
y_obs = [1.2, 0.4, 2.2, 1.1, 0.7]
X = colstack([ones(N), ifelse.(work .== 2, 1.0, 0.0), ifelse.(work .== 3, 1.0, 0.0)])
W = Z[:, indicesof(zeros(K - 1)) .+ 1]
beta ~ iid(Normal(0, 1), 3)
gamma ~ iid(Normal(0, 1), 3)
sigma ~ Exponential(1.0)
y ~ Normal.(X * beta .+ W * gamma, sigma)
prior = lawof(record(beta = beta, gamma = gamma, sigma = sigma))
L = likelihoodof(kernelof(record(y = y), beta = beta, gamma = gamma, sigma = sigma), record(y = y_obs))
post = bayesupdate(L, prior)
