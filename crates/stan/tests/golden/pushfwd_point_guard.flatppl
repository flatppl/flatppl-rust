# emit: target=outputs
flatppl_compat = "0.1"
mu ~ Normal(0, 1)
sigma ~ pushfwd(fn(sqrt(_)), InverseGamma(5, 5))
rho ~ pushfwd(fn(exp(_)), Normal(0.3, 0.8))
z ~ Normal(mu, 1)
prior = lawof(record(mu = mu, sigma = sigma, rho = rho))
L = likelihoodof(kernelof(record(z = z), mu = mu, sigma = sigma, rho = rho), record(z = 0.4))
post = bayesupdate(L, prior)
m = elementof(reals)
s = elementof(reals)
r = elementof(reals)
inputs = (m, s, r)
outputs = logdensityof(post, record(mu = m, sigma = s, rho = r))
