# emit: target=likelihood
flatppl_compat = "0.1"
hep = standard_module("particle-physics", "0.1")
mu = elementof(posreals)
nominal = [10.0, 20.0, 5.0]
observed = [12.0, 18.5, 0.0]
expected = mu .* nominal
model = functionof(hep.ContinuedPoisson.(expected))
likelihood = likelihoodof(model, observed)
