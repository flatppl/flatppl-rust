flatppl_compat = "0.1"
hep = standard_module("particle-physics", "0.1")
y_obs = [5.270, 5.281, 5.274, 5.262, 5.279, 5.255]
s ~ Exponential(rate = 200.0)
y ~ iid(hep.CrystalBall(m0 = 5.279, sigma = s, alpha = 1.5, n = 3.0), 6)
prior = lawof(record(s = s))
L = likelihoodof(kernelof(record(y = y), s = s), record(y = y_obs))
post = bayesupdate(L, prior)
