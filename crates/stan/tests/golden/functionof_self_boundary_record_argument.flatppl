flatppl_compat = "0.1"
rv = elementof(cartprod(a = reals, b = reals))
s = rv.a + 2 * rv.b
g = functionof(s, r = rv)
mu ~ Normal(0, 1)
y ~ Normal(g(record(a = mu, b = 1.0)), 1)
prior = lawof(record(mu = mu))
L = likelihoodof(kernelof(record(y = y), mu = mu), record(y = 0.5))
post = bayesupdate(L, prior)
