flatppl_compat = "0.1"
reg = standard_module("regression", "0.1")
x = rowstack([[1.0, 0.5], [0.2, -0.3], [0.7, 1.1]])
a ~ iid(Normal(0, 1), 2)
beta ~ iid(Normal(0, 1), 2)
y ~ reg.NormalGLM.([x, x], a, [beta, beta], 1.0)
prior = lawof(record(a = a, beta = beta))
L = likelihoodof(kernelof(record(y = y), a = a, beta = beta), record(y = [[0, 1, 2], [1, 0, 3]]))
post = bayesupdate(L, prior)
