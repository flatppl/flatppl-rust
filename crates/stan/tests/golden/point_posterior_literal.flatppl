# emit: target=lp
flatppl_compat = "0.1"
mu ~ Normal(0, 2)
s ~ normalize(truncate(Normal(0, 1), interval(0.0, inf)))
w ~ iid(Normal(0, 1), 2)
y_obs = [0.3, -0.4, 1.1]
y ~ iid(Normal(mu + w[1] - w[2], s), 3)
L = likelihoodof(kernelof(record(y = y), mu = mu, s = s, w = w), record(y = y_obs))
prior = lawof(record(mu = mu, s = s, w = w))
post = bayesupdate(L, prior)
lp = logdensityof(post, record(mu = 0.5, s = 1.2, w = [0.1, -0.2]))
