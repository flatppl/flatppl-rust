flatppl_compat = "0.1"
x = [0.5, 1.0, 2.0, 3.5]
y_obs = [0.2, 0.9, 2.4, 3.1]
weights = ifelse.(x .> 1.5, 2.0, 1.0)
lower ~ Normal(0, 1)
offset ~ Exponential(1.0)
y ~ Normal.(lower .+ x, offset .* weights)
prior = lawof(record(lower = lower, offset = offset))
L = likelihoodof(kernelof(record(y = y), lower = lower, offset = offset), record(y = y_obs))
post = bayesupdate(L, prior)
