flatppl_compat = "0.1"
y_obs = [-0.5, 1.0, 4.0]
mu ~ Normal(0, 1)
r ~ Exponential(1)
mixture = normalize(superpose(weighted(0.4, Normal(mu, 1.0)), weighted(0.6, normalize(truncate(Exponential(r), interval(-1.0, 3.0))))))
y ~ iid(mixture, 3)
prior = lawof(record(mu = mu, r = r))
L = likelihoodof(kernelof(record(y = y), mu = mu, r = r), record(y = y_obs))
post = bayesupdate(L, prior)
