# emit: target=outputs
flatppl_compat = "0.1"
mu = elementof(reals)
sg = elementof(posreals)
L1 = likelihoodof(Normal(mu, 1.0), 0.5)
L2 = likelihoodof(Normal(0.0, sg), 1.2)
L = joint_likelihood(L1, L2)
t = elementof(reals)
s = elementof(posreals)
inputs = (t, s)
outputs = logdensityof(L, record(mu = t, sg = s))
