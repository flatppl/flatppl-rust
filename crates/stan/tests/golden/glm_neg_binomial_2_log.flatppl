flatppl_compat = "0.1"
reg = standard_module("regression", "0.1")
x = rowstack([[1.0, 0.5], [0.2, -0.3], [0.7, 1.1]])
alpha ~ Normal(0, 1)
beta ~ iid(Normal(0, 1), 2)
psi ~ Exponential(1)
y ~ reg.NegativeBinomial2LogGLM(x, alpha, beta, psi)
prior = lawof(record(alpha = alpha, beta = beta, psi = psi))
L = likelihoodof(kernelof(record(y = y), alpha = alpha, beta = beta, psi = psi), record(y = [0, 3, 7]))
post = bayesupdate(L, prior)
