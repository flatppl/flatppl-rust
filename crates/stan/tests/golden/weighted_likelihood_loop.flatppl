# emit: target=post
flatppl_compat = "0.1"
x = [0.5, -1.0, 2.0, 0.3]
y_data = [1.1, -0.4, 2.7, 0.9]
w_data = [1.0, 0.5, 0.0, 2.0]
a ~ Normal(0, 2)
sigma ~ Exponential(1)
mu = a .+ x
prior = lawof(record(a = a, sigma = sigma))
log_lik = functionof(((m, v, s) -> logdensityof(Normal(m, s), v)).(mu, y_data, sigma), a = a, sigma = sigma)
post = logweighted(point -> sum(w_data .* log_lik(a = point.a, sigma = point.sigma)), prior)
