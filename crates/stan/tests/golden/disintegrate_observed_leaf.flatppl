flatppl_compat = "0.1"
theta1 ~ Normal(0, 1)
theta2 ~ Gamma(2, 1)
obs ~ iid(Normal(theta1, theta2), 5)
J = lawof(record(theta1 = theta1, theta2 = theta2, obs = obs))
K, prior = disintegrate(["obs"], J)
obs_data = [1.2, 0.4, 2.1, 0.8, 1.5]
L = likelihoodof(K, record(obs = obs_data))
post = bayesupdate(L, prior)
