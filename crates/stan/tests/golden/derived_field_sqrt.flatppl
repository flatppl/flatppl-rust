flatppl_compat = "0.1"
x_data = [1.1, 1.5, 1.3, 1.4]
y_data = [3.2, 4.1, 3.4, 3.9]
sigma_sq ~ InverseGamma(5, 5)
sigma = sqrt(sigma_sq)
alpha ~ Normal(0, sigma * 3)
beta ~ Normal(0, sigma_sq)
prior = lawof(record(alpha = alpha, beta = beta, sigma = sigma))
y ~ Normal.(alpha .+ beta .* x_data, sigma)
L = likelihoodof(kernelof(record(y = y), alpha = alpha, beta = beta, sigma = sigma), record(y = y_data))
post = bayesupdate(L, prior)
