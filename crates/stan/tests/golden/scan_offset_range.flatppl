flatppl_compat = "0.1"
T = 5
y_obs = [0.3, -0.2, 0.5, 0.1, -0.4]
mu ~ Normal(0, 1)
step(acc, t, p) = 0.5 * acc + y_obs[t] - p.mu
run = scan(step, 0.0, indicesof(zeros(T - 1)) .+ 1, record(mu = mu))
z ~ Normal(sum(run), 1)
rstep(s, t, p) = record(a = s.a + y_obs[t] * p.mu, b = s.a - y_obs[t])
rows = scan(rstep, record(a = 0.0, b = 0.0), indicesof(zeros(T - 1)) .+ 1, record(mu = mu))
row_b(r) = r.b
w ~ Normal.(row_b.(rows), 1)
prior = lawof(record(mu = mu))
L = likelihoodof(kernelof(record(z = z, w = w), mu = mu), record(z = 0.4, w = [0.1, -0.3, 0.2, 0.0]))
post = bayesupdate(L, prior)
