flatppl_compat = "0.1"
k = [1, 3, 2]
x_obs = [0.5, 1.5, 2.5]
kk = addaxes(k, 0, 1)
mu ~ Normal(0, 1)
y ~ Normal(mu + x_obs[kk[2, 1]], 1)
n ~ Binomial(kk[1, 1] + 4, 0.3)
prior = lawof(record(mu = mu))
L = likelihoodof(kernelof(record(y = y, n = n), mu = mu), record(y = 0.4, n = 2))
post = bayesupdate(L, prior)
