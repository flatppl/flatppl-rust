# emit: target=post
flatppl_compat = "0.1"
y_obs = [3, 0, 2, 0, 0, 5]
lam ~ Gamma(2.0, 1.0)
ZIP = superpose(weighted(0.25, Dirac(0)), weighted(0.75, Poisson(lam)))
y ~ iid(ZIP, 6)
prior = lawof(record(lam = lam))
post = bayesupdate(likelihoodof(kernelof(record(y = y), lam = lam), record(y = y_obs)), prior)
