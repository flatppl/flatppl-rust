# emit: module=modules/sizes.flatppl
flatppl_compat = "0.1"
m = load_module("modules/sizes.flatppl")
eta ~ Exponential(1)
R ~ LKJ(m.dim, eta)
prior = lawof(record(eta = eta))
post = bayesupdate(likelihoodof(kernelof(record(R = R), eta = eta), record(R = rowstack([[1.0, 0.2, 0.0, 0.1], [0.2, 1.0, 0.3, 0.0], [0.0, 0.3, 1.0, 0.2], [0.1, 0.0, 0.2, 1.0]]))), prior)
