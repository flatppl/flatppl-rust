flatppl_compat = "0.1"
x = [0.5, -1.0, 2.0]
mu ~ Normal(0, 1)
b = elementof(cartpow(reals, 2))
c = elementof(cartpow(posreals, 1))
Pi_improper = joint(b = iid(Lebesgue(reals), 2), c = iid(Lebesgue(posreals), 1))
Pi_prior = joint(Pi_improper, lawof(record(mu = mu)))
y ~ Normal.(mu .+ b[1] .* x .+ b[2], c[1])
K_model = kernelof(record(y = y), mu = mu, b = b, c = c)
L = likelihoodof(K_model, record(y = [0.3, -0.8, 1.9]))
Pi_post = bayesupdate(L, Pi_prior)
