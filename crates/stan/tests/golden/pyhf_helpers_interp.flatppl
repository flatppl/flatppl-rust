# emit: target=L
flatppl_compat = "0.1"
pyhf = standard_module("pyhf-helpers", "0.1")
alpha = elementof(reals)
beta = elementof(reals)
nf = pyhf.normsys_factor(0.9, 1.15, alpha)
hs = pyhf.histosys_shift(46.0, 50.0, 56.0, alpha)
nfv = pyhf.normsys_factor.([0.9, 0.8], [1.15, 1.3], [alpha, beta])
hsm = pyhf.histosys_shift.(
  rowstack([[46.0, 90.0], [5.0, 4.0]]),
  rowstack([[50.0, 100.0], [4.0, 4.5]]),
  rowstack([[56.0, 120.0], [2.5, 6.0]]),
  addaxes([alpha, beta], 0, 1),
)
hsv = pyhf.histosys_shift.(46.0, [50.0, 52.0], 56.0, [alpha, beta])
L = likelihoodof(
  functionof(Normal.(cat([nf, hs], nfv, hsm[1, :], hsm[2, :], hsv), 1.0)),
  [1.0, 2.0, 1.0, 1.1, 1.5, 3.0, -0.2, 0.4, 2.5, -1.5],
)
