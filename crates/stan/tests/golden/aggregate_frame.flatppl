flatppl_compat = "0.1"
I = 3
J = 4
y_obs = rowstack([[1, 0, 1, 1], [0, 0, 1, 0], [1, 1, 1, 0]])
sigma ~ Exponential(1.0)
theta ~ iid(Normal(0, sigma), J)
a ~ iid(LogNormal(0, 1), I)
b ~ iid(Normal(0, 1), I)
log_odds = aggregate(sum, [.i, .j], a[.i] * (theta[.j] - b[.i]))
y ~ Bernoulli.(invlogit.(log_odds))
prior = lawof(record(sigma = sigma, theta = theta, a = a, b = b))
L = likelihoodof(kernelof(record(y = y), sigma = sigma, theta = theta, a = a, b = b), record(y = y_obs))
post = bayesupdate(L, prior)
