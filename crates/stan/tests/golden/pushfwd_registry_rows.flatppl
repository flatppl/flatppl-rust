flatppl_compat = "0.1"
v_exp ~ pushfwd(fn(exp(_)), Normal(0.3, 0.8))
v_log ~ pushfwd(fn(log(_)), Gamma(3, 2))
v_log10 ~ pushfwd(fn(log10(_)), Gamma(3, 2))
v_log1p ~ pushfwd(fn(log1p(_)), Exponential(1.5))
v_expm1 ~ pushfwd(fn(expm1(_)), Normal(0.2, 0.7))
v_logit ~ pushfwd(fn(logit(_)), Beta(2, 3))
v_invlogit ~ pushfwd(fn(invlogit(_)), Normal(0.1, 1.2))
v_probit ~ pushfwd(fn(probit(_)), Beta(2, 3))
v_invprobit ~ pushfwd(fn(invprobit(_)), Normal(0.1, 0.9))
v_atan ~ pushfwd(fn(atan(_)), Normal(0.2, 1.5))
v_sinh ~ pushfwd(fn(sinh(_)), Normal(0.1, 0.8))
v_asinh ~ pushfwd(fn(asinh(_)), Normal(0.4, 2.0))
v_tanh ~ pushfwd(fn(tanh(_)), Normal(0.1, 0.6))
v_pow3 ~ pushfwd(fn(pow(_, 3)), Normal(0.2, 1.0))
v_pow5 ~ pushfwd(fn(pow(_, 5)), Normal(0.2, 1.0))
v_pow1p5 ~ pushfwd(fn(pow(_, 1.5)), Gamma(3, 2))
v_powmhalf ~ pushfwd(fn(pow(_, -0.5)), Gamma(3, 2))
z ~ Normal(v_exp, 1)
prior = lawof(record(v_exp = v_exp, v_log = v_log, v_log10 = v_log10, v_log1p = v_log1p, v_expm1 = v_expm1, v_logit = v_logit, v_invlogit = v_invlogit, v_probit = v_probit, v_invprobit = v_invprobit, v_atan = v_atan, v_sinh = v_sinh, v_asinh = v_asinh, v_tanh = v_tanh, v_pow3 = v_pow3, v_pow5 = v_pow5, v_pow1p5 = v_pow1p5, v_powmhalf = v_powmhalf))
L = likelihoodof(kernelof(record(z = z), v_exp = v_exp, v_log = v_log, v_log10 = v_log10, v_log1p = v_log1p, v_expm1 = v_expm1, v_logit = v_logit, v_invlogit = v_invlogit, v_probit = v_probit, v_invprobit = v_invprobit, v_atan = v_atan, v_sinh = v_sinh, v_asinh = v_asinh, v_tanh = v_tanh, v_pow3 = v_pow3, v_pow5 = v_pow5, v_pow1p5 = v_pow1p5, v_powmhalf = v_powmhalf), record(z = 0.4))
post = bayesupdate(L, prior)
