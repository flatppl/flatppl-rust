# emit: target=post
flatppl_compat = "0.1"
A = rowstack([[1.0, 2.0], [0.5, -1.0], [0.3, 0.3]])
w ~ iid(iid(Normal(0, 1), 2), 2)
prior = lawof(record(w = w))
rows(x) = sum(aggregate(sum, [.t], (A * transpose(rowstack(x.w)))[.t, .k]^2))
cols(x) = sum(aggregate(sum, [.k], (A * transpose(rowstack(x.w)))[.t, .k]^2) .* [1.0, 2.0])
lw(x) = rows(x) - 0.5 * cols(x)
post = logweighted(lw, prior)
