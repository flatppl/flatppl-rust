flatppl_compat = "0.1"
J = 3
counts = [[0, 0, 0], [1, 0, 2], [4, 1, 1]]
w ~ Beta(2, 2)
q ~ Beta(1, 3)
lam ~ Exponential(1)
site(q, lam) = normalize(superpose(weighted(q, Dirac(0)), weighted(1 - q, Poisson(lam))))
y ~ iid(normalize(superpose(weighted(w, Dirac(fill(0, J))), weighted(1 - w, iid(site(q, lam), J)))), 3)
prior = lawof(record(w = w, q = q, lam = lam))
L = likelihoodof(kernelof(record(y = y), w = w, q = q, lam = lam), record(y = counts))
post = bayesupdate(L, prior)
