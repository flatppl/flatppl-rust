flatppl_compat = "0.1"
reg = standard_module("regression", "0.1")
x = rowstack([[1.0, 0.5], [0.2, -0.3], [0.7, 1.1]])
cutpoints = [-1, 1]
beta ~ iid(Normal(0, 1), 2)
y ~ reg.OrderedLogitGLM(x, beta, cutpoints)
prior = lawof(record(beta = beta))
L = likelihoodof(kernelof(record(y = y), beta = beta), record(y = [1, 3, 2]))
post = bayesupdate(L, prior)
