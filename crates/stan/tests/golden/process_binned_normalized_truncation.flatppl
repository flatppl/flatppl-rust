# emit: target=lp
flatppl_compat = "0.1"
mu = elementof(reals)
sigma = elementof(posreals)
edge = elementof(posreals)
intensity = weighted(5.0, normalize(truncate(Normal(mu, sigma), interval(-0.5, edge))))
lp = logdensityof(BinnedPoissonProcess([-2, -1, 0, 1], intensity), [0, 0, 2])
inputs = (mu, sigma, edge)
outputs = lp
