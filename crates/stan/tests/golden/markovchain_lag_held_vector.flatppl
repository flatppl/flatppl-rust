# emit: target=post
flatppl_compat = "0.1"
x_data = [0.4, 0.9, 1.1, 1.8]
w ~ iid(Normal(0.0, 1.0), 2)
step(prev, v) = Normal(v[1] * prev + v[2], 0.7)
x ~ markovchain(step, 0.3, 4, w)
prior = lawof(record(w = w))
post = bayesupdate(likelihoodof(kernelof(record(x = x), w = w), record(x = x_data)), prior)
