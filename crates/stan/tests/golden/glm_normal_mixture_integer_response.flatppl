flatppl_compat = "0.1"
reg = standard_module("regression", "0.1")
x = rowstack([[1.0, 0.5], [0.2, -0.3], [0.7, 1.1]])
w ~ Beta(2, 2)
beta ~ iid(Normal(0, 1), 2)
y ~ normalize(superpose(weighted(w, reg.NormalGLM(x, 0.0, beta, 1.0)), weighted(1 - w, reg.NormalGLM(x, 1.0, beta, 2.0))))
prior = lawof(record(w = w, beta = beta))
L = likelihoodof(kernelof(record(y = y), w = w, beta = beta), record(y = [0, 1, 2]))
post = bayesupdate(L, prior)
