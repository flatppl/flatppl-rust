flatppl_compat = "0.1"
reg = standard_module("regression", "0.1")
x = rowstack([[1.0, 0.5], [0.2, -0.3], [0.7, 1.1]])
alpha ~ Normal(0, 1)
beta ~ iid(Normal(0, 1), 2)
shape ~ Exponential(1)
y ~ reg.GammaLogGLM(x, alpha, beta, shape)
prior = lawof(record(alpha = alpha, beta = beta, shape = shape))
L = likelihoodof(kernelof(record(y = y), alpha = alpha, beta = beta, shape = shape), record(y = [0.5, 1.3, 2.2]))
post = bayesupdate(L, prior)
