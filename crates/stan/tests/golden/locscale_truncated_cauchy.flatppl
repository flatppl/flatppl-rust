flatppl_compat = "0.1"
temp_Intercept ~ Normal(1, 3)
sigma ~ locscale(normalize(truncate(Cauchy(0.0, 1.0), interval((0.0 - temp_Intercept) / 1.7, inf))), temp_Intercept, 1.7)
z ~ Normal(temp_Intercept, sigma)
prior = lawof(record(temp_Intercept = temp_Intercept, sigma = sigma))
L = likelihoodof(kernelof(record(z = z), temp_Intercept = temp_Intercept, sigma = sigma), record(z = 0.4))
post = bayesupdate(L, prior)
