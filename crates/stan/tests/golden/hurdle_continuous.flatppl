flatppl_compat = "0.1"
x = [0.2, -0.5, 1.0, 0.0, 0.7]
y_obs = [0.0, 1.3, 0.0, 0.4, 2.2]
hu ~ Beta(2, 2)
shape ~ Gamma(2, 1)
b ~ Normal(0, 1)
response_law = (mu, shape, hu) -> normalize(superpose(weighted(hu, Dirac(0.0)), weighted(1.0 - hu, Gamma(shape, shape / mu))))
y ~ response_law.(exp.(b .* x), shape, hu)
prior = lawof(record(hu = hu, shape = shape, b = b))
L = likelihoodof(kernelof(record(y = y), hu = hu, shape = shape, b = b), record(y = y_obs))
post = bayesupdate(L, prior)
