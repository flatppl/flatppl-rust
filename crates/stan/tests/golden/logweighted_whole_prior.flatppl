flatppl_compat = "0.1"
M = 3
y_obs = [2.1, 3.5, 2.9]
kappa ~ normalize(truncate(Normal(0, 0.5), interval(0, inf)))
mu = elementof(cartpow(posreals, M))
proper = lawof(record(kappa = kappa))
mu_weight(x) = sum(logdensityof.(Normal(3.28, x.kappa), x.mu))
prior = logweighted(mu_weight, joint(proper, Lebesgue(cartprod(mu = cartpow(posreals, M)))))
y ~ Normal.(mu, 1.0)
L = likelihoodof(kernelof(record(y = y), kappa = kappa, mu = mu), record(y = y_obs))
post = bayesupdate(L, prior)
