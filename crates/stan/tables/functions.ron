    (id: "minimum", flatppl: "minimum", module: None, args: ["xs"], kind: "builtin", stan: "min({xs})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "median", flatppl: "median", module: None, args: ["xs"], kind: "builtin", stan: "quantile({xs}, 0.5)", functions: "", data_only: true, vectorized: false, broadcast: "",
     caveat: "Data-only.", status: "verified"),
    (id: "quantile", flatppl: "quantile", module: None, args: ["xs", "p"], kind: "builtin", stan: "quantile({xs}, {p})", functions: "", data_only: true, vectorized: false, broadcast: "",
     caveat: "Hyndman-Fan type 7, as §07. Data-only.", status: "verified"),
    (id: "lengthof", flatppl: "lengthof", module: None, args: ["x"], kind: "builtin", stan: "num_elements({x})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Vectors. Arrays: size. Tables: rows of the column vectors.", status: "verified"),
    (id: "sizeof", flatppl: "sizeof", module: None, args: ["x"], kind: "builtin", stan: "dims({x})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Matrices and arrays. Stan dims(vector[n]) returns {n, 1} (measured, CmdStan 2.40); for a vector emit {num_elements({x})}.", status: "verified"),
    (id: "indicesof", flatppl: "indicesof", module: None, args: ["x"], kind: "builtin", stan: "linspaced_int_array(num_elements({x}), 1, num_elements({x}))", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Vectors only.", status: "verified"),
    (id: "indicesof0", flatppl: "indicesof0", module: None, args: ["x"], kind: "builtin", stan: "linspaced_int_array(num_elements({x}), 0, num_elements({x}) - 1)", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Vectors only.", status: "verified"),

    // ------------------------------------------------------------ cumulative
    (id: "cumsum", flatppl: "cumsum", module: None, args: ["xs"], kind: "builtin", stan: "cumulative_sum({xs})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "cumprod", flatppl: "cumprod", module: None, args: ["xs"], kind: "helper", stan: "flatppl_cumprod({xs})",
     functions: "vector flatppl_cumprod(vector x) {
  vector[num_elements(x)] r;
  real acc = 1;
  for (i in 1:num_elements(x)) {
    acc *= x[i];
    r[i] = acc;
  }
  return r;
}",
     data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "cummax", flatppl: "cummax", module: None, args: ["xs"], kind: "helper", stan: "flatppl_cummax({xs})",
     functions: "vector flatppl_cummax(vector x) {
  vector[num_elements(x)] r;
  for (i in 1:num_elements(x)) {
    if (i == 1) r[i] = x[i];
    else r[i] = fmax(r[i - 1], x[i]);
  }
  return r;
}",
     data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "cummin", flatppl: "cummin", module: None, args: ["xs"], kind: "helper", stan: "flatppl_cummin({xs})",
     functions: "vector flatppl_cummin(vector x) {
  vector[num_elements(x)] r;
  for (i in 1:num_elements(x)) {
    if (i == 1) r[i] = x[i];
    else r[i] = fmin(r[i - 1], x[i]);
  }
  return r;
}",
     data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),

    // ------------------------------------------------------------ norms
