     caveat: "Stan order v must be int. Vectorized over z only; v stays a scalar int.", status: "verified"),
    (id: "bessel_i", flatppl: "bessel_i", module: Some("special-functions 0.1"), args: ["v", "z"], kind: "builtin", stan: "modified_bessel_first_kind({v}, {z})", functions: "", data_only: false, vectorized: true, broadcast: "",
     caveat: "Stan order v must be int. Real order: exp(log_modified_bessel_first_kind(v, z)) for z > 0. Vectorized over z only; v stays a scalar int.", status: "verified"),
    (id: "bessel_k", flatppl: "bessel_k", module: Some("special-functions 0.1"), args: ["v", "z"], kind: "builtin", stan: "modified_bessel_second_kind({v}, {z})", functions: "", data_only: false, vectorized: true, broadcast: "",
     caveat: "Stan order v must be int. Vectorized over z only; v stays a scalar int.", status: "verified"),
    (id: "digamma", flatppl: "digamma", module: Some("special-functions 0.1"), args: ["x"], kind: "builtin", stan: "digamma({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "polygamma", flatppl: "polygamma", module: Some("special-functions 0.1"), args: ["n", "x"], kind: "builtin", stan: "trigamma({x})", functions: "", data_only: false, vectorized: true, broadcast: "",
     caveat: "Template is for n = 1. n = 0: digamma({x}). n >= 2: none. Vectorized over x; n stays scalar.",
     status: "unverified: Stan trigamma misses 1e-12: trigamma(2.5) = 0.4903577556088261 vs exact 0.4903577561002349 (rel. 1.0e-9); trigamma(0.1) rel. 1.1e-11"),
    (id: "gammainc", flatppl: "gammainc", module: Some("special-functions 0.1"), args: ["a", "x"], kind: "builtin", stan: "gamma_p({a}, {x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
