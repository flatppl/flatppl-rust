// FlatPPL function -> Stan expression mapping.
// Sources: flatppl-design docs/07-functions.md and docs/09-standard-modules.md at eed1724;
// Stan Functions Reference 2.40; CmdStan 2.40.0 stanc signature dump.
//
// Schema: a list of rows. Every field is present in every row.
//   id:        unique row key (verify.py keys its test points and references on it).
//   flatppl:   FlatPPL function name.
//   module:    None for §07, Some("<module> <version>") for a standard-module function.
//   args:      FlatPPL argument names in spec order.
//   kind:      "builtin"   a Stan function call; the template states any reorder.
//              "operator"  a Stan operator expression.
//              "helper"    calls a function defined in the `functions` field.
//              "construct" a structural mapping (indexing, blocks, declarations); no numeric check.
//              "todo"      no form yet, but a loop or helper can express it: the emitter refuses with
//                          not-yet. `caveat` states the intended Stan shape.
//              "none"      Stan has no form and no helper can give one: the emitter refuses for good.
//                          `caveat` states the reason.
//   stan:      Stan expression template. Each {arg} is substituted with an atomic Stan expression.
//   functions: Stan functions-block source the template needs ("" if none).
//   data_only: Stan requires data-only arguments (no parameters).
//   vectorized: the template applies elementwise when its scalar arguments are vectors (and
//              row_vectors), so broadcast(f, x) emits the template with x itself. Binary rows
//              accept vector-vector, vector-scalar and scalar-vector. Integer-order arguments
//              (Bessel v) stay scalar. Checked numerically by verify.py against the elementwise loop.
//   broadcast: template of the elementwise (broadcast) form when it differs from `stan`, else "".
//              Emitting broadcast(f, args): vectorized true -> emit `stan` with the vector arguments
//              themselves; broadcast non-empty -> emit `broadcast`; vectorized false and broadcast ""
//              -> the emitter loops (or refuses). Non-empty only for mul (.*), divide (./), pow (.^).
//              Checked numerically by verify.py (vector-vector, vector-scalar, scalar-vector).
//   caveat:    where Stan semantics differ from the spec, and what the template does about it.
//   status:    "verified" (verify.py PASS, Stan 2.40.0) | "unverified: <reason>" | "n/a".
[
    // ------------------------------------------------------------ identities and generation
    (id: "identity", flatppl: "identity", module: None, args: ["x"], kind: "operator", stan: "{x}", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "vector", flatppl: "vector", module: None, args: ["x1", "..."], kind: "construct", stan: "[{x1}, ...]'", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Row-vector literal, transposed. Use {...} for an int array.", status: "n/a"),
    (id: "array", flatppl: "array", module: None, args: ["data", "size", "dimorder"], kind: "construct", stan: "to_matrix({data}, {m}, {n})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Rank 2 only. to_matrix fills column-major; pass a 4th argument 0 for row-major. Rank > 2: none.", status: "n/a"),
    (id: "fill", flatppl: "fill", module: None, args: ["x", "size"], kind: "builtin", stan: "rep_vector({x}, {size})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Template is for an integer size. size [m, n]: rep_matrix({x}, m, n). Higher rank: rep_array.", status: "verified"),
    (id: "zeros", flatppl: "zeros", module: None, args: ["size"], kind: "builtin", stan: "zeros_vector({size})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Integer size. size [m, n]: rep_matrix(0, m, n).", status: "verified"),
    (id: "ones", flatppl: "ones", module: None, args: ["size"], kind: "builtin", stan: "ones_vector({size})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Integer size. size [m, n]: rep_matrix(1, m, n).", status: "verified"),
    (id: "eye", flatppl: "eye", module: None, args: ["n"], kind: "builtin", stan: "identity_matrix({n})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "onehot", flatppl: "onehot", module: None, args: ["i", "n"], kind: "builtin", stan: "one_hot_vector({n}, {i})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Argument order swaps.", status: "verified"),
    (id: "linspace", flatppl: "linspace", module: None, args: ["from", "to", "n"], kind: "builtin", stan: "linspaced_vector({n}, {from}, {to})", functions: "", data_only: true, vectorized: false, broadcast: "",
     caveat: "Argument order changes: n comes first. The bounds must be data.", status: "verified"),
    (id: "extlinspace", flatppl: "extlinspace", module: None, args: ["from", "to", "n"], kind: "builtin",
     stan: "append_row(negative_infinity(), append_row(linspaced_vector({n}, {from}, {to}), positive_infinity()))", functions: "", data_only: true, vectorized: false, broadcast: "",
     caveat: "The bounds must be data.", status: "verified"),
    (id: "load_data", flatppl: "load_data", module: None, args: ["source", "valueset"], kind: "construct", stan: "data block declaration", functions: "", data_only: true, vectorized: false, broadcast: "",
     caveat: "The value goes to the Stan data file.", status: "n/a"),

    // ------------------------------------------------------------ access and array operations
    (id: "get", flatppl: "get", module: None, args: ["container", "selectors"], kind: "construct", stan: "{container}[{selectors}]", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "1-based in both. Record fields become tuple slots (.1, .2) or separate variables.", status: "n/a"),
    (id: "get0", flatppl: "get0", module: None, args: ["container", "selectors"], kind: "construct", stan: "{container}[{selectors} + 1]", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "n/a"),
    (id: "cat", flatppl: "cat", module: None, args: ["x", "y"], kind: "builtin", stan: "append_row({x}, {y})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Template is for vectors. Arrays: append_array. Records: no form.", status: "verified"),
    (id: "rowstack", flatppl: "rowstack", module: None, args: ["vs"], kind: "builtin", stan: "to_matrix({vs})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "vs must be an array[] row_vector.", status: "verified"),
    (id: "colstack", flatppl: "colstack", module: None, args: ["vs"], kind: "builtin", stan: "to_matrix({vs})'", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "vs must be an array[] row_vector.", status: "verified"),
    (id: "tile", flatppl: "tile", module: None, args: ["A", "size"], kind: "todo", stan: "", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Helper: matrix flatppl_tile(matrix A, int r, int c) with block assignments; a vector tiles with rep_matrix / append_row.", status: "n/a"),
    (id: "splitblocks", flatppl: "splitblocks", module: None, args: ["A", "blocksize"], kind: "todo", stan: "", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "The emitter handles the call before this table lookup, for rows only: splitblocks(A, [1, n]) is A as an observed value, and row A[i] (row_vector) as the argument of a broadcast user law in a Dirac-mixture row split. A plain broadcast law over the rows and other block shapes refuse; their form would be a helper returning array[,] matrix, each block(A, i, j, p, q).", status: "n/a"),
    (id: "joinblocks", flatppl: "joinblocks", module: None, args: ["A"], kind: "todo", stan: "", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Helper assigning each block into a matrix of the joined size.", status: "n/a"),
    (id: "partition", flatppl: "partition", module: None, args: ["xs", "spec"], kind: "todo", stan: "", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Equal parts: helper returning array[] vector built from segment(). Unequal parts: one segment(xs, start, len) per part, because Stan has no ragged arrays.", status: "n/a"),
    (id: "reverse", flatppl: "reverse", module: None, args: ["xs"], kind: "builtin", stan: "reverse({xs})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "addaxes", flatppl: "addaxes", module: None, args: ["A", "n_leading", "n_trailing"], kind: "todo", stan: "", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Vector: to_matrix(v, n, 1) or to_matrix(v', 1, n). Higher rank: arrays of matrices.", status: "n/a"),
    (id: "blockdiagmat", flatppl: "blockdiagmat", module: None, args: ["mats"], kind: "todo", stan: "", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Helper: rep_matrix(0, R, C), then block assignments A[r:(r + p - 1), c:(c + q - 1)] = mats[i].", status: "n/a"),
    (id: "bandedmat", flatppl: "bandedmat", module: None, args: ["v", "rows"], kind: "todo", stan: "", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Helper: rep_matrix(0, rows, n + rows - 1), then a segment assignment per row.", status: "n/a"),
    (id: "conv", flatppl: "conv", module: None, args: ["v", "kernel"], kind: "todo", stan: "", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Helper: one dot_product(segment(v, i, m), reverse(kernel)) per output index.", status: "n/a"),
    (id: "crosscorr", flatppl: "crosscorr", module: None, args: ["v", "kernel"], kind: "todo", stan: "", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Helper: one dot_product(segment(v, i, m), kernel) per output index.", status: "n/a"),

    // ------------------------------------------------------------ scalar restrictions
    (id: "boolean", flatppl: "boolean", module: None, args: ["x"], kind: "construct", stan: "{x}", functions: "", data_only: true, vectorized: false, broadcast: "",
     caveat: "Stan booleans are int 0/1. A non-0/1 check must be a reject in transformed data.", status: "n/a"),
    (id: "integer", flatppl: "integer", module: None, args: ["x"], kind: "construct", stan: "to_int({x})", functions: "", data_only: true, vectorized: false, broadcast: "",
     caveat: "to_int truncates; FlatPPL raises a static error on a non-integral value. Data-only.", status: "n/a"),
    (id: "real", flatppl: "real", module: None, args: ["x"], kind: "builtin", stan: "get_real({x})", functions: "", data_only: false, vectorized: true, broadcast: "",
     caveat: "Template is for complex x. For real x emit {x}.", status: "verified"),
    (id: "complex", flatppl: "complex", module: None, args: ["re", "im"], kind: "builtin", stan: "to_complex({re}, {im})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "string", flatppl: "string", module: None, args: ["x"], kind: "none", stan: "", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Stan has no string type.", status: "n/a"),
    (id: "imag", flatppl: "imag", module: None, args: ["x"], kind: "builtin", stan: "get_imag({x})", functions: "", data_only: false, vectorized: true, broadcast: "",
     caveat: "Template is for complex x. For real x emit 0.", status: "verified"),

    // ------------------------------------------------------------ elementary functions
    (id: "exp", flatppl: "exp", module: None, args: ["x"], kind: "builtin", stan: "exp({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "log", flatppl: "log", module: None, args: ["x"], kind: "builtin", stan: "log({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "log2", flatppl: "log2", module: None, args: ["x"], kind: "builtin", stan: "log2({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "log10", flatppl: "log10", module: None, args: ["x"], kind: "builtin", stan: "log10({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "sqrt", flatppl: "sqrt", module: None, args: ["x"], kind: "builtin", stan: "sqrt({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "abs", flatppl: "abs", module: None, args: ["x"], kind: "builtin", stan: "abs({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "abs2", flatppl: "abs2", module: None, args: ["x"], kind: "builtin", stan: "square({x})", functions: "", data_only: false, vectorized: true, broadcast: "",
     caveat: "Real x only. Complex x: square(abs({x})).", status: "verified"),
    (id: "sin", flatppl: "sin", module: None, args: ["x"], kind: "builtin", stan: "sin({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "cos", flatppl: "cos", module: None, args: ["x"], kind: "builtin", stan: "cos({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "tan", flatppl: "tan", module: None, args: ["x"], kind: "builtin", stan: "tan({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "asin", flatppl: "asin", module: None, args: ["x"], kind: "builtin", stan: "asin({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "acos", flatppl: "acos", module: None, args: ["x"], kind: "builtin", stan: "acos({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "atan", flatppl: "atan", module: None, args: ["x"], kind: "builtin", stan: "atan({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "atan2", flatppl: "atan2", module: None, args: ["y", "x"], kind: "builtin", stan: "atan2({y}, {x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "sinh", flatppl: "sinh", module: None, args: ["x"], kind: "builtin", stan: "sinh({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "cosh", flatppl: "cosh", module: None, args: ["x"], kind: "builtin", stan: "cosh({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "tanh", flatppl: "tanh", module: None, args: ["x"], kind: "builtin", stan: "tanh({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "asinh", flatppl: "asinh", module: None, args: ["x"], kind: "builtin", stan: "asinh({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "acosh", flatppl: "acosh", module: None, args: ["x"], kind: "builtin", stan: "acosh({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "atanh", flatppl: "atanh", module: None, args: ["x"], kind: "builtin", stan: "atanh({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "log1p", flatppl: "log1p", module: None, args: ["x"], kind: "builtin", stan: "log1p({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "expm1", flatppl: "expm1", module: None, args: ["x"], kind: "builtin", stan: "expm1({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "min", flatppl: "min", module: None, args: ["a", "b"], kind: "builtin", stan: "fmin({a}, {b})", functions: "", data_only: false, vectorized: true, broadcast: "",
     caveat: "Stan min(a, b) exists only for int.", status: "verified"),
    (id: "max", flatppl: "max", module: None, args: ["a", "b"], kind: "builtin", stan: "fmax({a}, {b})", functions: "", data_only: false, vectorized: true, broadcast: "",
     caveat: "Stan max(a, b) exists only for int.", status: "verified"),
    (id: "floor", flatppl: "floor", module: None, args: ["x"], kind: "builtin", stan: "floor({x})", functions: "", data_only: false, vectorized: true, broadcast: "",
     caveat: "Returns real. An int needs to_int, which is data-only.", status: "verified"),
    (id: "ceil", flatppl: "ceil", module: None, args: ["x"], kind: "builtin", stan: "ceil({x})", functions: "", data_only: false, vectorized: true, broadcast: "",
     caveat: "Returns real. An int needs to_int, which is data-only.", status: "verified"),
    (id: "round", flatppl: "round", module: None, args: ["x"], kind: "helper", stan: "flatppl_round({x})",
     functions: "real flatppl_round(real x) {
  // Stan round() breaks ties away from zero; FlatPPL breaks ties to even.
  if (abs(x - trunc(x)) == 0.5) return 2 * round(x / 2);
  return round(x);
}
vector flatppl_round(vector x) {
  vector[num_elements(x)] r;
  for (i in 1:num_elements(x)) r[i] = flatppl_round(x[i]);
  return r;
}",
     data_only: false, vectorized: true, broadcast: "", caveat: "Stan round(2.5) = 3; FlatPPL round(2.5) = 2. The helper restores ties to even.", status: "verified"),
    (id: "div", flatppl: "div", module: None, args: ["a", "b"], kind: "helper", stan: "flatppl_div({a}, {b})",
     functions: "int flatppl_div(int a, int b) {
  // Stan %/% truncates toward zero; FlatPPL floors.
  int q = a %/% b;
  if (a % b != 0 && ((a % b < 0) != (b < 0))) q -= 1;
  return q;
}",
     data_only: false, vectorized: false, broadcast: "", caveat: "Stan -7 %/% 2 = -3; FlatPPL div(-7, 2) = -4.", status: "verified"),
    (id: "mod", flatppl: "mod", module: None, args: ["a", "b"], kind: "helper", stan: "flatppl_mod({a}, {b})",
     functions: "int flatppl_mod(int a, int b) {
  // Stan % keeps the sign of a; FlatPPL mod is a - b * floor(a / b).
  int r = a % b;
  if (r != 0 && ((r < 0) != (b < 0))) r += b;
  return r;
}",
     data_only: false, vectorized: false, broadcast: "", caveat: "Stan -7 % 2 = -1; FlatPPL mod(-7, 2) = 1.", status: "verified"),
    (id: "conj", flatppl: "conj", module: None, args: ["x"], kind: "builtin", stan: "conj({x})", functions: "", data_only: false, vectorized: true, broadcast: "",
     caveat: "Complex only. For real x emit {x}.", status: "verified"),
    (id: "cis", flatppl: "cis", module: None, args: ["theta"], kind: "builtin", stan: "to_complex(cos({theta}), sin({theta}))", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "gamma", flatppl: "gamma", module: None, args: ["x"], kind: "builtin", stan: "tgamma({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "loggamma", flatppl: "loggamma", module: None, args: ["x"], kind: "builtin", stan: "lgamma({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "logit", flatppl: "logit", module: None, args: ["p"], kind: "builtin", stan: "logit({p})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "invlogit", flatppl: "invlogit", module: None, args: ["x"], kind: "builtin", stan: "inv_logit({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "probit", flatppl: "probit", module: None, args: ["p"], kind: "builtin", stan: "inv_Phi({p})", functions: "", data_only: false, vectorized: true, broadcast: "",
     caveat: "FR: quantiles above 0.999999999 lose accuracy.", status: "verified"),
    (id: "invprobit", flatppl: "invprobit", module: None, args: ["x"], kind: "builtin", stan: "Phi({x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),

    // ------------------------------------------------------------ operator-equivalent functions
    (id: "add", flatppl: "add", module: None, args: ["a", "b"], kind: "operator", stan: "({a} + {b})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "sub", flatppl: "sub", module: None, args: ["a", "b"], kind: "operator", stan: "({a} - {b})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "mul", flatppl: "mul", module: None, args: ["a", "b"], kind: "operator", stan: "({a} * {b})", functions: "", data_only: false, vectorized: false, broadcast: "({a} .* {b})",
     caveat: "Matrix product for matrices, as in FlatPPL. Broadcast mul is elementwise: emit ({a} .* {b}).", status: "verified"),
    (id: "divide", flatppl: "divide", module: None, args: ["a", "b"], kind: "operator", stan: "({a} / {b})", functions: "", data_only: false, vectorized: false, broadcast: "({a} ./ {b})",
     caveat: "int / int truncates in Stan. If both operands are int, emit ((1.0 * {a}) / {b}). Broadcast divide is elementwise: emit ({a} ./ {b}).", status: "verified"),
    (id: "neg", flatppl: "neg", module: None, args: ["x"], kind: "operator", stan: "(-{x})", functions: "", data_only: false, vectorized: true, broadcast: "", caveat: "", status: "verified"),
    (id: "pow", flatppl: "pow", module: None, args: ["base", "exponent"], kind: "operator", stan: "({base} ^ {exponent})", functions: "", data_only: false, vectorized: false, broadcast: "({base} .^ {exponent})",
     caveat: "int ^ int returns real in Stan. Broadcast pow is elementwise: emit ({base} .^ {exponent}).", status: "verified"),
    (id: "equal", flatppl: "equal", module: None, args: ["a", "b"], kind: "operator", stan: "({a} == {b})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Returns int 0/1.", status: "verified"),
    (id: "unequal", flatppl: "unequal", module: None, args: ["a", "b"], kind: "operator", stan: "({a} != {b})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Returns int 0/1.", status: "verified"),
    (id: "lt", flatppl: "lt", module: None, args: ["a", "b"], kind: "operator", stan: "({a} < {b})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "le", flatppl: "le", module: None, args: ["a", "b"], kind: "operator", stan: "({a} <= {b})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "gt", flatppl: "gt", module: None, args: ["a", "b"], kind: "operator", stan: "({a} > {b})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "ge", flatppl: "ge", module: None, args: ["a", "b"], kind: "operator", stan: "({a} >= {b})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),

    // ------------------------------------------------------------ predicates and checks
    (id: "isfinite", flatppl: "isfinite", module: None, args: ["x"], kind: "operator", stan: "(!is_inf({x}) && !is_nan({x}))", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "isinf", flatppl: "isinf", module: None, args: ["x"], kind: "builtin", stan: "is_inf({x})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "isnan", flatppl: "isnan", module: None, args: ["x"], kind: "builtin", stan: "is_nan({x})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "iszero", flatppl: "iszero", module: None, args: ["x"], kind: "operator", stan: "({x} == 0)", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "checked", flatppl: "checked", module: None, args: ["value", "condition"], kind: "construct", stan: "if (!({condition})) reject(...);", functions: "", data_only: true, vectorized: false, broadcast: "",
     caveat: "Emit the check in transformed data, then use value.", status: "n/a"),

    // ------------------------------------------------------------ linear algebra
    (id: "transpose", flatppl: "transpose", module: None, args: ["A"], kind: "operator", stan: "{A}'", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Also correct for complex types; Stan ' does not conjugate.", status: "verified"),
    (id: "adjoint", flatppl: "adjoint", module: None, args: ["A"], kind: "builtin", stan: "conj({A}')", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Template is for complex types. For real types emit {A}'.", status: "verified"),
    (id: "det", flatppl: "det", module: None, args: ["A"], kind: "builtin", stan: "determinant({A})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "logabsdet", flatppl: "logabsdet", module: None, args: ["A"], kind: "builtin", stan: "log_determinant({A})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "inv", flatppl: "inv", module: None, args: ["A"], kind: "builtin", stan: "inverse({A})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "trace", flatppl: "trace", module: None, args: ["A"], kind: "builtin", stan: "trace({A})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "linsolve", flatppl: "linsolve", module: None, args: ["A", "b"], kind: "operator", stan: "({A} \\ {b})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "qr", flatppl: "qr", module: None, args: ["A"], kind: "builtin", stan: "qr_thin({A})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Returns tuple(Q, R); record fields Q, R become .1, .2. Stan makes diag(R) non-negative; §07 fixes no sign.", status: "verified"),
    (id: "lower_cholesky", flatppl: "lower_cholesky", module: None, args: ["A"], kind: "builtin", stan: "cholesky_decompose({A})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Real symmetric A only.", status: "verified"),
    (id: "row_gram", flatppl: "row_gram", module: None, args: ["A"], kind: "builtin", stan: "tcrossprod({A})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Real A only.", status: "verified"),
    (id: "col_gram", flatppl: "col_gram", module: None, args: ["A"], kind: "builtin", stan: "crossprod({A})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "Real A only.", status: "verified"),
    (id: "self_outer", flatppl: "self_outer", module: None, args: ["x"], kind: "operator", stan: "({x} * {x}')", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Real x. Complex x: ({x} * conj({x}')).", status: "verified"),
    (id: "cross", flatppl: "cross", module: None, args: ["a", "b"], kind: "helper", stan: "flatppl_cross({a}, {b})",
     functions: "vector flatppl_cross(vector a, vector b) {
  return [a[2] * b[3] - a[3] * b[2], a[3] * b[1] - a[1] * b[3], a[1] * b[2] - a[2] * b[1]]';
}",
     data_only: false, vectorized: false, broadcast: "", caveat: "Real vectors of length 3.", status: "verified"),
    (id: "diagmat", flatppl: "diagmat", module: None, args: ["x"], kind: "builtin", stan: "diag_matrix({x})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "diag", flatppl: "diag", module: None, args: ["A", "k"], kind: "helper", stan: "flatppl_diag({A}, {k})",
     functions: "vector flatppl_diag(matrix A, int k) {
  // Stan diagonal() has no offset argument. Copy rows()/cols() to int first: stanc 2.40 emits
  // std::min(long, int) for min(rows(A), int), which does not compile.
  int m = rows(A);
  int n = cols(A);
  int len = k >= 0 ? min(m, n - k) : min(m + k, n);
  vector[max(len, 0)] d;
  for (i in 1:len) {
    if (k >= 0) d[i] = A[i, i + k];
    else d[i] = A[i - k, i];
  }
  return d;
}",
     data_only: false, vectorized: false, broadcast: "", caveat: "diag(A) with k = 0 may emit diagonal({A}).", status: "verified"),
    (id: "quadform", flatppl: "quadform", module: None, args: ["A", "x"], kind: "builtin", stan: "quad_form({A}, {x})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "Real only.", status: "verified"),

    // ------------------------------------------------------------ reductions
    (id: "sum", flatppl: "sum", module: None, args: ["xs"], kind: "builtin", stan: "sum({xs})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "mean", flatppl: "mean", module: None, args: ["xs"], kind: "builtin", stan: "mean({xs})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
