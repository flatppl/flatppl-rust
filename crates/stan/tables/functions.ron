    // ------------------------------------------------------------ logic and conditionals
    (id: "land", flatppl: "land", module: None, args: ["a", "b"], kind: "operator", stan: "({a} && {b})", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
