    (id: "builtin_fromnormal", flatppl: "builtin_fromnormal", module: None, args: ["kernel", "kernel_input", "z"], kind: "todo", stan: "", functions: "", data_only: false, vectorized: false, broadcast: "", caveat: "MvNormal: mu + cholesky_decompose(cov) * z. Normal: mu + sigma * z. Other laws need a quantile function.", status: "n/a"),

