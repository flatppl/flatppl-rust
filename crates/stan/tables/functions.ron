    // ------------------------------------------------------------ membership, binning, approximation
    (id: "in", flatppl: "in", module: None, args: ["x", "S"], kind: "construct", stan: "({lo} <= {x} && {x} <= {hi})", functions: "", data_only: false, vectorized: false, broadcast: "",
     caveat: "interval(lo, hi) only.", status: "n/a"),
    (id: "filter", flatppl: "filter", module: None, args: ["pred", "data", "p"], kind: "todo", stan: "", functions: "", data_only: true, vectorized: false, broadcast: "", caveat: "The emitter handles the call before this table lookup. Data only, over a rank-1 array: in transformed data, a loop counts the kept elements, declares array[count] (or vector[count]) and fills it, calling the predicate as a user function. A callback parameter, a table, or a parameter-dependent predicate or array refuses.", status: "n/a"),
    (id: "selectbins", flatppl: "selectbins", module: None, args: ["edges", "region", "counts"], kind: "todo", stan: "", functions: "", data_only: true, vectorized: false, broadcast: "", caveat: "Data-only helper loop.", status: "n/a"),
    (id: "bincounts", flatppl: "bincounts", module: None, args: ["bins", "data"], kind: "todo", stan: "", functions: "", data_only: true, vectorized: false, broadcast: "", caveat: "Data-only helper loop; the last bin is closed on the right (§07).", status: "n/a"),
    (id: "polynomial", flatppl: "polynomial", module: None, args: ["coefficients", "x"], kind: "helper", stan: "flatppl_polynomial({coefficients}, {x})",
     functions: "real flatppl_polynomial(vector c, real x) {
  int n = num_elements(c);
  real acc = 0;
  for (i in 1:n) acc = acc * x + c[n + 1 - i];
  return acc;
}",
     data_only: false, vectorized: false, broadcast: "", caveat: "Horner evaluation.", status: "verified"),
    (id: "bernstein", flatppl: "bernstein", module: None, args: ["coefficients", "x"], kind: "helper", stan: "flatppl_bernstein({coefficients}, {x})",
     functions: "real flatppl_bernstein(vector c, real x) {
  int n = num_elements(c) - 1;
  real acc = 0;
  for (k in 0:n) acc += c[k + 1] * choose(n, k) * pow(x, k) * pow(1 - x, n - k);
  return acc;
}",
     data_only: false, vectorized: false, broadcast: "", caveat: "", status: "verified"),
    (id: "stepwise", flatppl: "stepwise", module: None, args: ["edges", "values", "x"], kind: "helper", stan: "flatppl_stepwise({edges}, {values}, {x})",
     functions: "real flatppl_stepwise(vector edges, vector values, real x) {
  int n = num_elements(values);
  if (x < edges[1] || x > edges[n + 1]) return not_a_number();
  for (i in 1:(n - 1)) {
    if (x < edges[i + 1]) return values[i];
  }
  return values[n];
}",
     data_only: false, vectorized: false, broadcast: "", caveat: "§07 states no value outside [e_1, e_{n+1}]; the helper returns NaN there.", status: "verified"),

