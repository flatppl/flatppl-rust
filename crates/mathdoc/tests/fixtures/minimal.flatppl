flatppl_compat = "0.1"

a = elementof(nonnegreals)
b = a^0.5
f_root = functionof(b)

mu = elementof(reals)
sigma_sq ~ Exponential(1.0)
sigma = f_root(a = sigma_sq)

x ~ iid(Normal(mu = mu, sigma = sigma), 3)
kernel = kernelof(x, mu = mu)
kernel_input = record(mu = 1.5)
dist = kernel(mu = kernel_input.mu)
