(let $a (Leaf 1))
(let $b (Leaf 2))
(let $c (Leaf 3))
(real-vector $a 2)
(real-vector $b 3)
(real-vector $c 1)
(concat-fixed-part $a)
(concat-fixed-part $c)

(let $routed (Leaf 4))
(real-value $routed)
(concat-read $routed "get0" 4 6)
(concat-triple $routed $a $b $c)
(concat-exclusive-part $routed $b)

(let $shared (Leaf 5))
(real-value $shared)
(concat-read $shared "get0" 4 6)
(concat-triple $shared $a $b $c)

(let $discarded-dynamic (Leaf 6))
(real-value $discarded-dynamic)
(concat-read $discarded-dynamic "get" 6 6)
(concat-triple $discarded-dynamic $a $b $c)
(concat-exclusive-part $discarded-dynamic $c)

(let $bad-bound (Leaf 7))
(real-value $bad-bound)
(concat-read $bad-bound "get" 7 6)
(concat-triple $bad-bound $a $b $c)
(concat-exclusive-part $bad-bound $b)

(let $fixed-cell (Real 4607182418800017408))
(let $scalar (Leaf 8))
(real-value $scalar)
(concat-read $scalar "get" 2 2)
(concat-pair $scalar (Real 0) $fixed-cell)

(let $fixed-vector (U "vector" $fixed-cell))
(real-vector $fixed-vector 1)
(type-id $fixed-cell 1)
(let $composed (Leaf 9))
(real-value $composed)
(type-id $composed 1)
(concat-read $composed "get" 3 3)
(concat-pair $composed $a $fixed-vector)

(let $column (U "colstack" (U "vector" $a)))
(real-matrix $column 2 1)
(fixed-singleton-stack $column "colstack" $a)
(let $row (U "rowstack" (U "vector" $a)))
(real-matrix $row 1 2)
(fixed-singleton-stack $row "rowstack" $a)
(let $unproven (U "colstack" (U "vector" $b)))
(real-matrix $unproven 3 1)

(run concat 16)
(check (= $routed (B "get0" $b (Integer 2))))
(check (= $scalar $fixed-cell))
(check (= $composed $fixed-cell))
(fail (check (= $shared $routed)))
(fail (check (concat-cell $discarded-dynamic "get" $c 1)))
(fail (check (concat-cell $bad-bound "get" $c 2)))
(check (= $column (T "addaxes" $a (Integer 0) (Integer 1))))
(check (= $row (T "addaxes" $a (Integer 1) (Integer 0))))
(fail (check (= $unproven (T "addaxes" $b (Integer 0) (Integer 1)))))
