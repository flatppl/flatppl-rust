(let $p (Leaf 1))
(let $q (Leaf 2))
(let $r (Leaf 3))
(bool-value $p)
(bool-value $q)
(bool-value $r)
(erasable $p)
(erasable $q)
(erasable $r)

(let $double-not (U "lnot" (U "lnot" $p)))
(let $and-identity (B "land" $p (Boolean true)))
(let $or-identity (B "lor" (Boolean false) $p))
(let $xor-negation (B "lxor" $p (Boolean true)))
(let $bool-select (T "ifelse" $p (Boolean true) (Boolean false)))
(let $absorbed (B "land" $p (B "lor" (B "land" $q $r) $p)))
(let $contradiction (B "land" (U "lnot" $p) (B "land" $q $p)))
(let $tautology (B "lor" (U "lnot" $p) (B "lor" $q $p)))
(let $negated-and (U "lnot" (B "land" $p $q)))
(let $negated-children (B "lor" (U "lnot" $p) (U "lnot" $q)))
(let $demorgan (B "equal" $negated-and $negated-children))

(let $a (Leaf 11))
(let $b (Leaf 12))
(type-id $a 5)
(type-id $b 5)
(erasable $a)
(erasable $b)
(let $true-select (T "ifelse" (Boolean true) $a $b))
(let $false-select (T "ifelse" (Boolean false) $a $b))
(let $proved-select (T "ifelse" $contradiction $a $b))

(let $row (Leaf 13))
(type-id $row 6)
(erasable $row)
(let $different-orientation (T "ifelse" (Boolean true) $a $row))
(let $unknown-type (Leaf 14))
(erasable $unknown-type)
(let $unknown-type-select (T "ifelse" (Boolean true) $a $unknown-type))

(let $checked (Leaf 15))
(type-id $checked 5)
(let $checked-select (T "ifelse" (Boolean true) $a $checked))
(let $singular (U "sqrt" $a))
(type-id $singular 5)
(let $singular-select (T "ifelse" (Boolean false) $singular $b))
(let $rng-result (Leaf 16))
(type-id $rng-result 5)
(let $rng-select (T "ifelse" (Boolean false) $rng-result $b))

(let $effectful-predicate (Leaf 17))
(bool-value $effectful-predicate)
(let $eager-false (B "land" (Boolean false) $effectful-predicate))
(let $eager-true (B "lor" $effectful-predicate (Boolean true)))
(let $eager-contradiction (B "land" $effectful-predicate (U "lnot" $effectful-predicate)))
(let $eager-absorption (B "land" $p (B "lor" $p $effectful-predicate)))

(let $array-mask (Leaf 18))
(erasable $array-mask)
(let $array-select (T "ifelse" $array-mask (Boolean true) (Boolean false)))
(let $array-annihilation (B "land" (Boolean false) $array-mask))

(let $i (Leaf 21))
(let $j (Leaf 22))
(let $three (Integer 3))
(let $five (Integer 5))
(int-value $i)
(int-value $j)
(int-value $three)
(int-value $five)
(type-id $i 2)
(type-id $j 2)
(type-id $three 2)
(type-id $five 2)
(erasable $i)
(erasable $j)
(erasable $three)
(erasable $five)
(let $equal (B "equal" $i $j))
(let $unequal (B "unequal" $j $i))
(let $reflexive (B "equal" $i $i))
(let $complementary (B "lor" $equal $unequal))
(let $integer-lt (B "lt" $i $j))
(let $integer-ge (B "ge" $i $j))
(let $integer-coverage (B "lor" $integer-lt $integer-ge))
(let $integer-implies-unequal (B "land" $integer-lt $unequal))
(let $integer-excludes-equal (B "land" $integer-lt $equal))
(let $order-or-equal (B "lor" $integer-lt $equal))
(let $integer-weak (B "le" $i $three))
(let $integer-wide (B "lt" $i $five))
(let $integer-bound (B "land" $integer-wide $integer-weak))

(let $x (Leaf 31))
(let $y (Leaf 32))
(real-value $x)
(real-value $y)
(type-id $x 3)
(type-id $y 3)
(erasable $x)
(erasable $y)
(let $real-exact (B "equal" $x $x))
(let $real-lt (B "lt" $x $y))
(let $real-le (B "le" $x $y))
(let $real-ge (B "ge" $x $y))
(let $unordered-inclusive (B "lor" $real-lt $real-ge))
(let $unordered-exclusive (B "land" $real-lt $real-ge))
(let $strict-bound (B "land" $real-lt $real-le))
(let $swapped-order (B "lxor" $real-lt (B "gt" $y $x)))
(let $finite (U "isfinite" $x))
(let $nan (U "isnan" $x))
(let $finite-not-nan (B "land" $finite (U "lnot" $nan)))
(let $finite-or-inf (B "lor" $finite (U "isinf" $x)))

(run analysis 1)
(run simplification 16)

(check (= $double-not $p))
(check (= $and-identity $p))
(check (= $or-identity $p))
(check (= $xor-negation (U "lnot" $p)))
(check (= $bool-select $p))
(check (= $absorbed $p))
(check (= $contradiction (Boolean false)))
(check (= $tautology (Boolean true)))
(check (= $demorgan (Boolean true)))
(check (= $true-select $a))
(check (= $false-select $b))
(check (= $proved-select $b))
(check (= $reflexive (Boolean true)))
(check (= $complementary (Boolean true)))
(check (= $integer-coverage (Boolean true)))
(check (= $integer-implies-unequal $integer-lt))
(check (= $integer-excludes-equal (Boolean false)))
(check (= $integer-bound $integer-weak))
(check (= $unordered-exclusive (Boolean false)))
(check (= $strict-bound $real-lt))
(check (= $swapped-order (Boolean false)))
(check (= $finite-not-nan $finite))

(fail (check (= $different-orientation $a)))
(fail (check (= $unknown-type-select $a)))
(fail (check (= $checked-select $a)))
(fail (check (= $singular-select $b)))
(fail (check (= $rng-select $b)))
(fail (check (= $eager-false (Boolean false))))
(fail (check (= $eager-true (Boolean true))))
(fail (check (= $eager-contradiction (Boolean false))))
(fail (check (= $eager-absorption $p)))
(fail (check (= $array-select $array-mask)))
(fail (check (= $array-annihilation (Boolean false))))
(fail (check (= $order-or-equal (Boolean true))))
(fail (check (= $order-or-equal $integer-lt)))
(fail (check (= $real-exact (Boolean true))))
(fail (check (= $unordered-inclusive (Boolean true))))
(fail (check (= $finite-or-inf (Boolean true))))
