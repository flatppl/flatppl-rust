(let $real (Leaf 1))
(let $checked (Leaf 2))
(let $vector (Leaf 3))
(let $singleton (Leaf 4))
(let $matrix (Leaf 5))
(let $unknown-shape (Leaf 6))
(let $normalized (Leaf 7))
(let $unknown-mass (Leaf 8))
(let $parametric (Leaf 9))
(let $fixed (Leaf 10))
(let $first (Real 4607182418800017408))
(let $last (Real 4611686018427387904))
(let $integer (Leaf 11))
(let $fixed-vector (B "vector" $first $last))
(let $identity (U "identity" $checked))
(let $round-trip (U "adjoint" (U "transpose" $matrix)))
(let $no-shape-proof (U "transpose" (U "transpose" $unknown-shape)))
(let $rev (U "reverse" $vector))
(let $reverse-twice (U "reverse" $rev))
(let $reverse-singleton (U "reverse" $singleton))
(let $get (B "get" $rev (Integer 1)))
(let $get0 (B "get0" $rev (Integer 3)))
(let $get-outside (B "get" $rev (Integer 5)))
(let $get0-outside (B "get0" $rev (Integer -1)))
(let $get-retained (B "get" (B "vector" $real $last) (Integer 1)))
(let $get0-retained (B "get0" (B "vector" $first $real) (Integer 1)))
(let $get-single (B "get0" (U "vector" $real) (Integer 0)))
(let $get-checked-other (B "get" (B "vector" $real $checked) (Integer 1)))
(let $get-widens (B "get" (B "vector" $integer $last) (Integer 1)))
(let $get-restored (U "lengthof" $fixed-vector))
(let $get-length-with-input (U "lengthof" $vector))
(let $normalization (U "normalize" $normalized))
(let $unproved-normalization (U "normalize" $unknown-mass))
(let $log-score (B "logdensityof" $normalization $real))
(let $score (B "densityof" $normalization $real))
(let $mass (U "totalmass" $normalization))
(let $unproved-log-score (B "logdensityof" $unproved-normalization $real))

(type-id $real 1)
(type-id $first 1)
(type-id $last 1)
(type-id $checked 1)
(type-id $identity 1)
(type-id $integer 2)
(type-id $vector 3)
(type-id $rev 3)
(type-id $reverse-twice 3)
(type-id $singleton 4)
(type-id $reverse-singleton 4)
(type-id $matrix 5)
(type-id $round-trip 5)
(type-id $unknown-shape 6)
(type-id $no-shape-proof 6)
(type-id $normalized 7)
(type-id $normalization 7)
(type-id $unknown-mass 8)
(type-id $unproved-normalization 7)
(type-id $get-retained 1)
(type-id $get0-retained 1)
(type-id $get-single 1)
(type-id $get-checked-other 1)
(type-id $get-widens 1)
(real-vector $vector 4)
(real-vector $rev 4)
(real-vector $singleton 1)
(real-vector (U "vector" $real) 1)
(real-vector (B "vector" $real $last) 2)
(real-vector (B "vector" $first $real) 2)
(real-vector (B "vector" $real $checked) 2)
(real-vector (B "vector" $integer $last) 2)
(real-vector $fixed-vector 2)
(real-matrix $matrix 2 3)
(real-value $get)
(real-value $get0)
(real-value $get-outside)
(real-value $get0-outside)
(int-value $get-restored)
(int-value $get-length-with-input)
(int-value $integer)
(portable-normalized $normalized)

(let $strict-low (B "lt" $integer (Integer 3)))
(let $strict-high (B "lt" $integer (Integer 5)))
(let $weak-low (B "ge" $integer (Integer -5)))
(let $weak-high (B "ge" $integer (Integer -3)))
(let $different-input (B "lt" (Leaf 12) (Integer 5)))
(let $real-bound (B "lt" $real (Integer 3)))
(let $other-real-bound (B "lt" $real (Integer 5)))
(int-value (Leaf 12))
(bool-value $parametric)
(bool-value $fixed)
(bool-value $strict-low)
(bool-value $strict-high)
(bool-value $weak-low)
(bool-value $weak-high)
(bool-value $different-input)
(bool-value $real-bound)
(bool-value $other-real-bound)
(portable-discardable $fixed)

(let $double-not (U "lnot" (U "lnot" $parametric)))
(let $neutral (B "equal" (Boolean true) $parametric))
(let $annihilation (B "lor" $fixed (Boolean true)))
(let $contradiction (B "land" (U "lnot" $fixed) $fixed))
(let $retained-predicate (B "lor" $parametric (U "lnot" $parametric)))
(let $strict-conjunction (B "land" $strict-high $strict-low))
(let $weak-disjunction (B "lor" $weak-low $weak-high))
(let $unrelated-conjunction (B "land" $strict-low $different-input))
(let $real-conjunction (B "land" $real-bound $other-real-bound))
(let $select-bool (T "ifelse" $parametric (Boolean true) (Boolean false)))
(let $select (T "ifelse" (Boolean false) $first $real))
(let $select-checked (T "ifelse" (Boolean false) $checked $real))
(let $select-same (T "ifelse" $fixed $real $real))
(let $select-keep-condition (T "ifelse" $parametric $real $real))
(let $select-mixed (T "ifelse" (Boolean true) $real (Integer 1)))
(type-id $select 1)
(type-id $select-checked 1)
(type-id $select-same 1)
(type-id $select-keep-condition 1)
(type-id $select-mixed 1)
(type-id (Integer 1) 2)

(run-schedule (saturate (seq analysis portable)))

(check (= $identity $checked))
(check (= $round-trip $matrix))
(fail (check (= $no-shape-proof $unknown-shape)))
(check (= $reverse-twice $vector))
(check (= $reverse-singleton $singleton))
(check (= $get (B "get" $vector (Integer 4))))
(check (= $get0 (B "get0" $vector (Integer 0))))
(fail (check (= $get-outside (B "get" $vector (Integer 0)))))
(fail (check (= $get0-outside (B "get0" $vector (Integer 4)))))
(check (= $get-retained $real))
(check (= $get0-retained $real))
(check (= $get-single $real))
(fail (check (= $get-checked-other $real)))
(fail (check (= $get-widens $integer)))
(check (= $get-restored (Integer 2)))
(fail (check (= $get-length-with-input (Integer 4))))
(check (= $log-score (B "logdensityof" $normalized $real)))
(check (= $score (B "densityof" $normalized $real)))
(check (= $mass (U "totalmass" $normalized)))
(fail (check (= $normalization $normalized)))
(fail (check (= $unproved-log-score (B "logdensityof" $unknown-mass $real))))
(check (= $double-not $parametric))
(check (= $neutral $parametric))
(check (= $annihilation (Boolean true)))
(check (= $contradiction (Boolean false)))
(fail (check (= $retained-predicate (Boolean true))))
(check (= $strict-conjunction $strict-low))
(check (= $weak-disjunction $weak-low))
(fail (check (= $unrelated-conjunction $strict-low)))
(fail (check (= $real-conjunction $real-bound)))
(check (= $select-bool $parametric))
(check (= $select $real))
(fail (check (= $select-checked $real)))
(check (= $select-same $real))
(fail (check (= $select-keep-condition $real)))
(fail (check (= $select-mixed $real)))
