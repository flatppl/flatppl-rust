; get and get0 keep ordered rows. An alias [6, 3] has zero-based rows [5, 2].
(let $x (Leaf 1))
(let $z (Leaf 2))
(let $neg-z (U "neg" $z))
(real-vector $x 8)
(real-vector $z 8)
(real-vector $neg-z 8)
(let $first (Leaf 11))
(let $second (Leaf 12))
(let $combined (Leaf 13))
(let $combined1 (Leaf 14))
(let $swapped (Leaf 15))
(let $identity (Leaf 16))
(let $repeat (Leaf 17))
(let $invalid (Leaf 18))
(let $dynamic (Leaf 19))
(let $repeat-position (Leaf 20))
; First selects [7, 2, 5, 0]. Second selects positions [2, 1].
(fixed-selector "get" $first 4 0 7 0 true false)
(fixed-selector "get0" $second 2 1 2 1 true false)
(fixed-selector "get0" $combined 2 2 5 2 true false)
(fixed-selector "get" $combined1 2 2 5 2 true false)
(fixed-selector "get0" $swapped 2 2 5 3 true false)
(fixed-selector "get" $identity 8 0 7 4 true true)
(fixed-selector "get0" $repeat 2 5 5 5 false false)
(fixed-selector "get0" $invalid 2 0 8 6 true false)
(fixed-selector "get0" $repeat-position 2 2 2 7 false false)
(selector-representative 2 "get0" $combined)
(selector-representative 5 "get0" $repeat)

(let $nested (B "get0" (B "get" $neg-z $first) $second))
(let $alias (B "get" $x $combined1))
(let $identity-root (Leaf 3))
(real-vector $identity-root 8)
(let $recovered (B "get" $identity-root $identity))
(exclusive-gather-source "get" $x $combined1)
(exclusive-gather-source "get" $identity-root $identity)
(composed-selector $neg-z "get" $first "get0" $second 2)
(commutable-negation "get0" $z $combined)

; Seed the reverse direction without creating the full negation in the input.
(let $early-root (Leaf 4))
(real-vector $early-root 8)
(let $early (U "neg" (B "get0" $early-root $combined)))
(commutable-negation "get0" $early-root $combined)

; Bound and injectivity must hold even with an occurrence witness.
(let $negative-root (Leaf 5))
(let $neg-negative (U "neg" $negative-root))
(real-vector $negative-root 8)
(real-vector $neg-negative 8)
(let $duplicate-selection (B "get0" $neg-negative $repeat))
(let $invalid-selection (B "get0" $neg-negative $invalid))
(let $dynamic-selection (B "get0" $neg-negative $dynamic))
(let $shared-selection (B "get0" $neg-negative $combined))
(let $shared-inner (B "get0" (B "get" $negative-root $first) $second))
(let $repeated-nested (B "get0" (B "get" $negative-root $first) $repeat-position))
(let $shared-identity (B "get" $negative-root $identity))
(let $raw-cdf (U "log_ndtr" $negative-root))
(real-vector $raw-cdf 8)
(let $checked-cdf (B "get0" $raw-cdf $combined))
(commutable-negation "get0" $negative-root $repeat)
(commutable-negation "get0" $negative-root $invalid)
(commutable-negation "get0" $negative-root $dynamic)
(composed-selector $negative-root "get" $first "get0" $repeat-position 5)

(run-schedule (repeat 4 (seq (run selector-facts) (run sharing) (run hoisting))))
(check (= $nested (B "get0" $neg-z $combined)))
(check (= $nested (U "neg" (B "get0" $z $combined))))
(check (= $alias (B "get0" $x $combined)))
(check (= $recovered $identity-root))
(check (= $early (B "get0" (U "neg" $early-root) $combined)))
(fail (check (= $alias (B "get0" $x $swapped))))
(fail (check (= $duplicate-selection (U "neg" (B "get0" $negative-root $repeat)))))
(fail (check (= $invalid-selection (U "neg" (B "get0" $negative-root $invalid)))))
(fail (check (= $dynamic-selection (U "neg" (B "get0" $negative-root $dynamic)))))
(fail (check (= $shared-selection (U "neg" (B "get0" $negative-root $combined)))))
(fail (check (= $shared-inner (B "get0" $negative-root $combined))))
(fail (check (= $shared-identity $negative-root)))
(fail (check (= $repeated-nested (B "get0" $negative-root $repeat))))
(fail (check (= $checked-cdf (U "log_ndtr" (B "get0" $negative-root $combined)))))
