(let $log-rate (Leaf 1))
(let $native-cells (Leaf 2))
(let $too-many-cells (Leaf 3))
(let $unproved-cells (Leaf 4))
(let $plan (Leaf 5))
(let $too-wide (Leaf 6))
(let $unproved-plan (Leaf 7))
(let $native (U "sum" $native-cells))
(let $retains (U "sum" $too-many-cells))
(let $unproved (U "sum" $unproved-cells))
(real-vector $native-cells 256)
(real-vector $too-many-cells 256)
(fixed-poisson-partition $native-cells $log-rate $plan 256 64)
(fixed-poisson-partition $too-many-cells $log-rate $too-wide 256 65)
(fixed-poisson-partition $unproved-cells $log-rate $unproved-plan 256 32)
(run 4)
(check (= $native (B "poisson.grouped-score" $log-rate $plan)))
(fail (check (= $retains (B "poisson.grouped-score" $log-rate $too-wide))))
(fail (check (= $unproved (B "poisson.grouped-score" $log-rate $unproved-plan))))
