(let $v (Leaf 0))
(let $single (Leaf 1))
(let $m (Leaf 2))
(let $cell (Leaf 3))
(let $blocks (Leaf 4))
(let $s (Leaf 5))
(let $wrong-size (Leaf 6))
(let $retile-size (Leaf 7))
(let $units (B "vector" (Integer 1) (Integer 1)))
(let $nested-vectors (Leaf 8))
(let $row (U "transpose" $v))
(let $column (U "adjoint" $row))
(let $adjoint (U "adjoint" $m))
(let $same-matrix (U "transpose" $adjoint))
(let $same-cell (U "transpose" $cell))
(let $row-without-witness (U "transpose" $single))
(let $unclassified-orientation (U "adjoint" $row-without-witness))

(real-vector $v 6)
(real-vector $single 1)
(real-vector $column 6)
(math-real-row $row 6)
(real-vector $unclassified-orientation 1)
(real-matrix $m 2 6)
(real-matrix $adjoint 6 2)
(real-matrix $same-matrix 2 6)
(real-matrix $cell 1 1)
(real-matrix $same-cell 1 1)
(type-id $v 1)
(type-id $column 1)
(type-id $single 2)
(type-id $m 3)
(type-id $same-matrix 3)
(type-id $cell 4)
(type-id $same-cell 4)

(let $rev (U "reverse" $v))
(let $reversed-twice (U "reverse" $rev))
(let $same-single (U "reverse" $single))
(let $third (B "get" $rev (Integer 3)))
(let $last (B "get0" $rev (Integer 5)))
(let $oob (B "get" $rev (Integer 7)))
(real-vector $rev 6)
(type-id $rev 1)
(type-id $reversed-twice 1)
(type-id $same-single 2)
(real-value $third)
(real-value $last)
(real-value $oob)

(let $shape (MathDim 2 (MathDim 6 (MathNil))))
(let $outer (MathDim 1 (MathDim 2 (MathNil))))
(let $inner (MathDim 2 (MathDim 3 (MathNil))))
(let $invalid-inner (MathDim 1 (MathDim 4 (MathNil))))
(math-flat-shape $v (MathDim 6 (MathNil)))
(math-flat-shape $m $shape)
(math-block-shape $blocks $outer $inner)
(math-int-list $units (MathDim 1 (MathDim 1 (MathNil))))
(math-int-list $s $inner)
(math-int-list $wrong-size $invalid-inner)
(math-int-list $retile-size $outer)
(type-id $blocks 5)

(let $tiled (B "tile" $m $units))
(let $tiled-vector (B "tile" $v (Integer 1)))
(let $rank-mismatch (B "tile" $m (Integer 1)))
(let $non-unit-tile (B "tile" $m $s))
(type-id $tiled 3)
(type-id $tiled-vector 1)
; Supply matching type IDs to isolate the rank and count checks.
(type-id $rank-mismatch 3)
(type-id $non-unit-tile 3)

(let $split (B "splitblocks" $m $s))
(let $joined (U "joinblocks" $split))
(let $joined-blocks (U "joinblocks" $blocks))
(let $split-again (B "splitblocks" $joined-blocks $s))
(let $retiled (B "splitblocks" $joined-blocks $retile-size))
(let $wrong-split (B "splitblocks" $m $wrong-size))
(let $wrong-join (U "joinblocks" $wrong-split))
(math-block-shape $split $outer $inner)
(math-block-shape $wrong-split (MathDim 2 (MathDim 1 (MathNil))) $invalid-inner)
(math-flat-shape $joined-blocks $shape)
(type-id $joined 3)
(type-id $split-again 5)
(type-id $retiled 5)
(type-id $wrong-join 3)

(let $add-no-axes (T "addaxes" $v (Integer 0) (Integer 0)))
(let $add-leading (T "addaxes" $v (Integer 1) (Integer 0)))
(let $add-trailing (T "addaxes" $v (Integer 0) (Integer 1)))
(let $swap-added (U "transpose" $add-leading))
(let $add-again (T "addaxes" $add-leading (Integer 2) (Integer 1)))
(type-id $add-no-axes 1)
(math-flat-shape $add-leading (MathDim 1 (MathDim 6 (MathNil))))
(math-flat-shape $add-again (MathDim 1 (MathDim 1 (MathDim 1 (MathDim 6 (MathDim 1 (MathNil)))))))
(real-matrix $add-leading 1 6)
(real-matrix $swap-added 6 1)

(let $columns (U "colstack" $nested-vectors))
(let $rows (U "rowstack" $nested-vectors))
(let $transpose-columns (U "transpose" $columns))
(let $transpose-rows (U "transpose" $rows))
(math-block-shape $nested-vectors (MathDim 2 (MathNil)) (MathDim 6 (MathNil)))
(let $reverse-nested (U "reverse" $nested-vectors))
(let $reverse-nested-twice (U "reverse" $reverse-nested))
(math-block-shape $reverse-nested (MathDim 2 (MathNil)) (MathDim 6 (MathNil)))
(type-id $nested-vectors 7)
(type-id $reverse-nested 7)
(type-id $reverse-nested-twice 7)
(real-matrix $columns 6 2)
(real-matrix $rows 2 6)
(real-matrix $transpose-columns 2 6)
(real-matrix $transpose-rows 6 2)

(let $row-product (B "mul" $m $adjoint))
(let $col-product (B "mul" $adjoint $m))
(let $outer-product (B "mul" $v $row))
(let $inner-product (B "mul" $row $v))
(let $row-gram-transposed (U "row_gram" $adjoint))
(let $col-gram-transposed (U "col_gram" $adjoint))
(real-matrix $row-product 2 2)
(real-matrix $col-product 6 6)
(real-matrix $outer-product 6 6)
(real-value $inner-product)
(real-matrix $row-gram-transposed 6 6)
(real-matrix $col-gram-transposed 2 2)

(let $diagonal (U "diagmat" $v))
(let $transposed-diagonal (U "transpose" $diagonal))
(let $extracted-diagonal (U "diag" $diagonal))
(let $diagonal-sum (U "sum" $extracted-diagonal))
(real-matrix $diagonal 6 6)
(real-matrix $transposed-diagonal 6 6)
(real-vector $extracted-diagonal 6)
(real-value $diagonal-sum)
(type-id $diagonal 6)
(type-id $transposed-diagonal 6)
(type-id $extracted-diagonal 1)

(run-schedule (saturate mathematical))

(check (= $same-matrix $m))
(check (= $same-cell $cell))
(check (= $column $v))
(fail (check (= $row $v)))
(fail (check (= $unclassified-orientation $single)))
(check (= $reversed-twice $v))
(check (= $reverse-nested-twice $nested-vectors))
(check (= $same-single $single))
(fail (check (= $rev $v)))
(check (= $third (B "get" $v (Integer 4))))
(check (= $last (B "get0" $v (Integer 0))))
(fail (check (= $oob (B "get" $v (Integer 0)))))
(check (= $tiled $m))
(check (= $tiled-vector $v))
(fail (check (= $rank-mismatch $m)))
(fail (check (= $non-unit-tile $m)))
(check (= $joined $m))
(check (= $split-again $blocks))
(fail (check (= $retiled $blocks)))
(fail (check (= $wrong-join $m)))
(check (= $add-no-axes $v))
(check (= $swap-added $add-trailing))
(check (= $add-again (T "addaxes" $v (Integer 3) (Integer 1))))
(check (= $transpose-columns $rows))
(check (= $transpose-rows $columns))
(check (= $row-product (U "row_gram" $m)))
(check (= $col-product (U "col_gram" $m)))
(check (= $outer-product (U "self_outer" $v)))
(fail (check (= $inner-product (U "self_outer" $v))))
(check (= $row-gram-transposed (U "col_gram" $m)))
(check (= $col-gram-transposed (U "row_gram" $m)))
(check (= $transposed-diagonal $diagonal))
(fail (check (= $extracted-diagonal $v)))
(check (= $diagonal-sum (U "trace" $diagonal)))
