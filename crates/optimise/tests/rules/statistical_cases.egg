(let $pos-inf (Real 9218868437227405312))
(let $neg-inf (Real -4503599627370496))
(let $pos-zero (Real 0))
(let $neg-zero (Real -9223372036854775808))
(let $nan (Real 9221120237041090560))
(let $one (Real 4607182418800017408))
(let $neg-normal (Real -5183643171103440896))
(let $f32-subnormal (Real 4035225266123964416))
(let $f32-overflow (Real 5183643171103440896))
(let $predicate (Leaf 1001))
(let $checked-predicate (Leaf 1002))
(let $empty (Leaf 1003))
(let $checked-empty (Leaf 1004))
(let $live (Leaf 1005))
(let $ranked (Leaf 1006))
(bool-value $predicate)
(bool-value $checked-predicate)
(erasable $predicate)
(real-vector $empty 0)
(real-vector $checked-empty 0)
(erasable $empty)
(real-value $neg-inf)
(real-value $live)
(real-vector $ranked 1)

; Derive an absent value through both negation and a scalar selector.
(let $absent (T "ifelse" $predicate (U "neg" $pos-inf) $neg-inf))
(let $checked (T "ifelse" $checked-predicate $neg-inf $neg-inf))
(let $interior (T "ifelse" $predicate (U "neg" $neg-normal) $one))
(let $cdf-negative (U "special-functions.log_ndtr" (U "neg" $pos-inf)))
(let $cdf-positive (U "special-functions.log_ndtr" $pos-inf))
(let $cdf-nan (U "special-functions.log_ndtr" $nan))
(let $cdf-unresolved (U "unresolved.log_ndtr" $pos-inf))
(let $cdf-select (U "special-functions.log_ndtr" $absent))
(let $lse-empty (U "logsumexp" $empty))
(let $lse-checked-empty (U "logsumexp" $checked-empty))
(let $lse-absent-one (U "logsumexp" (U "vector" $absent)))
(let $lse-absent-pair (U "logsumexp.pair" (B "vector" $absent $neg-inf)))
(let $lse-absent-three (U "logsumexp" (T "vector" $neg-inf $absent $neg-inf)))
(let $singleton (U "logsumexp" (U "vector" $live)))
(let $triple-left (U "logsumexp" (T "vector" $live $absent $neg-inf)))
(let $triple-middle (U "logsumexp" (T "vector" $neg-inf $live $absent)))
(let $triple-right (U "logsumexp" (T "vector" $absent $neg-inf $live)))
(let $triple-checked (U "logsumexp" (T "vector" $live $checked $neg-inf)))
(let $triple-two-live (U "logsumexp" (T "vector" $live $one $neg-inf)))
(let $triple-ranked (U "logsumexp" (T "vector" $ranked $neg-inf $neg-inf)))
(let $singleton-ranked (U "logsumexp" (U "vector" $ranked)))
(let $pair-left (U "logsumexp.pair" (B "vector" $interior $absent)))
(let $pair-right (U "logsumexp.pair" (B "vector" $neg-inf $neg-normal)))
(let $pair-unproven (U "logsumexp.pair" (B "vector" $live $neg-inf)))
(let $pair-infinite (U "logsumexp.pair" (B "vector" $pos-inf $neg-inf)))
(let $pair-neg-zero (U "logsumexp.pair" (B "vector" $neg-zero $neg-inf)))
(let $pair-subnormal (U "logsumexp.pair" (B "vector" $f32-subnormal $neg-inf)))
(let $pair-overflow (U "logsumexp.pair" (B "vector" $f32-overflow $neg-inf)))
(let $pair-tie (U "logsumexp.pair" (B "vector" $one $one)))
(let $reduce-two (U "logsumexp" (B "vector" $one $neg-inf)))

(run statistical 6)

(check (= $cdf-negative $neg-inf))
(check (= $cdf-positive $pos-zero))
(check (= $lse-empty $neg-inf))
(check (= $lse-absent-one $neg-inf))
(check (= $lse-absent-pair $neg-inf))
(check (= $lse-absent-three $neg-inf))
(check (= $triple-left $singleton))
(check (= $triple-middle $singleton))
(check (= $triple-right $singleton))
(check (= $pair-left $interior))
(check (= $pair-right $neg-normal))

(fail (check (= $cdf-nan $pos-zero)))
(fail (check (= $cdf-unresolved $pos-zero)))
(fail (check (= $cdf-select $neg-inf)))
(fail (check (= $lse-checked-empty $neg-inf)))
(fail (check (= $triple-checked $singleton)))
(fail (check (= $triple-two-live $singleton)))
(fail (check (= $triple-ranked $singleton-ranked)))
(fail (check (= $pair-unproven $live)))
(fail (check (= $pair-unproven $singleton)))
(fail (check (= $pair-infinite $pos-inf)))
(fail (check (= $pair-neg-zero $neg-zero)))
(fail (check (= $pair-subnormal $f32-subnormal)))
(fail (check (= $pair-overflow $f32-overflow)))
(fail (check (= $pair-tie $one)))
(fail (check (= $reduce-two $one)))
