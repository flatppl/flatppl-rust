(let $mu (Real 0))
(let $unit (Real 4607182418800017408))
(let $two (Real 4611686018427387904))
(let $predicate (Leaf 0))
(let $unknown (Leaf 1))
(let $scale (T "ifelse" $predicate $unit $two))
(bool-value $predicate)
(real-value $unknown)
(real-value $scale)

(let $normal (Leaf 2))
(let $unchecked (Leaf 3))
(let $invalid-normal (Leaf 4))
(gaussian-normal $normal $mu $scale)
(gaussian-normal $unchecked $mu $unknown)
(gaussian-normal $invalid-normal $mu (Real 1))

(let $mu-vector (U "zeros" (Integer 2)))
(let $eye (U "eye" (Integer 2)))
(let $variances (B "vector" $unit $two))
(let $diagonal (U "diagmat" $variances))
(let $bad-diagonal (U "diagmat" (B "vector" $mu $two)))
(let $gram (U "row_gram" $diagonal))
(real-vector $mu-vector 2)
(real-vector $variances 2)
(real-vector (B "vector" $mu $two) 2)
(real-matrix $eye 2 2)
(real-matrix $diagonal 2 2)
(real-matrix $bad-diagonal 2 2)
(real-matrix $gram 2 2)

(let $mvnormal-eye (Leaf 5))
(let $mvnormal-diag (Leaf 6))
(let $mvnormal-zero-var (Leaf 7))
(let $mvnormal-gram (Leaf 8))
(let $wrong-shape (Leaf 9))
(gaussian-mvnormal $mvnormal-eye $mu-vector $eye)
(gaussian-mvnormal $mvnormal-diag $mu-vector $diagonal)
(gaussian-mvnormal $mvnormal-zero-var $mu-vector $bad-diagonal)
(gaussian-mvnormal $mvnormal-gram $mu-vector $gram)
(gaussian-mvnormal $wrong-shape $mu-vector $unit)

(let $joint (B "joint" $normal $normal))
(let $mixed-joint (B "joint" $normal $mvnormal-eye))
(let $nested (B "iid" (B "iid" $joint (Integer 3)) (Integer 4)))
(let $unknown-iid (B "iid" $unchecked (Integer 3)))
(let $invalid-iid (B "iid" $mvnormal-eye (Integer 0)))
(let $normalized (U "normalize" $nested))
(let $score-normalized (B "logdensityof" $normalized $unknown))
(let $score-base (B "logdensityof" $nested $unknown))
(type-id $nested 10)
(type-id $normalized 10)

(let $scalar-score (Leaf 11))
(let $vector-score (Leaf 12))
(let $bad-score (Leaf 13))
(real-value $scalar-score)
(real-value $vector-score)
(real-value $bad-score)
(gaussian-native-normal $scalar-score "builtin_logdensityof" $mu $scale $unknown)
(gaussian-native-mvnormal $vector-score $mu-vector $eye $variances)
(gaussian-native-mvnormal $bad-score $mu-vector $eye $unknown)

(let $center (Leaf 14))
(let $left-limit (Leaf 15))
(let $right-limit (Leaf 16))
(let $interior (Leaf 17))
(let $zero-scale (Leaf 18))
(let $tiny-scale (Leaf 19))
(let $nonfinite-location (Leaf 20))
(let $cut-point (Leaf 21))
(let $different-op (Leaf 22))
(let $negative-location (U "neg" $two))

(real-value $center)
(real-value $left-limit)
(real-value $right-limit)
(real-value $interior)
(real-value $zero-scale)
(real-value $tiny-scale)
(real-value $nonfinite-location)
(real-value $cut-point)
(real-value $different-op)

(gaussian-native-normal $center "builtin_touniform" $negative-location $unit $negative-location)
(gaussian-fixed-cdf $center -4611686018427387904 4607182418800017408 -4611686018427387904)
(gaussian-native-normal $left-limit "builtin_touniform" $mu $two (U "neg" (Real 9218868437227405312)))
(gaussian-fixed-cdf $left-limit 0 4611686018427387904 -4503599627370496)
(gaussian-native-normal $right-limit "builtin_touniform" (Integer 1) $two (Real 9218868437227405312))
(gaussian-fixed-cdf $right-limit 4607182418800017408 4611686018427387904 9218868437227405312)
(gaussian-native-normal $interior "builtin_touniform" $mu $unit $unit)
(gaussian-fixed-cdf $interior 0 4607182418800017408 4607182418800017408)
(gaussian-native-normal $zero-scale "builtin_touniform" $mu $mu $mu)
(gaussian-fixed-cdf $zero-scale 0 0 0)
(gaussian-native-normal $tiny-scale "builtin_touniform" $mu (Real 1) $mu)
(gaussian-fixed-cdf $tiny-scale 0 1 0)
(gaussian-native-normal $nonfinite-location "builtin_touniform" (Real 9218868437227405312) $unit (Real 9218868437227405312))
(gaussian-fixed-cdf $nonfinite-location 9218868437227405312 4607182418800017408 9218868437227405312)
; A raw literal witness is insufficient if projection marks the point as input.
(gaussian-native-normal $cut-point "builtin_touniform" $mu $unit $unknown)
(gaussian-fixed-cdf $cut-point 0 4607182418800017408 0)
(gaussian-native-normal $different-op "builtin_tonormal" $mu $unit $mu)
(gaussian-fixed-cdf $different-op 0 4607182418800017408 0)

(unstable-combined-ruleset gaussian-fixture analysis portable gaussian)
(run-schedule (saturate gaussian-fixture))

(check (gaussian-law $normal 1))
(check (gaussian-probability $normal))
(check (gaussian-law $unchecked 1))
(fail (check (gaussian-probability $unchecked)))
(fail (check (gaussian-probability $invalid-normal)))
(check (gaussian-law $mvnormal-eye 2))
(check (gaussian-probability $mvnormal-eye))
(check (gaussian-probability $mvnormal-diag))
(fail (check (gaussian-probability $mvnormal-zero-var)))
(fail (check (gaussian-probability $mvnormal-gram)))
(fail (check (gaussian-law $wrong-shape 2)))
(fail (check (gaussian-law $mixed-joint 3)))
(check (gaussian-law $nested 24))
(check (gaussian-probability $nested))
(check (= $score-normalized $score-base))
(fail (check (= $normalized $nested)))
(check (gaussian-law $unknown-iid 3))
(fail (check (gaussian-probability $unknown-iid)))
(fail (check (gaussian-law $invalid-iid 0)))
(check (gaussian-scalar-site $scalar-score "builtin_logdensityof" $mu $scale $unknown))
(check (gaussian-vector-score $vector-score 2 $mu-vector $eye $variances))
(fail (check (gaussian-vector-score $bad-score 2 $mu-vector $eye $unknown)))

(check (= $center (Real 4602678819172646912)))
(check (= $left-limit (Real 0)))
(check (= $right-limit (Real 4607182418800017408)))
(check (gaussian-folded-native $center))
(check (gaussian-folded-native $left-limit))
(check (gaussian-folded-native $right-limit))
(fail (check (gaussian-folded-native $interior)))
(fail (check (gaussian-folded-native $zero-scale)))
(fail (check (gaussian-folded-native $tiny-scale)))
(fail (check (gaussian-folded-native $nonfinite-location)))
(fail (check (gaussian-folded-native $cut-point)))
(fail (check (gaussian-folded-native $different-op)))
