;; Value proofs are conditional on evaluation succeeding. Only erasable
;; subtrees may disappear, since lowering evaluates both Boolean operands
;; and both select branches before choosing a value.
(ruleset simplification)

(relation simplify-logical-head (String))
(simplify-logical-head "land")
(simplify-logical-head "lor")
(simplify-logical-head "lxor")
(simplify-logical-head "equal")
(simplify-logical-head "unequal")

(rule ((= e (U "lnot" p)) (bool-value p))
      ((bool-value e))
      :ruleset simplification :name "simplification.negation-is-boolean")
(rule ((= e (U "lnot" p)) (bool-value p) (erasable p))
      ((erasable e))
      :ruleset simplification :name "simplification.negation-is-erasable")
(rule ((= e (B head p q)) (simplify-logical-head head)
       (bool-value p) (bool-value q))
      ((bool-value e))
      :ruleset simplification :name "simplification.logical-call-is-boolean")
(rule ((= e (B head p q)) (simplify-logical-head head)
       (bool-value p) (bool-value q) (erasable p) (erasable q))
      ((erasable e))
      :ruleset simplification :name "simplification.logical-call-is-erasable")

(rewrite (U "lnot" (U "lnot" p)) p
  :when ((bool-value p))
  :ruleset simplification :name "simplification.double-negation")
(rewrite (U "lnot" (Boolean true)) (Boolean false) :ruleset simplification :name "simplification.negate-true")
(rewrite (U "lnot" (Boolean false)) (Boolean true) :ruleset simplification :name "simplification.negate-false")
(rewrite (B "land" p p) p :when ((bool-value p)) :ruleset simplification :name "simplification.idempotent-and")
(rewrite (B "lor" p p) p :when ((bool-value p)) :ruleset simplification :name "simplification.idempotent-or")

;; A literal operand either leaves the other operand unchanged or negates
;; it. Matching both positions avoids generating commutative alternatives.
(relation simplify-identity (String bool))
(simplify-identity "land" true)
(simplify-identity "lor" false)
(simplify-identity "lxor" false)
(simplify-identity "equal" true)
(simplify-identity "unequal" false)
(relation simplify-negation (String bool))
(simplify-negation "lxor" true)
(simplify-negation "equal" false)
(simplify-negation "unequal" true)

(rewrite (B head p (Boolean c)) p
  :when ((simplify-identity head c) (bool-value p))
  :ruleset simplification :name "simplification.right-literal-identity")
(rewrite (B head (Boolean c) p) p
  :when ((simplify-identity head c) (bool-value p))
  :ruleset simplification :name "simplification.left-literal-identity")
(rewrite (B head p (Boolean c)) (U "lnot" p)
  :when ((simplify-negation head c) (bool-value p))
  :ruleset simplification :name "simplification.right-literal-negation")
(rewrite (B head (Boolean c) p) (U "lnot" p)
  :when ((simplify-negation head c) (bool-value p))
  :ruleset simplification :name "simplification.left-literal-negation")

(rewrite (T "ifelse" p (Boolean true) (Boolean false)) p
  :when ((bool-value p))
  :ruleset simplification :name "simplification.ifelse-boolean-identity")
(rewrite (T "ifelse" p (Boolean false) (Boolean true)) (U "lnot" p)
  :when ((bool-value p))
  :ruleset simplification :name "simplification.ifelse-boolean-negation")

;; Type keys include the element kind, orientation, and every axis.
(rewrite (T "ifelse" (Boolean true) a b) a
  :when ((type-id a ty) (type-id b ty) (erasable b))
  :ruleset simplification :name "simplification.ifelse-literal-true")
(rewrite (T "ifelse" (Boolean false) a b) b
  :when ((type-id a ty) (type-id b ty) (erasable a))
  :ruleset simplification :name "simplification.ifelse-literal-false")

;; Restrict joins to predicates encountered together and their Boolean
;; descendants. An impossible assignment represents implication, mutual
;; exclusion, or exhaustiveness according to the two truth values.
(relation simplify-pair (Expr Expr))
(relation simplify-impossible (Expr bool Expr bool))
(relation simplify-connective (Expr bool bool Expr Expr))
(relation simplify-bool-equality (String bool bool))
(simplify-bool-equality "equal" true false)
(simplify-bool-equality "unequal" false true)
(simplify-bool-equality "lxor" false true)

(rule ((= e (B "land" p q)) (bool-value p) (bool-value q))
      ((simplify-connective e false true p q))
      :ruleset simplification :name "simplification.classify-conjunction")
(rule ((= e (B "lor" p q)) (bool-value p) (bool-value q))
      ((simplify-connective e true false p q))
      :ruleset simplification :name "simplification.classify-disjunction")
(rule ((simplify-connective e absorbing neutral p q))
      ((simplify-pair p q))
      :ruleset simplification :name "simplification.pair-connective-operands")
(rule ((= e (B head p q)) (simplify-bool-equality head same different)
       (bool-value p) (bool-value q))
      ((simplify-pair p q))
      :ruleset simplification :name "simplification.pair-boolean-comparison-operands")
(rule ((simplify-pair p q))
      ((simplify-pair q p))
      :ruleset simplification :name "simplification.reverse-predicate-pair")
(rule ((simplify-pair e r) (simplify-connective e absorbing neutral p q))
      ((simplify-pair p r) (simplify-pair q r))
      :ruleset simplification :name "simplification.descend-connective-pair")
(rule ((simplify-pair e q) (= e (U "lnot" p)) (bool-value p))
      ((simplify-pair p q))
      :ruleset simplification :name "simplification.descend-negated-pair")

(rule ((simplify-pair p p))
      ((simplify-impossible p true p false))
      :ruleset simplification :name "simplification.same-predicate-excludes-opposite-truth")
(rule ((simplify-pair (Boolean c) p))
      ((simplify-impossible (Boolean c) (not c) p true)
       (simplify-impossible (Boolean c) (not c) p false))
      :ruleset simplification :name "simplification.literal-excludes-opposite-truth")
(rule ((simplify-impossible p a q b))
      ((simplify-impossible q b p a))
      :ruleset simplification :name "simplification.reverse-impossible-assignment")
(rule ((simplify-pair e q) (= e (U "lnot" p)) (simplify-impossible p a q b))
      ((simplify-impossible e (not a) q b))
      :ruleset simplification :name "simplification.propagate-impossibility-through-negation")

;; An AND can only be true when both children are true, and an OR can only
;; be false when both children are false. Their other outcome needs only
;; one child, so both alternatives must be excluded to prove it impossible.
(rule ((simplify-pair e r) (simplify-connective e absorbing neutral p q)
       (simplify-impossible p neutral r value))
      ((simplify-impossible e neutral r value))
      :ruleset simplification :name "simplification.propagate-left-neutral-impossibility")
(rule ((simplify-pair e r) (simplify-connective e absorbing neutral p q)
       (simplify-impossible q neutral r value))
      ((simplify-impossible e neutral r value))
      :ruleset simplification :name "simplification.propagate-right-neutral-impossibility")
(rule ((simplify-pair e r) (simplify-connective e absorbing neutral p q)
       (simplify-impossible p absorbing r value) (simplify-impossible q absorbing r value))
      ((simplify-impossible e absorbing r value))
      :ruleset simplification :name "simplification.propagate-both-absorbing-impossibility")

(rule ((simplify-connective e absorbing neutral p q)
       (simplify-impossible p neutral q absorbing) (erasable q))
      ((union e p))
      :ruleset simplification :name "simplification.drop-implied-right-operand")
(rule ((simplify-connective e absorbing neutral p q)
       (simplify-impossible p absorbing q neutral) (erasable p))
      ((union e q))
      :ruleset simplification :name "simplification.drop-implied-left-operand")
(rule ((simplify-connective e absorbing neutral p q)
       (simplify-impossible p neutral q neutral) (erasable p) (erasable q))
      ((union e (Boolean absorbing)))
      :ruleset simplification :name "simplification.fold-connective-to-absorbing")
(rule ((= e (B head p q)) (simplify-bool-equality head same different)
       (bool-value p) (bool-value q) (erasable p) (erasable q)
       (simplify-impossible p true q false) (simplify-impossible p false q true))
      ((union e (Boolean same)))
      :ruleset simplification :name "simplification.fold-guaranteed-equal-booleans")
(rule ((= e (B head p q)) (simplify-bool-equality head same different)
       (bool-value p) (bool-value q) (erasable p) (erasable q)
       (simplify-impossible p true q true) (simplify-impossible p false q false))
      ((union e (Boolean different)))
      :ruleset simplification :name "simplification.fold-guaranteed-distinct-booleans")

;; Exact equality is only valid on supported discrete scalars. Normalizing
;; symmetry in the relation preserves the authored order of evaluation.
(relation simplify-discrete (Expr))
(rule ((bool-value x)) ((simplify-discrete x)) :ruleset simplification :name "simplification.boolean-is-discrete")
(rule ((int-value x)) ((simplify-discrete x)) :ruleset simplification :name "simplification.integer-is-discrete")

(relation simplify-exact (Expr Expr Expr bool bool))
(rule ((= p (B "equal" x y)) (simplify-discrete x) (type-id x ty) (type-id y ty))
      ((simplify-exact p x y true false) (simplify-exact p y x true false))
      :ruleset simplification :name "simplification.exact-equal")
(rule ((= p (B "unequal" x y)) (simplify-discrete x) (type-id x ty) (type-id y ty))
      ((simplify-exact p x y false true) (simplify-exact p y x false true))
      :ruleset simplification :name "simplification.exact-unequal")
(rule ((simplify-exact p x y same different))
      ((bool-value p))
      :ruleset simplification :name "simplification.exact-comparison-is-boolean")
(rule ((simplify-exact p x y same different) (erasable x) (erasable y))
      ((erasable p))
      :ruleset simplification :name "simplification.exact-comparison-is-erasable")
(rule ((simplify-exact p x x same different) (erasable x))
      ((union p (Boolean same)))
      :ruleset simplification :name "simplification.fold-reflexive-discrete-comparison")
(rule ((simplify-pair p q) (simplify-exact p x y a b) (simplify-exact q x y c d))
      ((simplify-impossible p a q d) (simplify-impossible p b q c))
      :ruleset simplification :name "simplification.exact-comparisons-exclude-opposites")

;; Ordered comparisons are normalized to < or <= without creating terms or
;; swapping evaluation order. IEEE comparisons are mutually exclusive across
;; reversed strict/weak bounds even when unordered. Only integers guarantee
;; that one of the two reversed comparisons always holds.
(relation simplify-ordered (Expr))
(rule ((real-value x)) ((simplify-ordered x)) :ruleset simplification :name "simplification.real-is-ordered")
(rule ((int-value x)) ((simplify-ordered x)) :ruleset simplification :name "simplification.integer-is-ordered")

(relation simplify-order (Expr Expr Expr bool))
(relation simplify-order-forward (String bool))
(relation simplify-order-reverse (String bool))
(simplify-order-forward "lt" true)
(simplify-order-forward "le" false)
(simplify-order-reverse "gt" true)
(simplify-order-reverse "ge" false)

(rule ((= p (B head x y)) (simplify-order-forward head strict)
       (simplify-ordered x) (simplify-ordered y))
      ((simplify-order p x y strict))
      :ruleset simplification :name "simplification.classify-forward-order")
(rule ((= p (B head x y)) (simplify-order-reverse head strict)
       (simplify-ordered x) (simplify-ordered y))
      ((simplify-order p y x strict))
      :ruleset simplification :name "simplification.classify-reversed-order")
(rule ((simplify-order p x y strict))
      ((bool-value p))
      :ruleset simplification :name "simplification.order-comparison-is-boolean")
(rule ((simplify-order p x y strict) (erasable x) (erasable y))
      ((erasable p))
      :ruleset simplification :name "simplification.order-comparison-is-erasable")
(rule ((simplify-pair p q) (simplify-order p x y strict) (simplify-order q x y strict))
      ((simplify-impossible p true q false))
      :ruleset simplification :name "simplification.identical-orders-have-same-truth")
(rule ((simplify-pair p q) (simplify-order p x y true) (simplify-order q x y false))
      ((simplify-impossible p true q false))
      :ruleset simplification :name "simplification.strict-order-implies-weak-order")
(rule ((simplify-pair p q) (simplify-order p x y true) (simplify-order q y x strict))
      ((simplify-impossible p true q true))
      :ruleset simplification :name "simplification.reversed-orders-with-strict-are-exclusive")
(rule ((simplify-pair p q) (simplify-order p x y false) (simplify-order q y x strict)
       (int-value x) (int-value y))
      ((simplify-impossible p false q false))
      :ruleset simplification :name "simplification.reversed-integer-orders-with-weak-are-exhaustive")
(rule ((simplify-pair p q) (simplify-order p x y strict) (simplify-exact q x y same different)
       (int-value x) (int-value y))
      ((simplify-impossible p strict q same))
      :ruleset simplification :name "simplification.integer-equality-fixes-order-outcome")

;; Comparing two integer bounds is exact at either supported integer width
;; when both bounds can be erased. Strict threshold ordering supplies the
;; implication even when the higher comparison is strict and the lower is weak.
(rule ((simplify-pair p q) (simplify-order p x lo a) (simplify-order q x hi b)
       (int-value x) (= lo (Integer low)) (= hi (Integer high)) (< low high))
      ((simplify-impossible p true q false))
      :ruleset simplification :name "simplification.smaller-integer-upper-bound-implies-larger")
(rule ((simplify-pair p q) (simplify-order p hi x a) (simplify-order q lo x b)
       (int-value x) (= lo (Integer low)) (= hi (Integer high)) (< low high))
      ((simplify-impossible p true q false))
      :ruleset simplification :name "simplification.larger-integer-lower-bound-implies-smaller")

;; The same real cannot be both finite, infinite, or NaN. There is no
;; pairwise exhaustiveness on reals.
(relation simplify-finiteness (String))
(simplify-finiteness "isfinite")
(simplify-finiteness "isinf")
(simplify-finiteness "isnan")
(rule ((= p (U head x)) (simplify-finiteness head) (real-value x))
      ((bool-value p))
      :ruleset simplification :name "simplification.finiteness-test-is-boolean")
(rule ((= p (U head x)) (simplify-finiteness head) (real-value x) (erasable x))
      ((erasable p))
      :ruleset simplification :name "simplification.finiteness-test-is-erasable")
(rule ((simplify-pair p q) (= p (U a x)) (= q (U b x))
       (simplify-finiteness a) (simplify-finiteness b) (real-value x) (!= a b))
      ((simplify-impossible p true q true))
      :ruleset simplification :name "simplification.finiteness-tests-are-exclusive")
