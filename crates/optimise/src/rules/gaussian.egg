(ruleset gaussian)

; These witnesses read fields by their names on the original constructor or
; kernel operation. A law can be Gaussian in form before its parameters are
; known to be valid.
(relation gaussian-normal (Expr Expr Expr))
(relation gaussian-mvnormal (Expr Expr Expr))
(relation gaussian-native-normal (Expr String Expr Expr Expr))
(relation gaussian-native-mvnormal (Expr Expr Expr Expr))
(relation gaussian-fixed-cdf (Expr i64 i64 i64))
(relation gaussian-scalar (Expr))
(relation gaussian-law (Expr i64))
(relation gaussian-scalar-law (Expr))
(relation gaussian-probability (Expr))
(relation gaussian-active ())

(rule ((gaussian-normal m mu sigma)) ((gaussian-active)) :ruleset gaussian)
(rule ((gaussian-mvnormal m mu cov)) ((gaussian-active)) :ruleset gaussian)
(rule ((gaussian-native-normal e op mu sigma x)) ((gaussian-active)) :ruleset gaussian)
(rule ((gaussian-native-mvnormal e mu cov x)) ((gaussian-active)) :ruleset gaussian)

(rule ((gaussian-active) (real-value x)) ((gaussian-scalar x)) :ruleset gaussian)
(rule ((gaussian-active) (int-value x)) ((gaussian-scalar x)) :ruleset gaussian)
(rule ((gaussian-normal m mu sigma) (gaussian-scalar mu) (gaussian-scalar sigma))
      ((gaussian-scalar-law m) (gaussian-law m 1)) :ruleset gaussian)
(rule ((gaussian-mvnormal m mu cov) (real-vector mu n) (real-matrix cov n n) (> n 0))
      ((gaussian-law m n)) :ruleset gaussian)

; A positional joint of scalar laws and a static iid plate are independent
; Gaussian products. The count is the number of scalar coordinates, which
; does not flatten the inferred array layers or claim a vector event type.
(rule ((= e (B "joint" a b)) (gaussian-scalar-law a) (gaussian-scalar-law b))
      ((gaussian-law e 2)) :ruleset gaussian)
(rule ((= e (T "joint" a b c))
       (gaussian-scalar-law a) (gaussian-scalar-law b) (gaussian-scalar-law c))
      ((gaussian-law e 3)) :ruleset gaussian)
(rule ((= e (B "iid" m (Integer n))) (gaussian-law m size)
       (> n 0) (<= n 2147483647) (<= size 2147483647))
      ((gaussian-law e (* n size))) :ruleset gaussian)

; Locations must stay finite at either precision. A scale must be positive
; in f32 even on a target that flushes subnormals. The bounds are f64 bit
; encodings of the signed f32 extrema and the smallest positive f32 normal.
(relation gaussian-finite-bits (i64))
(relation gaussian-scale-bits (i64))
(relation gaussian-observed-bits (i64))
(rule ((gaussian-active) (= x (Real bits))) ((gaussian-observed-bits bits)) :ruleset gaussian)
(rule ((gaussian-fixed-cdf e mu sigma x))
      ((gaussian-observed-bits mu) (gaussian-observed-bits sigma)) :ruleset gaussian)
(rule ((gaussian-observed-bits bits) (>= bits 0) (<= bits 5183643170566569984))
      ((gaussian-finite-bits bits)) :ruleset gaussian)
(rule ((gaussian-observed-bits bits) (<= bits -4039728866288205824))
      ((gaussian-finite-bits bits)) :ruleset gaussian)
(rule ((gaussian-observed-bits bits) (>= bits 4039728865751334912) (<= bits 5183643170566569984))
      ((gaussian-scale-bits bits)) :ruleset gaussian)

(relation gaussian-finite (Expr))
(relation gaussian-positive (Expr))
(rule ((= x (Real bits)) (gaussian-finite-bits bits))
      ((gaussian-finite x)) :ruleset gaussian)
(rule ((= x (Real bits)) (gaussian-scale-bits bits))
      ((gaussian-positive x)) :ruleset gaussian)
(rule ((gaussian-active) (= x (Integer n)) (>= n -2147483648) (<= n 2147483647))
      ((gaussian-finite x)) :ruleset gaussian)
(rule ((gaussian-active) (= x (Integer n)) (> n 0) (<= n 2147483647))
      ((gaussian-positive x)) :ruleset gaussian)
(rule ((= x (U "neg" y)) (real-value x) (gaussian-finite y))
      ((gaussian-finite x)) :ruleset gaussian)
(rule ((= x (T "ifelse" p a b)) (bool-value p) (real-value x)
       (gaussian-finite a) (gaussian-finite b))
      ((gaussian-finite x)) :ruleset gaussian)
(rule ((= x (T "ifelse" p a b)) (bool-value p) (real-value x)
       (gaussian-positive a) (gaussian-positive b))
      ((gaussian-positive x)) :ruleset gaussian)

(relation gaussian-finite-vector (Expr))
(relation gaussian-positive-vector (Expr))
(rule ((= e (U "vector" x)) (real-vector e 1) (gaussian-finite x))
      ((gaussian-finite-vector e)) :ruleset gaussian)
(rule ((= e (B "vector" x y)) (real-vector e 2) (gaussian-finite x) (gaussian-finite y))
      ((gaussian-finite-vector e)) :ruleset gaussian)
(rule ((= e (T "vector" x y z)) (real-vector e 3)
       (gaussian-finite x) (gaussian-finite y) (gaussian-finite z))
      ((gaussian-finite-vector e)) :ruleset gaussian)
(rule ((= e (B "fill" x (Integer n))) (real-vector e n) (gaussian-finite x) (> n 0))
      ((gaussian-finite-vector e)) :ruleset gaussian)
(rule ((gaussian-active) (= e (U "zeros" (Integer n))) (real-vector e n) (> n 0))
      ((gaussian-finite-vector e)) :ruleset gaussian)
(rule ((= e (U "vector" x)) (real-vector e 1) (gaussian-positive x))
      ((gaussian-positive-vector e)) :ruleset gaussian)
(rule ((= e (B "vector" x y)) (real-vector e 2) (gaussian-positive x) (gaussian-positive y))
      ((gaussian-positive-vector e)) :ruleset gaussian)
(rule ((= e (T "vector" x y z)) (real-vector e 3)
       (gaussian-positive x) (gaussian-positive y) (gaussian-positive z))
      ((gaussian-positive-vector e)) :ruleset gaussian)
(rule ((= e (B "fill" x (Integer n))) (real-vector e n) (gaussian-positive x) (> n 0))
      ((gaussian-positive-vector e)) :ruleset gaussian)

; The two covariance constructors prove positive definiteness structurally.
; Shape agreement alone or a Gram matrix without a rank proof is insufficient.
(relation gaussian-covariance (Expr i64))
(rule ((gaussian-active) (= cov (U "eye" (Integer n))) (real-matrix cov n n) (> n 0))
      ((gaussian-covariance cov n)) :ruleset gaussian)
(rule ((= cov (U "diagmat" diag)) (gaussian-positive-vector diag)
       (real-vector diag n) (real-matrix cov n n) (> n 0))
      ((gaussian-covariance cov n)) :ruleset gaussian)

(rule ((gaussian-normal m mu sigma) (gaussian-scalar-law m)
       (gaussian-finite mu) (gaussian-positive sigma))
      ((gaussian-probability m)) :ruleset gaussian)
(rule ((gaussian-mvnormal m mu cov) (gaussian-law m n)
       (gaussian-finite-vector mu) (gaussian-covariance cov n))
      ((gaussian-probability m)) :ruleset gaussian)
(rule ((= e (B "joint" a b)) (gaussian-law e 2)
       (gaussian-probability a) (gaussian-probability b))
      ((gaussian-probability e)) :ruleset gaussian)
(rule ((= e (T "joint" a b c)) (gaussian-law e 3)
       (gaussian-probability a) (gaussian-probability b) (gaussian-probability c))
      ((gaussian-probability e)) :ruleset gaussian)
(rule ((= e (B "iid" m (Integer n))) (gaussian-law e size) (gaussian-probability m))
      ((gaussian-probability e)) :ruleset gaussian)

; The portable rule requires equal full measure types and retains the base.
; These probability proofs are consumed in score queries.
(rule ((gaussian-probability m)) ((portable-normalized m)) :ruleset gaussian)

; Keep typed density sites tied to the native operation and its original
; fields. A site proof alone does not license deleting its checks or scoring
; it with a different floating-point formula.
(relation gaussian-scalar-site (Expr String Expr Expr Expr))
(relation gaussian-vector-score (Expr i64 Expr Expr Expr))
(rule ((gaussian-native-normal e op mu sigma x) (real-value e)
       (gaussian-scalar mu) (gaussian-scalar sigma) (gaussian-scalar x))
      ((gaussian-scalar-site e op mu sigma x)) :ruleset gaussian)
(rule ((gaussian-native-mvnormal e mu cov x) (real-value e)
       (real-vector mu n) (real-matrix cov n n) (real-vector x n) (> n 0))
      ((gaussian-vector-score e n mu cov x)) :ruleset gaussian)

; Only StableHLO supplies these original literal bits. Its Normal CDF uses
; the exact center and erfc limits. With fixed finite parameters and a
; strictly positive normal scale there is no status or pullback to remove.
(relation gaussian-folded-native (Expr))
(relation gaussian-cdf-bits (i64 i64))
(gaussian-cdf-bits -4503599627370496 0)
(gaussian-cdf-bits 9218868437227405312 4607182418800017408)
(relation gaussian-literal-source (Expr))
(rule ((gaussian-active) (= x (Real bits))) ((gaussian-literal-source x)) :ruleset gaussian)
(rule ((gaussian-active) (= x (Integer n))) ((gaussian-literal-source x)) :ruleset gaussian)
(rule ((gaussian-active) (= x (U "neg" y)) (= y (Real bits)))
      ((gaussian-literal-source x)) :ruleset gaussian)
(rule ((gaussian-active) (= x (U "neg" y)) (= y (Integer n)))
      ((gaussian-literal-source x)) :ruleset gaussian)
(relation gaussian-checked-cdf (Expr i64 i64))
(rule ((gaussian-fixed-cdf e mu sigma x) (real-value e)
       (gaussian-native-normal e "builtin_touniform" location scale point)
       (gaussian-literal-source location) (gaussian-literal-source scale)
       (gaussian-literal-source point)
       (gaussian-finite-bits mu) (gaussian-scale-bits sigma))
      ((gaussian-checked-cdf e mu x)) :ruleset gaussian)
(rule ((gaussian-checked-cdf e mu mu))
      ((union e (Real 4602678819172646912)) (gaussian-folded-native e)) :ruleset gaussian)
(rule ((gaussian-checked-cdf e mu x) (gaussian-cdf-bits x result))
      ((union e (Real result)) (gaussian-folded-native e)) :ruleset gaussian)

; The host evaluates the native arithmetic in the target precision. The
; literal witnesses ensure that no replaced ABI value or effect is discarded.
(relation gaussian-native-value (Expr i64 i64 i64 i64))
(rule ((gaussian-native-value e mu sigma x result)
       (gaussian-scalar-site e op location scale point)
       (gaussian-literal-source location) (gaussian-literal-source scale)
       (gaussian-literal-source point)
       (gaussian-finite-bits mu) (gaussian-scale-bits sigma))
      ((union e (Real result)) (gaussian-folded-native e))
      :ruleset gaussian)
(rule ((gaussian-native-value e mu sigma x result))
      ((gaussian-observed-bits mu) (gaussian-observed-bits sigma))
      :ruleset gaussian)

; x - +0 and -0 + x preserve the sign of a zero variate. The opposite
; combination can change it. One preserves the succeeding divide or multiply.
(relation gaussian-signed-zero (Expr i64))
(relation gaussian-unit-scale (Expr))
(rule ((gaussian-active) (= e (Real 0))) ((gaussian-signed-zero e 1)) :ruleset gaussian)
(rule ((gaussian-active) (= e (Real -9223372036854775808))) ((gaussian-signed-zero e -1)) :ruleset gaussian)
(rule ((gaussian-active) (= e (Integer 0))) ((gaussian-signed-zero e 1)) :ruleset gaussian)
(rule ((gaussian-active) (= e (U "neg" (Integer 0)))) ((gaussian-signed-zero e 1)) :ruleset gaussian)
(rule ((gaussian-active) (= e (U "neg" (Real 0)))) ((gaussian-signed-zero e -1)) :ruleset gaussian)
(rule ((gaussian-active) (= e (U "neg" (Real -9223372036854775808))))
      ((gaussian-signed-zero e 1)) :ruleset gaussian)
(rule ((gaussian-active) (= e (Real 4607182418800017408))) ((gaussian-unit-scale e)) :ruleset gaussian)
(rule ((gaussian-active) (= e (Integer 1))) ((gaussian-unit-scale e)) :ruleset gaussian)

(relation gaussian-unit-transport-source (Expr i64))
(relation gaussian-removed-unit-transport (Expr i64))
(relation gaussian-transport-origin (String i64))
(gaussian-transport-origin "builtin_tonormal" 1)
(gaussian-transport-origin "builtin_fromnormal" -1)
(rule ((gaussian-unit-transport-source e site) (gaussian-scalar-site e op origin scale point)
       (gaussian-transport-origin op sign) (gaussian-signed-zero origin sign)
       (gaussian-unit-scale scale) (real-value point))
      ((union e point) (gaussian-removed-unit-transport e site))
      :ruleset gaussian)

; A partially simplified transport can expose arithmetic already present
; elsewhere. Only an input read by this native site alone can take this path.
(relation gaussian-affine-source (Expr i64 Expr i64 i64))
(relation gaussian-affine-exclusive (Expr))
(relation gaussian-checked-affine (Expr i64 String Expr Expr Expr))
(rule ((gaussian-affine-source e site point mu sigma) (gaussian-affine-exclusive e))
      ((gaussian-observed-bits mu) (gaussian-observed-bits sigma))
      :ruleset gaussian)
(rule ((gaussian-affine-source e site point mu sigma) (gaussian-affine-exclusive e)
       (gaussian-scalar-site e op origin scale point) (real-value point)
       (gaussian-literal-source origin) (gaussian-literal-source scale)
       (gaussian-finite-bits mu) (gaussian-scale-bits sigma))
      ((gaussian-checked-affine e site op origin scale point))
      :ruleset gaussian)
(rule ((gaussian-checked-affine e site "builtin_tonormal" origin scale point)
       (gaussian-unit-scale scale))
      ((union e (B "sub" point origin)) (gaussian-removed-unit-transport e site))
      :ruleset gaussian)
(rule ((gaussian-checked-affine e site "builtin_fromnormal" origin scale point)
       (gaussian-unit-scale scale))
      ((union e (B "add" origin point)) (gaussian-removed-unit-transport e site))
      :ruleset gaussian)
(rule ((gaussian-checked-affine e site "builtin_tonormal" origin scale point)
       (gaussian-signed-zero origin 1))
      ((union e (B "divide" point scale)) (gaussian-removed-unit-transport e site))
      :ruleset gaussian)
(rule ((gaussian-checked-affine e site "builtin_fromnormal" origin scale point)
       (gaussian-signed-zero origin -1))
      ((union e (B "mul" scale point)) (gaussian-removed-unit-transport e site))
      :ruleset gaussian)
