(ruleset conjugacy)

; The host proves a closed, normalized kchain with an anonymous single-input
; draw and fixed parameter checks. The witness belongs to the density use.
(relation conjugate-unit-predictive (Expr i64))
(relation conjugate-gamma-poisson (Expr i64 i64))
(relation conjugate-normal-mean (Expr i64 i64))
(relation conjugate-exponential-variance (Expr i64 i64))
(relation conjugate-inverse-gamma-variance (Expr i64 i64 i64 i64 i64))
(relation conjugate-student-log-density (Expr Expr))
(relation conjugate-original-measure (Expr i64))
(relation conjugate-density-head (String))
(conjugate-density-head "logdensityof")
(conjugate-density-head "densityof")

(datatype ConjugateMasses
  (ConjugateLastMass i64)
  (ConjugateMass i64 i64 ConjugateMasses))
(relation conjugate-beta-binomial (Expr ConjugateMasses))
(relation conjugate-count-select (Expr ConjugateMasses))
(relation conjugate-count-score (Expr ConjugateMasses Expr))

; The two masses integrate p and 1-p against Beta(alpha, beta).
(rule ((= score (B head measure point)) (= measure (Leaf opaque)) (conjugate-density-head head)
       (real-value score) (int-value point) (conjugate-unit-predictive score probability))
      ((conjugate-original-measure measure 3)
       (union score (B head (U "Bernoulli" (Real probability)) point)))
  :ruleset conjugacy)

; NegativeBinomial(alpha, beta) is the Gamma(shape, rate)-Poisson mixture.
(rule ((= score (B head measure point)) (= measure (Leaf opaque)) (conjugate-density-head head)
       (real-value score) (int-value point) (conjugate-gamma-poisson score shape rate))
      ((conjugate-original-measure measure 3)
       (union score (B head (B "NegativeBinomial" (Real shape) (Real rate)) point)))
  :ruleset conjugacy)

; Independent Normal deviations add in variance coordinates.
(rule ((= score (B head measure point)) (= measure (Leaf opaque)) (conjugate-density-head head)
       (real-value score) (real-value point) (conjugate-normal-mean score location scale))
      ((conjugate-original-measure measure 3)
       (union score (B head (B "Normal" (Real location) (Real scale)) point)))
  :ruleset conjugacy)

; Exponential mixing of the variance gives Laplace with scale 1/sqrt(2*rate).
(rule ((= score (B head measure point)) (= measure (Leaf opaque)) (conjugate-density-head head)
       (real-value score) (real-value point) (conjugate-exponential-variance score location scale))
      ((conjugate-original-measure measure 3)
       (union score (B head (B "Laplace" (Real location) (Real scale)) point)))
  :ruleset conjugacy)

; InverseGamma mixing gives StudentT(2*shape) with scale sqrt(beta/shape).
; Keep the standardized-square and log1p form used by the marginal integral.
(rule ((= score (B head measure point)) (= measure (Leaf opaque)) (conjugate-density-head head)
       (real-value score) (real-value point)
       (conjugate-inverse-gamma-variance score location scale nu tail_weight norm))
      ((conjugate-original-measure measure 12)
       (let standardized (B "divide" (B "sub" point (Real location)) (Real scale)))
       (let square (B "pow" standardized (Real 4611686018427387904)))
       (let tail (B "mul" (Real tail_weight) (U "log1p" (B "divide" square (Real nu)))))
       (conjugate-student-log-density score (U "neg" (B "add" (Real norm) tail))))
  :ruleset conjugacy)
(rule ((= score (B "logdensityof" measure point)) (conjugate-student-log-density score value))
      ((union score value))
  :ruleset conjugacy)
(rule ((= score (B "densityof" measure point)) (conjugate-student-log-density score value))
      ((union score (U "exp" value)))
  :ruleset conjugacy)

; Select a proved count's negative log mass without adding a checked index.
; The log and ordinary density share this selection and its original point.
; An outer negation keeps FlatPIR literal atoms unsigned.
(rule ((= score (B head measure point)) (= measure (Leaf opaque)) (conjugate-density-head head)
       (real-value score) (conjugate-beta-binomial score masses))
      ((conjugate-original-measure measure 16)
       (conjugate-count-select point masses))
  :ruleset conjugacy)
(rule ((conjugate-count-select point masses) (= masses (ConjugateMass k log tail)))
      ((conjugate-count-select point tail))
  :ruleset conjugacy)
(rule ((conjugate-count-select point last) (= last (ConjugateLastMass log)))
      ((conjugate-count-score point last (Real log)))
  :ruleset conjugacy)
(rule ((conjugate-count-select point masses) (= masses (ConjugateMass k log tail))
       (conjugate-count-score point tail rest))
      ((conjugate-count-score point masses
         (T "ifelse" (B "equal" point (Integer k)) (Real log) rest)))
  :ruleset conjugacy)
(rule ((= score (B "densityof" measure point)) (= measure (Leaf opaque))
       (conjugate-beta-binomial score masses)
       (conjugate-count-score point masses negative_log))
      ((union score (U "exp" (U "neg" negative_log))))
  :ruleset conjugacy)
(rule ((= score (B "logdensityof" measure point)) (= measure (Leaf opaque))
       (conjugate-beta-binomial score masses)
       (conjugate-count-score point masses negative_log))
      ((union score (U "neg" negative_log)))
  :ruleset conjugacy)
