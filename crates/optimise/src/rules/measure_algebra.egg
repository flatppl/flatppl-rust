(ruleset measure-algebra)

; These facts refer to concrete scalar measures and fixed, comparable endpoints.
; In particular, a runtime argument cannot use its authored literal's key.
(relation measure-scalar (Expr))
(relation measure-bound (Expr i64))
(relation measure-alias (Expr Expr))

(relation measure-window (Expr Expr Expr Expr i64 i64))
(rule ((= m (B "truncate" base (B "interval" low high)))
       (measure-scalar base) (measure-bound low l) (measure-bound high h) (< l h))
      ((measure-window m base low high l h))
      :ruleset measure-algebra)

; Carry the original base, exact endpoint expressions, and number of
; authored windows accounted for by their intersection.
(relation measure-restricted (Expr Expr Expr Expr i64 i64 i64))
(rule ((measure-window m base low high l h))
      ((measure-restricted m base low high l h 1))
      :ruleset measure-algebra)
(rule ((measure-alias alias rhs) (measure-restricted rhs base low high l h count))
      ((measure-restricted alias base low high l h count))
      :ruleset measure-algebra)

(relation measure-normalization (Expr Expr))
(rule ((= norm (U "normalize" original)))
      ((measure-normalization norm original)) :ruleset measure-algebra)
(rule ((measure-alias alias rhs) (measure-normalization rhs original))
      ((measure-normalization alias original)) :ruleset measure-algebra)

; A closed intersection selects the larger lower endpoint and the smaller
; upper endpoint. Equality keeps the inner endpoint. Disjoint or touching
; windows stay on their original path, including any zero-mass diagnostics.
(rule ((measure-window m inner ext_lo ext_hi el eh)
       (measure-restricted inner base low high l h prior)
       (>= l el) (<= h eh))
      ((measure-restricted m base low high l h (+ prior 1)))
      :ruleset measure-algebra)
(rule ((measure-window m inner ext_lo ext_hi el eh)
       (measure-restricted inner base low high l h prior)
       (< l el) (> h eh))
      ((measure-restricted m base ext_lo ext_hi el eh (+ prior 1)))
      :ruleset measure-algebra)
(rule ((measure-window m inner ext_lo ext_hi el eh)
       (measure-restricted inner base low high l h prior)
       (>= l el) (> h eh) (< l eh))
      ((measure-restricted m base low ext_hi l eh (+ prior 1)))
      :ruleset measure-algebra)
(rule ((measure-window m inner ext_lo ext_hi el eh)
       (measure-restricted inner base low high l h prior)
       (< l el) (<= h eh) (< el h))
      ((measure-restricted m base ext_lo high el h (+ prior 1)))
      :ruleset measure-algebra)

; Only rewrite observations. A measure value may be shared with a draw, whose
; implementation and RNG successor depend on its authored construction.
(rule ((= out (B head original point)) (portable-density-head head)
       (measure-restricted original base lo hi l h count) (> count 1))
      ((union out (B head (B "truncate" base (B "interval" lo hi)) point)))
      :ruleset measure-algebra)
(rule ((= out (B head norm point)) (portable-density-head head)
       (measure-normalization norm original)
       (measure-restricted original base lo hi l h count) (> count 1))
      ((union out (B head (U "normalize" (B "truncate" base (B "interval" lo hi))) point)))
      :ruleset measure-algebra)
(rule ((= out (U "totalmass" original))
       (measure-restricted original base lo hi l h count) (> count 1))
      ((union out (U "totalmass" (B "truncate" base (B "interval" lo hi)))))
      :ruleset measure-algebra)

; The measure binding may already be shared or exported. Charge the extra
; support comparisons, conjunction and mask where a query evaluates it.
(relation measure-observation-work (Expr i64))
(rule ((measure-restricted original base lo hi l h count) (> count 1))
      ((measure-observation-work original (* 4 (- count 1))))
      :ruleset measure-algebra)
(rule ((measure-normalization norm original)
       (measure-restricted original base lo hi l h count) (> count 1))
      ((measure-observation-work norm (* 4 (- count 1))))
      :ruleset measure-algebra)
